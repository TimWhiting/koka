check   : std/core/order
// Standard `:char` functions.
//
// Characters are unicode _codepoint_\/s.
// This is different from a unicode _grapheme_ which represents a single displayed
// symbol and can consists of multiple codepoints due to combining characters and marks.
module std/core/char
import std/core/types = std/core/types = "";
import std/core/int = std/core/int = "";
// Compare character code points.
pub fip fun cmp : (x : char, y : char) -> order
  = fn(x, y){
    match ((std/core/char/(<)(x, y))) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/types/Lt;
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> (match ((std/core/char/(>)(x, y))) {
          ((std/core/types/True() : bool ) as @pat@1)
             -> std/core/types/Gt;
          ((@skip std/core/types/False() : bool ) as @pat@2)
             -> std/core/types/Eq;
        });
    };
  };
// Order two characters in ascending order.
pub fip fun order2 : (x : char, y : char) -> order2<char>
  = fn(x, y){
    match ((std/core/char/(==)(x, y))) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/types/Eq2(x);
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> (match ((std/core/char/(<)(x, y))) {
          ((std/core/types/True() : bool ) as @pat@1)
             -> std/core/types/Lt2(x, y);
          ((@skip std/core/types/False() : bool ) as @pat@2)
             -> std/core/types/Gt2(y, x);
        });
    };
  };
// Add two character code points
pub fip fun (+) : (c : char, d : char) -> char
  = fn(c, d){
    val x@10000 : int
      = std/core/char/int(c);
    val y@10001 : int
      = std/core/char/int(d);
    std/core/char/int/char((std/core/int/int-add(x@10000, y@10001)));
  };
// Subtract two character code points
pub fip fun (-) : (c : char, d : char) -> char
  = fn(c, d){
    val x@10002 : int
      = std/core/char/int(c);
    val y@10003 : int
      = std/core/char/int(d);
    std/core/char/int/char((std/core/int/int-sub(x@10002, y@10003)));
  };
// Is the character a lower-case ASCII character?
pub fip fun is-lower : (c : char) -> bool
  = fn(c){
    match ((std/core/char/(>=)(c, 'a'))) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/char/(<=)(c, 'z');
      (@pat@0)
         -> std/core/types/False;
    };
  };
// Is the character an upper-case ASCII character?
pub fip fun is-upper : (c : char) -> bool
  = fn(c){
    match ((std/core/char/(>=)(c, 'A'))) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/char/(<=)(c, 'Z');
      (@pat@0)
         -> std/core/types/False;
    };
  };
// Is the character an ASCII digit ?
pub fip fun is-digit : (c : char) -> bool
  = fn(c){
    match ((std/core/char/(>=)(c, '0'))) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/char/(<=)(c, '9');
      (@pat@0)
         -> std/core/types/False;
    };
  };
// Is the character an ASCII hexa-decimal digit?
pub fip fun is-hex-digit : (c : char) -> bool
  = fn(c){
    match ((std/core/char/(>=)(c, '0'))) {
      ((std/core/types/True() : bool ) as @pat)
         -> (match ((std/core/char/(<=)(c, '9'))) {
          ((std/core/types/True() : bool ) as @pat@1)
             -> std/core/types/True;
          (@pat@0@0)
             -> (match ((std/core/char/(>=)(c, 'a'))) {
              ((std/core/types/True() : bool ) as @pat@1@0)
                 -> (match ((std/core/char/(<=)(c, 'f'))) {
                  ((std/core/types/True() : bool ) as @pat@3)
                     -> std/core/types/True;
                  (@pat@4)
                     -> (match ((std/core/char/(>=)(c, 'A'))) {
                      ((std/core/types/True() : bool ) as @pat@5)
                         -> std/core/char/(<=)(c, 'F');
                      (@pat@6)
                         -> std/core/types/False;
                    });
                });
              (@pat@2)
                 -> (match ((std/core/char/(>=)(c, 'A'))) {
                  ((std/core/types/True() : bool ) as @pat@5@0)
                     -> std/core/char/(<=)(c, 'F');
                  (@pat@6@0)
                     -> std/core/types/False;
                });
            });
        });
      (@pat@0)
         -> (match ((std/core/char/(>=)(c, 'a'))) {
          ((std/core/types/True() : bool ) as @pat@1@0@0)
             -> (match ((std/core/char/(<=)(c, 'f'))) {
              ((std/core/types/True() : bool ) as @pat@3@0)
                 -> std/core/types/True;
              (@pat@4@0)
                 -> (match ((std/core/char/(>=)(c, 'A'))) {
                  ((std/core/types/True() : bool ) as @pat@5@1)
                     -> std/core/char/(<=)(c, 'F');
                  (@pat@6@1)
                     -> std/core/types/False;
                });
            });
          (@pat@2@0)
             -> (match ((std/core/char/(>=)(c, 'A'))) {
              ((std/core/types/True() : bool ) as @pat@5@0@0)
                 -> std/core/char/(<=)(c, 'F');
              (@pat@6@0@0)
                 -> std/core/types/False;
            });
        });
    };
  };
// Is the character an ASCII letter?
pub fip fun is-alpha : (c : char) -> bool
  = fn(c){
    match ((std/core/char/(>=)(c, 'a'))) {
      ((std/core/types/True() : bool ) as @pat)
         -> (match ((std/core/char/(<=)(c, 'z'))) {
          ((std/core/types/True() : bool ) as @pat@1)
             -> std/core/types/True;
          (@pat@0@0)
             -> (match ((std/core/char/(>=)(c, 'A'))) {
              ((std/core/types/True() : bool ) as @pat@2)
                 -> std/core/char/(<=)(c, 'Z');
              (@pat@0@1)
                 -> std/core/types/False;
            });
        });
      (@pat@0)
         -> (match ((std/core/char/(>=)(c, 'A'))) {
          ((std/core/types/True() : bool ) as @pat@2@0)
             -> std/core/char/(<=)(c, 'Z');
          (@pat@0@1@0)
             -> std/core/types/False;
        });
    };
  };
// Is the character ASCII letter or digit?
pub fip fun is-alpha-num : (c : char) -> bool
  = fn(c){
    match ((std/core/char/is-alpha(c))) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/types/True;
      (@pat@0)
         -> (match ((std/core/char/(>=)(c, '0'))) {
          ((std/core/types/True() : bool ) as @pat@1)
             -> std/core/char/(<=)(c, '9');
          (@pat@0@0)
             -> std/core/types/False;
        });
    };
  };
// Is the character an ASCII character, e.g. `c <= '\x7F'`?
pub fip fun is-ascii : (c : char) -> bool
  = fn(c){
    std/core/char/(<=)(c, '\x7F');
  };
// Is the character an ASCII control character, e.g. `c < ' '`?
pub fip fun is-control : (c : char) -> bool
  = fn(c){
    std/core/char/(<)(c, ' ');
  };
// Tests if a character is an element of `" \t\n\r"`
pub fip fun is-white : (c : char) -> bool
  = fn(c){
    match ((std/core/char/(==)(c, ' '))) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/types/True;
      (@pat@0)
         -> (match ((std/core/char/(==)(c, '\x09'))) {
          ((std/core/types/True() : bool ) as @pat@1)
             -> std/core/types/True;
          (@pat@2)
             -> (match ((std/core/char/(==)(c, '\x0A'))) {
              ((std/core/types/True() : bool ) as @pat@3)
                 -> std/core/types/True;
              (@pat@4)
                 -> std/core/char/(==)(c, '\x0D');
            });
        });
    };
  };
// Are two characters equal?
pub fip extern (==) : (char, char) -> bool {
  inline "(#1 == #2)";
  js inline "(#1 === #2)";
};
// Are two characters not equal?
pub fip extern (!=) : (char, char) -> bool {
  inline "(#1 != #2)";
  js inline "(#1 !== #2)";
};
// Is a character code point lower or equal to that of another?
pub fip extern (<=) : (char, char) -> bool = inline "(#1 <= #2)";
// Is a character code point greater or equal to that of another?
pub fip extern (>=) : (char, char) -> bool = inline "(#1 >= #2)";
// Is a character code point lower to that of another?
pub fip extern (<) : (char, char) -> bool = inline "(#1 < #2)";
// Is a character code point greater to that of another?
pub fip extern (>) : (char, char) -> bool = inline "(#1 > #2)";
// Convert a character to its unicode code point
pub fip extern int : (char) -> int {
  inline "#1";
  c inline "kk_integer_from_int(#1,kk_context())";
  cs inline "new BigInteger(#1)";
};
// Convert a unicode code point to a character
pub fip extern int/char : (i : int) -> char {
  inline "(#1)";
  c inline "kk_integer_clamp32(#1,kk_context())";
  cs inline "Primitive.IntToInt32(#1)";
};
// Standard `:order` functions.
module std/core/order
import std/core/types = std/core/types = "";
import std/core/int = std/core/int = "";
import std/core/hnd = std/core/hnd inline = "";
pub fip fun order/int : (x : order) -> int
  = fn(x){
    match (x) {
      ((std/core/types/Lt() : order ) as @pat)
         -> -1;
      ((std/core/types/Eq() : order ) as @pat@0)
         -> 0;
      ((@skip std/core/types/Gt() : order ) as @pat@1)
         -> 1;
    };
  };
// Convert an `:order2` to an `:int` (`-1`, `0`, or `1`)
pub fip fun order2/int : forall<a> (^ x : order2<a>) -> int
  = forall<a> fn(x){
    (match (x) {
      ((std/core/types/Lt2((@pat@0), (@pat@1)) : order2<a> ) as @pat)
         -> -1;
      ((std/core/types/Eq2((@pat@3)) : order2<a> ) as @pat@2)
         -> 0;
      ((@skip std/core/types/Gt2((@pat@5), (@pat@6)) : order2<a> ) as @pat@4)
         -> 1;
    });
  };
pub fip fun (==) : (x : order, y : order) -> bool
  = fn(x, y){
    std/core/int/(==)((match (x) {
        ((std/core/types/Lt() : order ) as @pat)
           -> -1;
        ((std/core/types/Eq() : order ) as @pat@0)
           -> 0;
        ((@skip std/core/types/Gt() : order ) as @pat@1)
           -> 1;
      }), (match (y) {
        ((std/core/types/Lt() : order ) as @pat@2)
           -> -1;
        ((std/core/types/Eq() : order ) as @pat@0@0)
           -> 0;
        ((@skip std/core/types/Gt() : order ) as @pat@1@0)
           -> 1;
      }));
  };
pub fip fun (!=) : (x : order, y : order) -> bool
  = fn(x, y){
    std/core/int/(!=)((match (x) {
        ((std/core/types/Lt() : order ) as @pat)
           -> -1;
        ((std/core/types/Eq() : order ) as @pat@0)
           -> 0;
        ((@skip std/core/types/Gt() : order ) as @pat@1)
           -> 1;
      }), (match (y) {
        ((std/core/types/Lt() : order ) as @pat@2)
           -> -1;
        ((std/core/types/Eq() : order ) as @pat@0@0)
           -> 0;
        ((@skip std/core/types/Gt() : order ) as @pat@1@0)
           -> 1;
      }));
  };
pub fip fun (>=) : (x : order, y : order) -> bool
  = fn(x, y){
    std/core/int/(>=)((match (x) {
        ((std/core/types/Lt() : order ) as @pat)
           -> -1;
        ((std/core/types/Eq() : order ) as @pat@0)
           -> 0;
        ((@skip std/core/types/Gt() : order ) as @pat@1)
           -> 1;
      }), (match (y) {
        ((std/core/types/Lt() : order ) as @pat@2)
           -> -1;
        ((std/core/types/Eq() : order ) as @pat@0@0)
           -> 0;
        ((@skip std/core/types/Gt() : order ) as @pat@1@0)
           -> 1;
      }));
  };
pub fip fun (<=) : (x : order, y : order) -> bool
  = fn(x, y){
    std/core/int/(<=)((match (x) {
        ((std/core/types/Lt() : order ) as @pat)
           -> -1;
        ((std/core/types/Eq() : order ) as @pat@0)
           -> 0;
        ((@skip std/core/types/Gt() : order ) as @pat@1)
           -> 1;
      }), (match (y) {
        ((std/core/types/Lt() : order ) as @pat@2)
           -> -1;
        ((std/core/types/Eq() : order ) as @pat@0@0)
           -> 0;
        ((@skip std/core/types/Gt() : order ) as @pat@1@0)
           -> 1;
      }));
  };
pub fip fun (>) : (x : order, y : order) -> bool
  = fn(x, y){
    std/core/int/(>)((match (x) {
        ((std/core/types/Lt() : order ) as @pat)
           -> -1;
        ((std/core/types/Eq() : order ) as @pat@0)
           -> 0;
        ((@skip std/core/types/Gt() : order ) as @pat@1)
           -> 1;
      }), (match (y) {
        ((std/core/types/Lt() : order ) as @pat@2)
           -> -1;
        ((std/core/types/Eq() : order ) as @pat@0@0)
           -> 0;
        ((@skip std/core/types/Gt() : order ) as @pat@1@0)
           -> 1;
      }));
  };
pub fip fun (<) : (x : order, y : order) -> bool
  = fn(x, y){
    std/core/int/(<)((match (x) {
        ((std/core/types/Lt() : order ) as @pat)
           -> -1;
        ((std/core/types/Eq() : order ) as @pat@0)
           -> 0;
        ((@skip std/core/types/Gt() : order ) as @pat@1)
           -> 1;
      }), (match (y) {
        ((std/core/types/Lt() : order ) as @pat@2)
           -> -1;
        ((std/core/types/Eq() : order ) as @pat@0@0)
           -> 0;
        ((@skip std/core/types/Gt() : order ) as @pat@1@0)
           -> 1;
      }));
  };
// monadic lift
fun default/@mlift-order2@10013 : forall<a,e> (x : a, y : a, @y-x10012 : order) -> e order2<a>
  = forall<a,e> fn(x, y, @y-x10012){
    (match (@y-x10012) {
      ((std/core/types/Eq() : order ) as @pat)
         -> std/core/types/Eq2(x);
      ((std/core/types/Lt() : order ) as @pat@0)
         -> std/core/types/Lt2(x, y);
      ((@skip std/core/types/Gt() : order ) as @pat@1)
         -> std/core/types/Gt2(y, x);
    });
  };
// Given a comparison function, we can order 2 elements.
pub fun default/order2 : forall<a,e> (x : a, y : a, ^ ?cmp : (a, a) -> e order) -> e order2<a>
  = forall<a,e> fn(x, y, @implicit/cmp){
    std/core/hnd/yield-bind2((?cmp(x, y)), (fn(@y-x10012){
        (std/core/order/default/@mlift-order2@10013(x, y, @y-x10012));
      }), (fn(@y-x10012@0){
        (match (@y-x10012@0) {
          ((std/core/types/Eq() : order ) as @pat)
             -> std/core/types/Eq2(x);
          ((std/core/types/Lt() : order ) as @pat@0)
             -> std/core/types/Lt2(x, y);
          ((@skip std/core/types/Gt() : order ) as @pat@1)
             -> std/core/types/Gt2(y, x);
        });
      }));
  };
