fun try-finalize-prompt : forall<a,e> (res : a) -> e either<hnd/yield-info,a>
  = forall<a,e> fn(res){
    (match ((std/core/hnd/yielding-non-final())) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/hnd/yield-cont((forall<b> fn(cont, x){
          std/core/hnd/try-finalize-prompt((cont(x)));
        }));
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> val b : bool
                  = std/core/hnd/yielding();
        (match (b) {
          ((std/core/types/True() : bool ) as @pat@1)
             -> std/core/types/Left((std/core/hnd/yield-capture()));
          ((@skip std/core/types/False() : bool ) as @pat@0@0)
             -> std/core/types/Right(res);
        });
    });
  };
