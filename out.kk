// Unsafe primitives to dismiss effects.
module std/core/unsafe
import std/core/types = std/core/types = "";
// _Unsafe_. This function calls a function and pretends it did not have any effect at all.
// Use with utmost care as it should not be used to dismiss user-defined effects that need
// a handler and can cause a segfault at runtime in such cases!
//
// You can use `unsafe-total` to dismiss built-in effects without handlers which include:
//
// - behavioral: `:div` (non-termination/divergence), `:ndet` (non-determinism)
// - state: `:alloc`, `:read`, `:write`, `:st`
// - external: `:ui`, `:fsys`, `:net`, `:blocking`
// - combinations: `:io-total` and `:io-noexn`
//
// Do _not_ dismiss `:io` since it has the `:exn` effect that should be handled (and an evidence
// vector should be passed in).
//
// Try to avoid using `unsafe-total` to initialize global values that have a side-effect, but
// use `std/core/delayed/delay` instead:
// ```
// val myglobal = delay( fn() initialize() )
// fun get-global() : e int
//   myglobal.force
// ```
pub fun unsafe-total : forall<a,e> (action : () -> e a) -> a
  = forall<a,e> fn(action){
    action();
  };
// _Unsafe_. This function pretends the given `action` is deterministic
pub fun pretend-no-ndet : forall<a,e> (action : () -> <ndet|e> a) -> e a
  = forall<a,e> fn(action){
    action();
  };
fip extern unsafe-total-cast : forall<e,a> (action : () -> e a) -> (() -> a) = inline "#1";
// _Unsafe_. This function checks if two objects have the same address in the heap.
// The results may vary on the backend or compiler optimizations but the function pretends to be `:total`.
// Note also that value types always compare unequal since each value will be boxed fresh in the heap
// when calling this function.
pub extern unsafe-ptr-eq : forall<a> (x : a, y : a) -> bool {
  c inline "kk_box_eq(#1,#2)";
  cs inline "Object.ReferenceEquals(#1,#2)";
  js inline "Object.is(#1,#2)";
};
// Unsafe primitives to dismiss divergence.
module std/core/undiv
import std/core/types = std/core/types = "";
// _Unsafe_. This function pretends that the given action is terminating.
pub fun pretend-no-div : forall<a,e> (action : () -> <div|e> a) -> e a
  = forall<a,e> fn(action){
    action();
  };
// _Unsafe_. Mark a function parameter as decreasing to suppress the non-termination effect (`:div`).
// The compiler has a very limited termination analysis, only recognizing direct recursion on
// inductive datatypes. When it is clear a function has a decreasing parameter but it is not recognized
// as such by the compiler, you can wrap the arguments in `pretend-decreasing` to inform the
// termination analysis to consider that parameter decreasing on a recursive call. Use with care
// to not accidentally allow actual divergence (without having that reflected in the effect type).
pub fip extern pretend-decreasing : forall<a> (x : a) -> a = inline "#1";
fip extern pretend-nodiv-cast : forall<e,a> (action : () -> <div|e> a) -> (() -> e a) = inline "#1";
// Standard `:bool` functions.
//
// Booleans are either `True` or `False`.
module std/core/bool
import std/core/types = std/core/types = "";
pub fip fun (==) : (x : bool, y : bool) -> bool
  = fn(x, y){
    match (x) {
      ((std/core/types/True() : bool ) as @pat)
         -> y;
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> (match (y) {
          ((std/core/types/True() : bool ) as @pat@1)
             -> std/core/types/False;
          ((@skip std/core/types/False() : bool ) as @pat@0@0)
             -> std/core/types/True;
        });
    };
  };
pub fip fun (!=) : (x : bool, y : bool) -> bool
  = fn(x, y){
    match (x) {
      ((std/core/types/True() : bool ) as @pat)
         -> (match (y) {
          ((std/core/types/True() : bool ) as @pat@0)
             -> std/core/types/False;
          ((@skip std/core/types/False() : bool ) as @pat@0@0)
             -> std/core/types/True;
        });
      ((@skip std/core/types/False() : bool ) as @pat@0@1)
         -> y;
    };
  };
pub fip fun (<) : (x : bool, y : bool) -> bool
  = fn(x, y){
    match (x) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/types/False;
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> y;
    };
  };
pub fip fun (>) : (x : bool, y : bool) -> bool
  = fn(x, y){
    match (x) {
      ((std/core/types/True() : bool ) as @pat)
         -> (match (y) {
          ((std/core/types/True() : bool ) as @pat@0)
             -> std/core/types/False;
          ((@skip std/core/types/False() : bool ) as @pat@0@0)
             -> std/core/types/True;
        });
      (@pat@0@1)
         -> std/core/types/False;
    };
  };
pub fip fun (<=) : (x : bool, y : bool) -> bool
  = fn(x, y){
    match (x) {
      ((std/core/types/True() : bool ) as @pat@1)
         -> (match (y) {
          ((std/core/types/True() : bool ) as @pat@2)
             -> std/core/types/True;
          ((@skip std/core/types/False() : bool ) as @pat@0@0)
             -> std/core/types/False;
        });
      (@pat@0@1)
         -> std/core/types/True;
    };
  };
pub fip fun (>=) : (x : bool, y : bool) -> bool
  = fn(x, y){
    match (x) {
      ((std/core/types/True() : bool ) as @pat@1)
         -> std/core/types/True;
      ((@skip std/core/types/False() : bool ) as @pat@0@0)
         -> (match (y) {
          ((std/core/types/True() : bool ) as @pat)
             -> std/core/types/False;
          ((@skip std/core/types/False() : bool ) as @pat@0@2)
             -> std/core/types/True;
        });
    };
  };
pub fip fun xor : (x : bool, y : bool) -> bool
  = fn(x, y){
    match (x) {
      ((std/core/types/False() : bool ) as @pat)
         -> y;
      ((@skip std/core/types/True() : bool ) as @pat@0)
         -> (match (y) {
          ((std/core/types/True() : bool ) as @pat@1)
             -> std/core/types/False;
          ((@skip std/core/types/False() : bool ) as @pat@0@0)
             -> std/core/types/True;
        });
    };
  };
// Compare two booleans with `False < True`.
pub fip fun cmp : (x : bool, y : bool) -> order
  = fn(x, y){
    match (x) {
      ((std/core/types/True() : bool ) as @pat)
         -> (match (x) {
          ((std/core/types/True() : bool ) as @pat@3@0)
             -> (match (y) {
              ((std/core/types/True() : bool ) as @pat@4@0)
                 -> std/core/types/Eq;
              ((@skip std/core/types/False() : bool ) as @pat@0@2@0)
                 -> std/core/types/Gt;
            });
          (@pat@0@3@0)
             -> std/core/types/Eq;
        });
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> (match (y) {
          ((std/core/types/True() : bool ) as @pat@2)
             -> std/core/types/Lt;
          ((@skip std/core/types/False() : bool ) as @pat@0@1)
             -> (match (x) {
              ((std/core/types/True() : bool ) as @pat@3)
                 -> (match (y) {
                  ((std/core/types/True() : bool ) as @pat@4)
                     -> std/core/types/Eq;
                  ((@skip std/core/types/False() : bool ) as @pat@0@2)
                     -> std/core/types/Gt;
                });
              (@pat@0@3)
                 -> std/core/types/Eq;
            });
        });
    };
  };
// Order two booleans in ascending order.
pub fip fun order2 : (x : bool, y : bool) -> order2<bool>
  = fn(x, y){
    match ((match (x) {
      ((std/core/types/True() : bool ) as @pat)
         -> y;
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> (match (y) {
          ((std/core/types/True() : bool ) as @pat@1)
             -> std/core/types/False;
          ((@skip std/core/types/False() : bool ) as @pat@0@0)
             -> std/core/types/True;
        });
    })) {
      ((std/core/types/True() : bool ) as @pat@2)
         -> std/core/types/Eq2(x);
      ((@skip std/core/types/False() : bool ) as @pat@0@1)
         -> (match (x) {
          ((std/core/types/True() : bool ) as @pat@3)
             -> std/core/types/Gt2(y, x);
          ((@skip std/core/types/False() : bool ) as @pat@0@2)
             -> (match (y) {
              ((std/core/types/True() : bool ) as @pat@1@0)
                 -> std/core/types/Lt2(x, y);
              ((@skip std/core/types/False() : bool ) as @pat@2@0)
                 -> std/core/types/Gt2(y, x);
            });
        });
    };
  };
