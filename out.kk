pub fun show : (b : bool) -> string
  = fn(b){
    match (b) {
      ((std/core/types/True() : bool ) as @pat)
         -> "True";
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> "False";
    };
  };
// Convert a boolean to an `:int`
pub fip fun int : (b : bool) -> int
  = fn(b){
    match (b) {
      ((std/core/types/True() : bool ) as @pat)
         -> 1;
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> 0;
    };
  };
