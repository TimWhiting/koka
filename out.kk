module std/core/show
import std/core/types = std/core/types = "";
import std/core/hnd = std/core/hnd = "";
import std/core/int = std/core/int = "";
import std/core/char = std/core/char = "";
import std/core/string = std/core/string = "";
import std/core/sslice = std/core/sslice = "";
import std/core/list = std/core/list = "";
// Generic show: shows the internal representation of an object as a string
// Note: this breaks parametricity so it should not be public
fun gshow : forall<a> (a) -> string
  = forall<a> fn(@arg-x1){
    std/core/show/@extern-gshow(@arg-x1);
  };
fun int-show-hex : (i : int, use-capitals : bool) -> string
  = fn(i, use-capitals){
    std/core/show/@extern-int-show-hex(i, use-capitals);
  };
// Show an `:int` as a hexadecimal value.\
// The `width`  parameter specifies how wide the hex value is where `"0"`  is used to align.\
// The `use-capitals` parameter (= `True`) determines if capital letters should be used to display the hexadecimal digits.\
// The `pre` (=`"0x"`) is an optional prefix for the number (goes between the sign and the number).
pub fun show-hex : (i : int, width : ? int, use-capitals : ? bool, pre : ? string) -> string
  = fn(i, width, use-capitals, pre){
    std/core/types/(++)((match ((std/core/int/(<)(i, 0))) {
        ((std/core/types/True() : bool ) as @pat@5)
           -> "-";
        ((@skip std/core/types/False() : bool ) as @pat@6)
           -> "";
      }), (std/core/types/(++)((match (pre) {
          ((std/core/types/@Optional((@uniq-pre@70)) : ? string ) as @pat@3)
             -> @uniq-pre@70;
          ((@skip std/core/types/@None() : ? string ) as @pat@4)
             -> "0x";
        }), (std/core/string/pad-left((std/core/show/int-show-hex((std/core/int/abs(i)), (match (use-capitals) {
              ((std/core/types/@Optional((@uniq-use-capitals@66)) : ? bool ) as @pat@1)
                 -> @uniq-use-capitals@66;
              ((@skip std/core/types/@None() : ? bool ) as @pat@2)
                 -> std/core/types/True;
            }))), (match (width) {
            ((std/core/types/@Optional((@uniq-width@62)) : ? int ) as @pat)
               -> @uniq-width@62;
            ((@skip std/core/types/@None() : ? int ) as @pat@0)
               -> 1;
          }), (std/core/types/@Optional('0')))))));
  };
// Show a character as a string
pub fun show-char : (c : char) -> string
  = fn(c){
    match ((std/core/char/(<)(c, ' '))) {
      ((std/core/types/True() : bool ) as @pat)
         -> (match ((std/core/char/(==)(c, '\x0A'))) {
          ((std/core/types/True() : bool ) as @pat@2)
             -> "\x5Cn";
          ((@skip std/core/types/False() : bool ) as @pat@3)
             -> (match ((std/core/char/(==)(c, '\x0D'))) {
              ((std/core/types/True() : bool ) as @pat@4)
                 -> "\x5Cr";
              ((@skip std/core/types/False() : bool ) as @pat@5)
                 -> (match ((std/core/char/(==)(c, '\x09'))) {
                  ((std/core/types/True() : bool ) as @pat@6)
                     -> "\x5Ct";
                  ((@skip std/core/types/False() : bool ) as @pat@7)
                     -> (match ((std/core/int/(<=)((std/core/char/int(c)), 255))) {
                      ((std/core/types/True() : bool ) as @pat@8)
                         -> val @arg-x247 : int
                                  = std/core/char/int(c);
                        std/core/types/(++)("\x5Cx", (std/core/show/show-hex(@arg-x247, (std/core/types/@Optional(2)), std/core/types/@None, (std/core/types/@Optional("")))));
                      ((@skip std/core/types/False() : bool ) as @pat@9)
                         -> (match ((std/core/int/(<=)((std/core/char/int(c)), 65535))) {
                          ((std/core/types/True() : bool ) as @pat@10)
                             -> val @arg-x302 : int
                                      = std/core/char/int(c);
                            std/core/types/(++)("\x5Cu", (std/core/show/show-hex(@arg-x302, (std/core/types/@Optional(4)), std/core/types/@None, (std/core/types/@Optional("")))));
                          ((@skip std/core/types/False() : bool ) as @pat@11)
                             -> val @arg-x345 : int
                                      = std/core/char/int(c);
                            std/core/types/(++)("\x5CU", (std/core/show/show-hex(@arg-x345, (std/core/types/@Optional(6)), std/core/types/@None, (std/core/types/@Optional("")))));
                        });
                    });
                });
            });
        });
      (@pat@0)
         -> (match ((std/core/char/(>)(c, '~'))) {
          ((std/core/types/True() : bool ) as @pat@1)
             -> (match ((std/core/char/(==)(c, '\x0A'))) {
              ((std/core/types/True() : bool ) as @pat@2@0)
                 -> "\x5Cn";
              ((@skip std/core/types/False() : bool ) as @pat@3@0)
                 -> (match ((std/core/char/(==)(c, '\x0D'))) {
                  ((std/core/types/True() : bool ) as @pat@4@0)
                     -> "\x5Cr";
                  ((@skip std/core/types/False() : bool ) as @pat@5@0)
                     -> (match ((std/core/char/(==)(c, '\x09'))) {
                      ((std/core/types/True() : bool ) as @pat@6@0)
                         -> "\x5Ct";
                      ((@skip std/core/types/False() : bool ) as @pat@7@0)
                         -> (match ((std/core/int/(<=)((std/core/char/int(c)), 255))) {
                          ((std/core/types/True() : bool ) as @pat@8@0)
                             -> val @arg-x247@0 : int
                                      = std/core/char/int(c);
                            std/core/types/(++)("\x5Cx", (std/core/show/show-hex(@arg-x247@0, (std/core/types/@Optional(2)), std/core/types/@None, (std/core/types/@Optional("")))));
                          ((@skip std/core/types/False() : bool ) as @pat@9@0)
                             -> (match ((std/core/int/(<=)((std/core/char/int(c)), 65535))) {
                              ((std/core/types/True() : bool ) as @pat@10@0)
                                 -> val @arg-x302@0 : int
                                          = std/core/char/int(c);
                                std/core/types/(++)("\x5Cu", (std/core/show/show-hex(@arg-x302@0, (std/core/types/@Optional(4)), std/core/types/@None, (std/core/types/@Optional("")))));
                              ((@skip std/core/types/False() : bool ) as @pat@11@0)
                                 -> val @arg-x345@0 : int
                                          = std/core/char/int(c);
                                std/core/types/(++)("\x5CU", (std/core/show/show-hex(@arg-x345@0, (std/core/types/@Optional(6)), std/core/types/@None, (std/core/types/@Optional("")))));
                            });
                        });
                    });
                });
            });
          ((@skip std/core/types/False() : bool ) as @pat@12)
             -> (match ((std/core/char/(==)(c, '\x27'))) {
              ((std/core/types/True() : bool ) as @pat@13)
                 -> "\x5C\x27";
              ((@skip std/core/types/False() : bool ) as @pat@14)
                 -> (match ((std/core/char/(==)(c, '\x22'))) {
                  ((std/core/types/True() : bool ) as @pat@15)
                     -> "\x5C\x22";
                  ((@skip std/core/types/False() : bool ) as @pat@16)
                     -> (match ((std/core/char/(==)(c, '\x5C'))) {
                      ((std/core/types/True() : bool ) as @pat@17)
                         -> "\x5C\x5C";
                      ((@skip std/core/types/False() : bool ) as @pat@18)
                         -> std/core/string/char/string(c);
                    });
                });
            });
        });
    };
  };
// Show a `:char` as a character literal
pub fun char/show : (c : char) -> string
  = fn(c){
    std/core/types/(++)("\x27", (std/core/types/(++)((std/core/show/show-char(c)), "\x27")));
  };
// Show a string as a string literal
pub fun string/show : (s : string) -> string
  = fn(s){
    std/core/types/(++)("\x22", (std/core/types/(++)((std/core/list/concat/join((std/core/list/map((std/core/string/list(s)), std/core/show/show-char)))), "\x22")));
  };
// Show an `:sslice` as a string literal
pub fun sslice/show : (s : sslice/sslice) -> string
  = fn(s){
    std/core/show/string/show((std/core/sslice/string(s)));
  };
// Generic show: shows the internal representation of an object as a string
// Note: this breaks parametricity so it should not be public
extern @extern-gshow : forall<a> (a) -> string {
  c inline "kk_show_any(#1,kk_context())";
  cs inline "#1.ToString()";
  js inline "#1.toString()";
};
extern @extern-int-show-hex : (i : int, use-capitals : bool) -> string {
  c inline "kk_integer_to_hex_string(#1,#2,kk_context())";
  cs inline "Primitive.IntShowHex(#1,#2)";
  js inline "$std_core_types._int_showhex(#1,#2)";
};
// Standard output to the console.
module std/core/console
import std/core/types = std/core/types = "";
import std/core/unsafe = std/core/unsafe = "";
import std/core/hnd = std/core/hnd = "";
import std/core/string = std/core/string = "";
import std/core/show = std/core/show = "";
// Stateful functions can manipulate heap `:h` using allocations, reads and writes.
local alias st<(h :: H)> :: H -> E = <(read :: H -> X)<(h :: H)>,(write :: H -> X)<(h :: H)>,(alloc :: H -> X)<(h :: H)>> = 1;
// The console effect signifies that a function may write to the console.
pub type console/console[23,1,23,21] :: X ;
val redirect : ref<global,maybe<(string) -> console/console ()>>
  = std/core/types/ref(std/core/types/Nothing);
// Redirect `print` and `println` calls to a specified function.
fun print-redirect : (print : (msg : string) -> console/console ()) -> <st<global>,console/console,ndet> ()
  = fn(print){
    std/core/types/set(std/core/console/redirect, (std/core/types/Just(print)));
  };
// Print a string to the console, including a final newline character.
fun xprintsln : (s : string) -> console/console ()
  = fn(s){
    std/core/console/@extern-xprintsln(s);
  };
// Print a string to the console
fun xprints : (s : string) -> console/console ()
  = fn(s){
    std/core/console/@extern-xprints(s);
  };
fun prints : (s : string) -> console/console ()
  = fn(s){
    match ((std/core/types/ref/(!)(std/core/console/redirect, std/core/types/@Hnodiv))) {
      ((std/core/types/Nothing() : maybe<(string) -> console/console ()> ) as @pat)
         -> std/core/console/xprints(s);
      ((@skip std/core/types/Just((f)) : maybe<(string) -> console/console ()> ) as @pat@0)
         -> f(s);
    };
  };
fun printsln : (s : string) -> console/console ()
  = fn(s){
    match ((std/core/types/ref/(!)(std/core/console/redirect, std/core/types/@Hnodiv))) {
      ((std/core/types/Nothing() : maybe<(string) -> console/console ()> ) as @pat)
         -> std/core/console/xprintsln(s);
      ((@skip std/core/types/Just((f)) : maybe<(string) -> console/console ()> ) as @pat@0)
         -> f((std/core/types/(++)(s, "\x0A")));
    };
  };
// Print a string to the console.
pub fun string/print : (s : string) -> console/console ()
  = fn(s){
    std/core/console/prints(s);
  };
// Print a value that has a `show` function
pub fun default/show/print : forall<a,e> (x : a, ?show : (a) -> <console/console|e> string) -> <console/console|e> ()
  = forall<a,e> fn(x, @implicit/show){
    val x@0@10003 : string
          = ?show(x);
    (match ((std/core/hnd/yielding())) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/hnd/yield-extend(std/core/console/prints);
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> std/core/console/prints(x@0@10003);
    });
  };
// Print a string to the console, including a final newline character.
pub fun string/println : (s : string) -> console/console ()
  = fn(s){
    std/core/console/printsln(s);
  };
// Print a value that has a `show` function, including a final newline character.
pub fun default/show/println : forall<a,e> (x : a, ?show : (a) -> <console/console|e> string) -> <console/console|e> ()
  = forall<a,e> fn(x, @implicit/show){
    val x@0@10005 : string
          = ?show(x);
    (match ((std/core/hnd/yielding())) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/hnd/yield-extend(std/core/console/printsln);
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> std/core/console/printsln(x@0@10005);
    });
  };
// Print a string to the console, including a final newline character.
extern @extern-xprintsln : (s : string) -> console/console () {
  c inline "kk_println(#1,kk_context())";
  cs inline "Console.WriteLine(#1)";
  js inline "_println(#1)";
};
// Print a string to the console
extern @extern-xprints : (s : string) -> console/console () {
  c inline "kk_print(#1,kk_context())";
  cs inline "Console.Write(#1)";
  js inline "_print(#1)";
};
// _Unsafe_. This function removes the state effect from the effect of an action
extern unsafe-nostate : forall<a,h> (action : () -> <st<h>,console/console> a) -> (() -> console/console a) = inline "#1";
// Core debugging functions.
module std/core/debug
import std/core/types = std/core/types = "";
import std/core/unsafe = std/core/unsafe = "";
import std/core/hnd = std/core/hnd = "";
import std/core/string = std/core/string = "";
import std/core/console = std/core/console = "";
// Stateful functions can manipulate heap `:h` using allocations, reads and writes.
local alias st<(h :: H)> :: H -> E = <(read :: H -> X)<(h :: H)>,(write :: H -> X)<(h :: H)>,(alloc :: H -> X)<(h :: H)>> = 1;
// Compilation constant that is replaced with the current file's module name
pub val file/kk-module : string
  = "";
// Compilation constant that is replaced with the current line number
pub val file/kk-line : string
  = "";
// Compilation constant that is replaced with the current file name
pub val file/kk-file : string
  = "";
pub fip fun file/kk-file-line : (?kk-file : string, ?kk-line : string) -> string
  = fn(@implicit/kk-file, @implicit/kk-line){
    std/core/types/(++)(?kk-file, (std/core/types/(++)("(", (std/core/types/(++)(?kk-line, ")")))));
  };
fip fun xtrace : (message : string) -> ()
  = fn(message){
    std/core/debug/@extern-xtrace(message);
  };
fip fun xtrace-any : forall<a> (message : string, x : a) -> ()
  = forall<a> fn(message, x){
    std/core/debug/@extern-xtrace-any(message, x);
  };
val trace-enabled : ref<global,bool>
  = std/core/types/ref(std/core/types/True);
// Trace a message used for debug purposes.
// The behavior is system dependent. On a browser and node it uses
// `console.log`  by default.
// Disabled if `notrace` is called.
pub fip fun trace : (message : string) -> ()
  = fn(message){
    match ((std/core/types/ref/(!)(std/core/debug/trace-enabled, std/core/types/@Hnodiv))) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/debug/xtrace(message);
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> std/core/types/Unit;
    };
  };
pub fip fun trace-info : (message : string, ?kk-file-line : string) -> ()
  = fn(message, @implicit/kk-file-line){
    val message@0@10002 : string
          = std/core/types/(++)(?kk-file-line, (std/core/types/(++)(": ", message)));
    match ((std/core/types/ref/(!)(std/core/debug/trace-enabled, std/core/types/@Hnodiv))) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/debug/xtrace(message@0@10002);
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> std/core/types/Unit;
    };
  };
// monadic lift
fun @mlift-trace-show@10013 : forall<_e,e1> (?kk-file-line : string, @y-x10009 : string) -> e1 ()
  = forall<_e,e1> fn(@implicit/kk-file-line, @y-x10009){
    val message@0@10002 : string
          = std/core/types/(++)(?kk-file-line, (std/core/types/(++)(": ", @y-x10009)));
    (match ((std/core/types/ref/(!)(std/core/debug/trace-enabled, std/core/types/@Hnodiv))) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/debug/xtrace(message@0@10002);
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> std/core/types/Unit;
    });
  };
pub fip fun trace-show : forall<a,e> (x : a, ?show : (a) -> e string, ?kk-file-line : string) -> e ()
  = forall<a,e> fn(x, @implicit/show, @implicit/kk-file-line){
    val x@0@10014 : string
          = ?show(x);
    (match ((std/core/hnd/yielding())) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/hnd/yield-extend((fn(@y-x10009){
          (std/core/debug/@mlift-trace-show@10013(?kk-file-line, @y-x10009));
        }));
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> val message@0@10002 : string
                  = std/core/types/(++)(?kk-file-line, (std/core/types/(++)(": ", x@0@10014)));
        (match ((std/core/types/ref/(!)(std/core/debug/trace-enabled, std/core/types/@Hnodiv))) {
          ((std/core/types/True() : bool ) as @pat@1)
             -> std/core/debug/xtrace(message@0@10002);
          ((@skip std/core/types/False() : bool ) as @pat@0@0)
             -> std/core/types/Unit;
        });
    });
  };
pub fip fun trace-any : forall<a> (message : string, x : a) -> ()
  = forall<a> fn(message, x){
    (match ((std/core/types/ref/(!)(std/core/debug/trace-enabled, std/core/types/@Hnodiv))) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/debug/xtrace-any(message, x);
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> std/core/types/Unit;
    });
  };
// Disable tracing completely.
pub fun notrace : () -> (st<global>) ()
  = fn(){
    std/core/types/set(std/core/debug/trace-enabled, std/core/types/False);
  };
fun unsafe-abort : forall<a> (msg : string) -> a
  = forall<a> fn(msg){
    std/core/debug/@extern-unsafe-abort(msg);
  };
pub fip fun impossible : forall<a> (message : ? string, ?kk-file-line : string) -> a
  = forall<a> fn(message, @implicit/kk-file-line){
    std/core/debug/unsafe-abort((std/core/types/(++)(?kk-file-line, (std/core/types/(++)(": impossible:", (match (message) {
          ((std/core/types/@Optional((@uniq-message@334)) : ? string ) as @pat)
             -> @uniq-message@334;
          ((@skip std/core/types/@None() : ? string ) as @pat@0)
             -> "?";
        }))))));
  };
pub fip fun assert : (message : string, condition : bool, ?kk-file-line : string) -> ()
  = fn(message, condition, @implicit/kk-file-line){
    match (condition) {
      ((std/core/types/True() : bool ) as @pat)
         -> std/core/types/Unit;
      ((@skip std/core/types/False() : bool ) as @pat@0)
         -> std/core/debug/unsafe-abort((std/core/types/(++)(?kk-file-line, (std/core/types/(++)(": assertion failed: ", message)))));
    };
  };
// Explicitly trigger a breakpoint
pub fip fun breakpoint : () -> ndet ()
  = fn(){
    std/core/debug/@extern-breakpoint();
  };
fip extern @extern-xtrace : (message : string) -> () {
  c inline "kk_trace(#1,kk_context())";
  cs inline "Primitive.Trace(#1)";
  js inline "$std_core_console._trace(#1)";
};
fip extern @extern-xtrace-any : forall<a> (message : string, x : a) -> () {
  c inline "kk_trace_any(#1,#2,kk_context())";
  cs inline "Primitive.TraceAny<##1>(#1,#2)";
  js inline "$std_core_console._trace_any(#1,#2)";
};
extern @extern-unsafe-abort : forall<a> (msg : string) -> a {
  c inline "kk_abort(#1,kk_context())";
  js inline "function() { throw new Error(\x22fatal error: \x22 + #1) }()";
};
// Explicitly trigger a breakpoint
fip extern @extern-breakpoint : () -> ndet () {
  c inline "kk_debugger_break(kk_context())";
  cs inline "System.Diagnostics.Debugger.Break()";
  js inline "(function(){ debugger; })()";
};
/* Core functions.

   This module is implicitly imported and all functions and types
   are always available.
   Some types and operations are required to be defined for the compiler
   to work correctly (i.e. types like `:exn` or `:list`)
*/
module std/core
pub import std/core/types = std/core/types = "";
import std/core/undiv = std/core/undiv = "";
import std/core/unsafe = std/core/unsafe = "";
pub import std/core/hnd = std/core/hnd = "";
pub import std/core/exn = std/core/exn = "";
pub import std/core/bool = std/core/bool = "";
pub import std/core/order = std/core/order = "";
pub import std/core/char = std/core/char = "";
pub import std/core/int = std/core/int = "";
pub import std/core/vector = std/core/vector = "";
pub import std/core/string = std/core/string = "";
pub import std/core/sslice = std/core/sslice = "";
pub import std/core/list = std/core/list = "";
pub import std/core/maybe = std/core/maybe = "";
pub import std/core/maybe2 = std/core/maybe2 = "";
pub import std/core/either = std/core/either = "";
pub import std/core/tuple = std/core/tuple = "";
pub import std/core/lazy = std/core/lazy = "";
pub import std/core/show = std/core/show = "";
pub import std/core/debug = std/core/debug = "";
pub import std/core/delayed = std/core/delayed = "";
pub import std/core/console = std/core/console = "";
// The `:blocking` effect signifies that a function may block
pub type blocking[69,1,69,22] :: X ;
// The `:fsys` effect signifies a function may access the file system
pub type fsys[63,1,63,18] :: X ;
// The `:global-scope` is a special type constant to denote the global scope
pub type global-scope[57,1,57,26] :: S ;
// The `:net` effect signifies a function may access the network
pub type net[60,1,60,17] :: X ;
// The `:ui` effect signifies a function may access the graphics system
pub type ui[66,1,66,16] :: X ;
// The `:io-total` effect is used for functions that perform arbitrary I/O operations, but are terminating without raising exceptions.
pub alias io-total :: E = <(ndet :: X),(console/console :: X),(net :: X),(fsys :: X),(ui :: X),((st :: H -> E)<(global :: H)> == 1 <(read :: H -> X)<(global :: H)>,(write :: H -> X)<(global :: H)>,(alloc :: H -> X)<(global :: H)>>)> = 2;
// The `:io-noexn` effect is used for functions that perform arbitrary I/O operations, but raise no exceptions
