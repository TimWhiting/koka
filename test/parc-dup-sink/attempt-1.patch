+-- | Which of this guard's pattern variables may have their dup DEFERRED into
+-- the branches of an immediately nested match.
+--
+-- A deferred dup is emitted by the nested guard instead (see `pending`), where
+-- it meets the drop of this scrutinee in the same `optimizeDupDrops` call and
+-- can be cancelled. Emitted here it would just execute and be undone -- which is
+-- what makes an in-place record update inside a nested match cost a dup+drop per
+-- field today.
+--
+-- Conditions, all needed for soundness rather than profit:
+--
+--  * the body is (lets over) a `Case`, and every branch of it is processed by
+--    `parcGuard`, so every branch that USES a deferred variable dups it, and
+--    exactly one branch runs;
+--  * a variable used before the branches (in those lets, or in the scrutinees)
+--    is NOT deferrable -- it is needed before any branch is entered;
+--  * every branch guard is trivially true: a guard TEST is processed with
+--    everything borrowed, so it dups its own uses, and deferring into one would
+--    dup twice;
+--  * the scrutinee is owned, so it is dropped inside and there is a drop to fuse
+--    with. This is the "only if there is potential for fusion" condition: with no
+--    drop to cancel against, deferring would just copy dups into every branch.
+deferrableInto :: [TName] -> TNames -> Expr -> Parc TNames
+deferrableInto scrutinees ownedPvs body
+  = do ownedScruts <- filterM isOwned scrutinees
+       if null ownedScruts || S.null ownedPvs then return S.empty else
+         case stripLets body of
+           Nothing -> return S.empty
+           Just (defs, cscruts, brs)
+             | all trivialGuards brs
+               -> let usedEarly = S.unions (map fv cscruts ++ map (fv . defExpr) defs)
+                  in return (ownedPvs \\ usedEarly)
+             | otherwise -> return S.empty
+  where
+    trivialGuards (Branch _ gs) = all (isExprTrue . guardTest) gs
+    stripLets expr
+      = case expr of
+          Let dgs body' -> case stripLets body' of
+                             Just (defs, cscruts, brs) -> Just (concatMap defsOf dgs ++ defs, cscruts, brs)
+                             Nothing -> Nothing
+          Case cscruts brs -> Just ([], cscruts, brs)
+          _ -> Nothing
+    defsOf (DefNonRec d) = [d]
+    defsOf (DefRec ds)   = ds
+
 type Dups     = TNames
 type Drops    = TNames
 
