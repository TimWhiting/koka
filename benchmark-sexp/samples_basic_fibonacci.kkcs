((module samples/basic/fibonacci)
  (defs
    (def samples/basic/fibonacci/fib
      (fn (n x1 x2)
        (match (std/core/int/<= (n 0))
          [std/core/types/True x1]
          [std/core/types/False (samples/basic/fibonacci/fib ((std/core/int/- (n 1)) x2 (std/core/int/+ (x1 x2))))])))
    (def samples/basic/fibonacci/fibonacci
      (fn (n)
        (samples/basic/fibonacci/fib (n 0 1))))
    (def samples/basic/fibonacci/main
      (fn ()
        (letrec* ([n 10000])
          (std/core/console/string/println ((std/core/types/++ ("The " (std/core/types/++ ((std/core/int/show (n)) (std/core/types/++ ("th fibonacci number is " (std/core/int/show ((samples/basic/fibonacci/fibonacci (10000)))))))))))))))
    (def samples/basic/fibonacci/examplex
      (fn ()
        (std/core/console/default/show/println ((samples/basic/fibonacci/fibonacci (100)) std/core/int/show))))
    (def samples/basic/fibonacci/example2
      (fn ()
        (std/core/console/default/show/println ((samples/basic/fibonacci/fibonacci (1000)) std/core/int/show))))))