(module
  handlers/named/ask-poly
  (define handlers/named/ask-poly/reader/h-tag
    "reader@ask-poly")
  (define handlers/named/ask-poly/reader/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-named-handle handlers/named/ask-poly/reader/h-tag hnd ret action)))
  (define handlers/named/ask-poly/reader/h-fun-ask
    (λ (reader)
      (match reader
        [(handlers/named/ask-poly/reader _ h-x) h-x])))
  (define handlers/named/ask-poly/ask/h-select
    (λ (hnd)
      (match hnd
        [(handlers/named/ask-poly/reader _ h-fun-ask) h-fun-ask])))
  (define handlers/named/ask-poly/ask
    (λ (h-hname)
      (perform handlers/named/ask-poly/reader ask)))
  (define handlers/named/ask-poly/reader
    (λ (x action)
      ((λ (h-action)
        (handlers/named/ask-poly/reader/h-handle (handler handlers/named/ask-poly/reader [fun ask (λ ()
          x)]) (λ (h-res)
          h-res) h-action)) (λ (r)
        (action r)))))
  (define handlers/named/ask-poly/read2files
    (λ (r1 r2 h-implicit/show)
      (std/core/console/string/println (std/core/types/++ (handlers/named/ask-poly/ask r1) (std/core/types/++ " " (h-implicit/show (handlers/named/ask-poly/ask r2)))))))
  (define handlers/named/ask-poly/main
    (λ ()
      (handlers/named/ask-poly/reader "hello" (λ (r1)
        (handlers/named/ask-poly/reader 42 (λ (r2)
          (handlers/named/ask-poly/read2files r1 r2 std/core/int/show))))))))