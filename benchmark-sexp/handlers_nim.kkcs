(module
  handlers/nim
  (define handlers/nim/is-bob
    (λ (player)
      (match player
        [handlers/nim/Bob std/core/types/True]
        [handlers/nim/Alice std/core/types/False])))
  (define handlers/nim/is-alice
    (λ (player)
      (match player
        [handlers/nim/Alice std/core/types/True]
        [handlers/nim/Bob std/core/types/False])))
  (define handlers/nim/==
    (λ (p1 p2)
      (match (std/core/types/Tuple2 p1 p2)
        [(std/core/types/Tuple2 handlers/nim/Bob handlers/nim/Bob) std/core/types/True]
        [(std/core/types/Tuple2 handlers/nim/Alice handlers/nim/Alice) std/core/types/True]
        [_ std/core/types/False])))
  (define handlers/nim/player/show
    (λ (p)
      (match p
        [handlers/nim/Bob "bob"]
        [handlers/nim/Alice "alice"])))
  (define handlers/nim/move/h-ctl-move
    (λ (move)
      (match move
        [(handlers/nim/h-Hnd-move _ h-x) h-x])))
  (define handlers/nim/move/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/nim/move/h-tag hnd ret action)))
  (define handlers/nim/move/h-select
    (λ (hnd)
      (match hnd
        [(handlers/nim/h-Hnd-move _ h-ctl-move) h-ctl-move])))
  (define handlers/nim/move
    (λ (player sticks)
      (perform handlers/nim/move move player sticks)))
  (define handlers/nim/alice-turn
    (λ (n)
      (match (std/core/int/<= n 0)
        [std/core/types/True handlers/nim/Bob]
        [std/core/types/False (handlers/nim/bob-turn (std/core/int/- n (handlers/nim/move handlers/nim/Alice n)))])))
  (define handlers/nim/bob-turn
    (λ (n)
      (match (std/core/int/<= n 0)
        [std/core/types/True handlers/nim/Alice]
        [std/core/types/False (handlers/nim/alice-turn (std/core/int/- n (handlers/nim/move handlers/nim/Bob n)))])))
  (define handlers/nim/game
    (λ (n)
      (handlers/nim/alice-turn n)))
  (define handlers/nim/perfect
    (λ (h-action)
      (handlers/nim/move/h-handle (handler handlers/nim/h-Hnd-move [ctl move (std/core/hnd/clause-tail2 (λ (_p n)
        (std/core/int/max 1 (std/core/int/% n 4))))]) (λ (h-res)
        h-res) h-action)))
  (define handlers/nim/example-perfect1
    (λ ()
      (handlers/nim/perfect (λ ()
        (handlers/nim/game 7)))))
  (define handlers/nim/example-perfect2
    (λ ()
      (handlers/nim/perfect (λ ()
        (handlers/nim/game 12)))))
  (define handlers/nim/is-take
    (λ (gtree)
      (match gtree
        [(handlers/nim/Take _ _) std/core/types/True]
        [(handlers/nim/Winner _) std/core/types/False])))
  (define handlers/nim/gtree/player
    (λ (gtree)
      (match gtree
        [(handlers/nim/Take h-x _) h-x]
        [(handlers/nim/Winner h-x) h-x])))
  (define handlers/nim/is-winner
    (λ (gtree)
      (match gtree
        [(handlers/nim/Winner _) std/core/types/True]
        [(handlers/nim/Take _ _) std/core/types/False])))
  (define handlers/nim/valid-moves
    (λ (n)
      (std/core/list/filter (std/core/types/Cons 1 (std/core/types/Cons 2 (std/core/types/Cons 3 std/core/types/Nil))) (λ (m)
        (std/core/int/<= m n)))))
  (define handlers/nim/gametree
    (λ (h-action)
      (handlers/nim/move/h-handle (handler handlers/nim/h-Hnd-move [ctl move (std/core/hnd/clause-control2 (λ (p n resume)
        (letrec* ([moves (handlers/nim/valid-moves n)] [subgames (std/core/list/map moves resume)] [subtrees (std/core/list/zip moves subgames)])
          (handlers/nim/Take p subtrees))))]) (λ (x)
        (handlers/nim/Winner x)) h-action)))
  (define handlers/nim/show-gtree
    (λ (gt indent)
      (match gt
        [(handlers/nim/Winner p) (std/core/types/++ (handlers/nim/player/show p) " wins")]
        [(handlers/nim/Take p moves) (letrec* ([lines (std/core/list/map moves (λ (h-pat-x101_32)
          (match h-pat-x101_32
            [(std/core/types/Tuple2 sticks gtx) (std/core/types/++ "\n" (std/core/types/++ (std/core/string/repeat " " indent) (std/core/types/++ (std/core/int/show sticks) (std/core/types/++ " -> " (handlers/nim/show-gtree gtx (std/core/int/+ indent 2))))))])))])
          (std/core/types/++ (handlers/nim/player/show p) (std/core/list/concat/join lines)))])))
  (define handlers/nim/gtree/show
    (λ (gt)
      (handlers/nim/show-gtree gt 2)))
  (define handlers/nim/example-gtree
    (λ ()
      (handlers/nim/gametree (λ ()
        (handlers/nim/game 3)))))
  (define handlers/nim/cheat/h-fun-cheat
    (λ (cheat)
      (match cheat
        [(handlers/nim/h-Hnd-cheat _ h-x) h-x])))
  (define handlers/nim/cheat/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/nim/cheat/h-tag hnd ret action)))
  (define handlers/nim/cheat/h-select
    (λ (hnd)
      (match hnd
        [(handlers/nim/h-Hnd-cheat _ h-fun-cheat) h-fun-cheat])))
  (define handlers/nim/cheat
    (λ (player)
      (perform handlers/nim/cheat cheat player)))
  (define handlers/nim/cheat-report
    (λ (h-action)
      (handlers/nim/cheat/h-handle (handler handlers/nim/h-Hnd-cheat [fun cheat (std/core/hnd/clause-tail1 (λ (p)
        (std/core/exn/throw (std/core/types/++ (handlers/nim/player/show p) " cheated!") std/core/types/h-None)))]) (λ (h-res)
        h-res) h-action)))
  (define handlers/nim/check
    (λ (h-action)
      (handlers/nim/move/h-handle (handler handlers/nim/h-Hnd-move [ctl move (std/core/hnd/clause-control2 (λ (p n resume)
        (letrec* ([m (handlers/nim/move p n)])
          (match (std/core/maybe/bool (std/core/list/find (handlers/nim/valid-moves n) (λ (i)
            (std/core/int/== i m))))
            [std/core/types/True (resume m)]
            [std/core/types/False (handlers/nim/cheat p)]))))]) (λ (h-res)
        h-res) h-action)))
  (define handlers/nim/example-check
    (λ ()
      (handlers/nim/perfect (λ ()
        (handlers/nim/cheat-report (λ ()
          (handlers/nim/check (λ ()
            (handlers/nim/game 7)))))))))
  (define handlers/nim/example-use
    (λ ()
      (std/core/list/map (std/core/types/Cons 1 (std/core/types/Cons 2 (std/core/types/Cons 3 std/core/types/Nil))) (λ (x)
        (std/core/int/+ x 2)))))
  (define handlers/nim/pc
    (λ (h-action)
      (handlers/nim/move/h-handle (handler handlers/nim/h-Hnd-move [ctl move (std/core/hnd/clause-tail2 (λ (p n)
        (match p
          [handlers/nim/Alice (std/core/int/max 1 (std/core/int/% n 4))]
          [handlers/nim/Bob n])))]) (λ (h-res)
        h-res) h-action)))
  (define handlers/nim/example-pc1
    (λ ()
      (handlers/nim/pc (λ ()
        (handlers/nim/cheat-report (λ ()
          (handlers/nim/check (λ ()
            (handlers/nim/game 12)))))))))
  (define handlers/nim/example-pc2
    (λ ()
      (handlers/nim/perfect (λ ()
        (handlers/nim/cheat-report (λ ()
          (handlers/nim/check (λ ()
            (handlers/nim/pc (λ ()
              (handlers/nim/game 12)))))))))))
  (define handlers/nim/choose/h-ctl-choose
    (λ (choose)
      (match choose
        [(handlers/nim/h-Hnd-choose _ h-x) h-x])))
  (define handlers/nim/choose/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/nim/choose/h-tag hnd ret action)))
  (define handlers/nim/choose/h-select
    (λ (hnd)
      (match hnd
        [(handlers/nim/h-Hnd-choose _ h-ctl-choose) h-ctl-choose])))
  (define handlers/nim/choose
    (λ ()
      (perform handlers/nim/choose choose)))
  (define handlers/nim/bob-chooses
    (λ (m)
      (match (handlers/nim/choose)
        [std/core/types/True (handlers/nim/pc m)]
        [std/core/types/False (handlers/nim/perfect m)])))
  (define handlers/nim/all-results
    (λ (h-action)
      (handlers/nim/choose/h-handle (handler handlers/nim/h-Hnd-choose [ctl choose (std/core/hnd/clause-control0 (λ (resume)
        (std/core/list/++ (resume std/core/types/True) (resume std/core/types/False))))]) (λ (x)
        (std/core/types/Cons x std/core/types/Nil)) h-action)))
  (define handlers/nim/example-choose
    (λ ()
      ((λ (h-action)
        (handlers/nim/choose/h-handle (handler handlers/nim/h-Hnd-choose [ctl choose (std/core/hnd/clause-control0 (λ (resume)
          (std/core/list/++ (resume std/core/types/True) (resume std/core/types/False))))]) (λ (h-res)
          h-res) h-action)) (λ ()
        (handlers/nim/bob-chooses (λ ()
          (std/core/types/Cons (handlers/nim/game 7) std/core/types/Nil)))))))
  (define handlers/nim/coin
    (λ (h-action)
      (handlers/nim/choose/h-handle (handler handlers/nim/h-Hnd-choose [ctl choose (std/core/hnd/clause-tail0 (λ ()
        (std/num/float64/> (std/num/random/srandom-float64) 0.5)))]) (λ (h-res)
        h-res) h-action)))
  (define handlers/nim/example-coin
    (λ ()
      (handlers/nim/coin (λ ()
        (handlers/nim/bob-chooses (λ ()
          (handlers/nim/game 7)))))))
  (define handlers/nim/state/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/nim/state/h-tag hnd ret action)))
  (define handlers/nim/state/h-fun-get
    (λ (state)
      (match state
        [(handlers/nim/h-Hnd-state _ h-x _) h-x])))
  (define handlers/nim/get/h-select
    (λ (hnd)
      (match hnd
        [(handlers/nim/h-Hnd-state _ h-fun-get _) h-fun-get])))
  (define handlers/nim/get
    (λ ()
      (perform handlers/nim/state get)))
  (define handlers/nim/state/h-fun-put
    (λ (state)
      (match state
        [(handlers/nim/h-Hnd-state _ _ h-x) h-x])))
  (define handlers/nim/put/h-select
    (λ (hnd)
      (match hnd
        [(handlers/nim/h-Hnd-state _ _ h-fun-put) h-fun-put])))
  (define handlers/nim/put
    (λ (x)
      (perform handlers/nim/state put x)))
  (define handlers/nim/state
    (λ (init action)
      (std/core/types/local-scope (λ ()
        (letrec* ([ievh-3439 std/core/types/h-Hnodiv])
          (std/core/hnd/local-var init (λ (s)
            ((λ (h-action)
              (handlers/nim/state/h-handle (handler handlers/nim/h-Hnd-state [fun get (std/core/hnd/clause-tail0 (λ ()
                (std/core/types/local-get s ievh-3439)))] [fun put (std/core/hnd/clause-tail1 (λ (x)
                (std/core/types/local-set s x)))]) (λ (h-res)
                h-res) h-action)) (λ ()
              (std/core/hnd/h-mask-builtin (λ ()
                (action))))))))))))
  (define handlers/nim/s0
    (std/core/types/Cons (std/core/types/Tuple2 handlers/nim/Alice 0) (std/core/types/Cons (std/core/types/Tuple2 handlers/nim/Bob 0) std/core/types/Nil)))
  (define handlers/nim/update-score
    (λ (p gs)
      (std/core/list/map gs (λ (h-pat-x228_14)
        (match h-pat-x228_14
          [(std/core/types/Tuple2 q s) (match (handlers/nim/== p q)
            [std/core/types/True (std/core/types/Tuple2 q (std/core/int/+ s 1))]
            [std/core/types/False (std/core/types/Tuple2 q s)])])))))
  (define handlers/nim/score-updater
    (λ (h-action)
      ((λ (p)
        (letrec* ([_ (handlers/nim/put (handlers/nim/update-score p (handlers/nim/get)))])
          p)) (h-action))))
  (define handlers/nim/print-board
    (λ (gs)
      (letrec* ([scores (std/core/list/map gs (λ (h-pat-x234_26)
        (match h-pat-x234_26
          [(std/core/types/Tuple2 p s) (std/core/types/++ (handlers/nim/player/show p) (std/core/types/++ " -> " (std/core/int/show s)))])))])
        (std/core/console/string/println (std/core/list/joinsep/join scores "\n")))))
  (define handlers/nim/printer
    (λ (h-action)
      ((λ (x)
        (letrec* ([_ (handlers/nim/print-board (handlers/nim/get))])
          x)) (h-action))))
  (define handlers/nim/example-print1
    (λ ()
      (handlers/nim/state handlers/nim/s0 (λ ()
        (handlers/nim/printer (λ ()
          (handlers/nim/coin (λ ()
            (handlers/nim/bob-chooses (λ ()
              (handlers/nim/score-updater (λ ()
                (handlers/nim/game 7)))))))))))))
  (define handlers/nim/replay
    (λ (n action)
      ((λ (h-action)
        ((λ (x)
          (match (std/core/int/<= n 1)
            [std/core/types/True x]
            [std/core/types/False (handlers/nim/replay (std/core/int/- n 1) action)])) (h-action))) (λ ()
        (action)))))
  (define handlers/nim/example-print2
    (λ ()
      (handlers/nim/state handlers/nim/s0 (λ ()
        (handlers/nim/printer (λ ()
          (handlers/nim/replay 10 (λ ()
            (handlers/nim/coin (λ ()
              (handlers/nim/bob-chooses (λ ()
                (handlers/nim/score-updater (λ ()
                  (handlers/nim/game 7)))))))))))))))
  (define handlers/nim/main
    (λ ()
      (letrec* ([_ (std/core/console/string/print (std/core/list/joinsep/join (std/core/types/Cons "" (std/core/types/Cons (handlers/nim/player/show (handlers/nim/example-perfect1)) (std/core/types/Cons (handlers/nim/player/show (handlers/nim/example-perfect2)) (std/core/types/Cons (handlers/nim/gtree/show (handlers/nim/example-gtree)) (std/core/types/Cons (handlers/nim/player/show (handlers/nim/example-check)) (std/core/types/Cons (handlers/nim/player/show (handlers/nim/example-pc2)) (std/core/types/Cons (std/core/list/show (handlers/nim/example-choose) handlers/nim/player/show) (std/core/types/Cons "" std/core/types/Nil)))))))) "\n-----------\n"))])
        (std/core/exn/handle/try (λ ()
          (std/core/console/string/println (handlers/nim/player/show (handlers/nim/example-pc1)))) (λ (exn)
          (std/core/console/string/println (std/core/exn/show exn))))))))