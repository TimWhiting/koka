(module
  std/os/file
  (define std/os/file/prepend
    (λ (exn pre)
      (std/core/exn/Exception (std/core/types/++ pre (std/core/types/++ ": " (std/core/exn/exception/message exn))) (std/core/exn/exception/info exn))))
  (define std/os/file/read-text-file-err
    (λ (path)
      (std/os/file/h-extern-read-text-file-err path)))
  (define std/os/file/read-text-file
    (λ (path)
      (match (std/os/file/read-text-file-err (std/os/path/string path))
        [(std/core/exn/Error (as exn (std/core/exn/Exception _ _))) (std/core/exn/throw-exn (std/os/file/prepend exn (std/core/types/++ "unable to read text file " (std/os/path/show path))))]
        [(std/core/exn/Ok content) content])))
  (define std/os/file/write-text-file-err
    (λ (path content)
      (std/os/file/h-extern-write-text-file-err path content)))
  (define std/os/file/write-text-file
    (λ (path content create-dir)
      (letrec* ([h-uniq-create-dirh-188 (match create-dir
        [(std/core/types/h-Optional h-uniq-create-dirh-189) h-uniq-create-dirh-189]
        [std/core/types/h-None std/core/types/True])] [_ (match h-uniq-create-dirh-188
        [std/core/types/True (std/os/dir/ensure-dir (std/os/path/nobase path))]
        [std/core/types/False std/core/types/Unit])])
        (match (std/os/file/write-text-file-err (std/os/path/string path) content)
          [(std/core/exn/Error (as exn (std/core/exn/Exception _ _))) (std/core/exn/throw-exn (std/os/file/prepend exn (std/core/types/++ "unable to write text file " (std/os/path/show path))))]
          [_ std/core/types/Unit])))))