(module
  analysis/benchmarks/suite/basic
  (define analysis/benchmarks/suite/basic/ex1/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle analysis/benchmarks/suite/basic/ex1/h-tag hnd ret action)))
  (define analysis/benchmarks/suite/basic/ex1/h-ctl-ex1
    (λ (ex1)
      (match ex1
        [(analysis/benchmarks/suite/basic/h-Hnd-ex1 _ h-x) h-x])))
  (define analysis/benchmarks/suite/basic/ex1/h-select
    (λ (hnd)
      (match hnd
        [(analysis/benchmarks/suite/basic/h-Hnd-ex1 _ h-ctl-ex1) h-ctl-ex1])))
  (define analysis/benchmarks/suite/basic/ex1
    (λ (i)
      (perform analysis/benchmarks/suite/basic/ex1 ex1 i)))
  (define analysis/benchmarks/suite/basic/analyze-basic-exception
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Example 1 - exceptions")])
        ((λ (h-action)
          (analysis/benchmarks/suite/basic/ex1/h-handle (handler analysis/benchmarks/suite/basic/h-Hnd-ex1 [ctl ex1 (std/core/hnd/clause-control1 (λ (a resume)
            a))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (analysis/benchmarks/suite/basic/ex1 1))))))
  (define analysis/benchmarks/suite/basic/result-basic-exception
    (λ ()
      1))
  (define analysis/benchmarks/suite/basic/analyze-basic-resume
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Example 10 - simple")])
        ((λ (h-action)
          (analysis/benchmarks/suite/basic/ex1/h-handle (handler analysis/benchmarks/suite/basic/h-Hnd-ex1 [ctl ex1 (std/core/hnd/clause-control1 (λ (a resume)
            (resume (std/core/int/+ a 1))))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (analysis/benchmarks/suite/basic/ex1 0))))))
  (define analysis/benchmarks/suite/basic/result-basic-resume
    (λ ()
      1))
  (define analysis/benchmarks/suite/basic/analyze-basic-resume-context
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Example 121 - simple cont")])
        ((λ (h-action)
          (analysis/benchmarks/suite/basic/ex1/h-handle (handler analysis/benchmarks/suite/basic/h-Hnd-ex1 [ctl ex1 (std/core/hnd/clause-control1 (λ (a resume)
            (resume (std/core/int/+ a 1))))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (std/core/int/+ (analysis/benchmarks/suite/basic/ex1 0) 1))))))
  (define analysis/benchmarks/suite/basic/result-basic-resume-context
    (λ ()
      2))
  (define analysis/benchmarks/suite/basic/analyze-basic-resume-op
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Example 122 - simple cont")])
        ((λ (h-action)
          (analysis/benchmarks/suite/basic/ex1/h-handle (handler analysis/benchmarks/suite/basic/h-Hnd-ex1 [ctl ex1 (std/core/hnd/clause-control1 (λ (a resume)
            (std/core/int/+ (resume (std/core/int/+ a 1)) 1)))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (analysis/benchmarks/suite/basic/ex1 0))))))
  (define analysis/benchmarks/suite/basic/result-basic-resume-op
    (λ ()
      2))
  (define analysis/benchmarks/suite/basic/analyze-basic-resume-op-context
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Example 123 - simple cont2")])
        ((λ (h-action)
          (analysis/benchmarks/suite/basic/ex1/h-handle (handler analysis/benchmarks/suite/basic/h-Hnd-ex1 [ctl ex1 (std/core/hnd/clause-control1 (λ (a resume)
            (std/core/int/+ (resume (std/core/int/+ a 1)) 1)))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (std/core/int/+ (analysis/benchmarks/suite/basic/ex1 0) 1))))))
  (define analysis/benchmarks/suite/basic/result-basic-resume-op-context
    (λ ()
      3))
  (define analysis/benchmarks/suite/basic/test-basic-exception
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/basic/analyze-basic-exception)])
        (match (std/core/int/== result (analysis/benchmarks/suite/basic/result-basic-exception))
          [std/core/types/True (std/core/console/string/println "✓ test-basic-exception passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-basic-exception FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/basic/result-basic-exception)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/basic/test-basic-resume
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/basic/analyze-basic-resume)])
        (match (std/core/int/== result (analysis/benchmarks/suite/basic/result-basic-resume))
          [std/core/types/True (std/core/console/string/println "✓ test-basic-resume passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-basic-resume FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/basic/result-basic-resume)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/basic/test-basic-resume-context
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/basic/analyze-basic-resume-context)])
        (match (std/core/int/== result (analysis/benchmarks/suite/basic/result-basic-resume-context))
          [std/core/types/True (std/core/console/string/println "✓ test-basic-resume-context passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-basic-resume-context FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/basic/result-basic-resume-context)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/basic/test-basic-resume-op
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/basic/analyze-basic-resume-op)])
        (match (std/core/int/== result (analysis/benchmarks/suite/basic/result-basic-resume-op))
          [std/core/types/True (std/core/console/string/println "✓ test-basic-resume-op passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-basic-resume-op FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/basic/result-basic-resume-op)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/basic/test-basic-resume-op-context
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/basic/analyze-basic-resume-op-context)])
        (match (std/core/int/== result (analysis/benchmarks/suite/basic/result-basic-resume-op-context))
          [std/core/types/True (std/core/console/string/println "✓ test-basic-resume-op-context passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-basic-resume-op-context FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/basic/result-basic-resume-op-context)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/basic/main
    (λ ()
      (letrec* ([_ (std/core/console/string/println "Running basic tests...")] [_ (analysis/benchmarks/suite/basic/test-basic-exception)] [_ (analysis/benchmarks/suite/basic/test-basic-resume)] [_ (analysis/benchmarks/suite/basic/test-basic-resume-context)] [_ (analysis/benchmarks/suite/basic/test-basic-resume-op)] [_ (analysis/benchmarks/suite/basic/test-basic-resume-op-context)])
        (std/core/console/string/println "basic tests complete")))))