((module learn/qualifiers)
  (defs
    (def learn/qualifiers/example1
      (fn ()
        (std/core/list/map ((std/core/types/Cons (1 (std/core/types/Cons (2 std/core/types/Nil)))) std/core/int/show))))
    (def learn/qualifiers/example1-explicit
      (fn ()
        (std/core/list/map ((std/core/types/Cons (1 (std/core/types/Cons (2 std/core/types/Nil)))) std/core/int/show))))
    (def learn/qualifiers/example1-semi-explicit
