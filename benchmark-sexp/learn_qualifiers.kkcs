(module
  learn/qualifiers
  (define learn/qualifiers/example1
    (λ ()
      (std/core/list/map (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) std/core/int/show)))
  (define learn/qualifiers/example1-explicit
    (λ ()
      (std/core/list/map (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) std/core/int/show)))
  (define learn/qualifiers/example1-semi-explicit
    (λ ()
      (std/core/list/map (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) std/core/int/show)))
  (define learn/qualifiers/int/foo
    (λ (i)
      (std/core/int/count-digits i)))
  (define learn/qualifiers/string/foo
    (λ (s)
      (learn/qualifiers/int/foo (std/core/maybe/default (std/core/int/parse-int s std/core/types/h-None) 42))))
  (define learn/qualifiers/example2
    (λ ()
      (std/core/int/+ (learn/qualifiers/int/foo 10) (learn/qualifiers/string/foo "hi"))))
  (define learn/qualifiers/example3
    (λ ()
      (std/core/int/+ (learn/qualifiers/int/foo 11) (learn/qualifiers/string/foo "hi there"))))
  (define learn/qualifiers/example4a
    (λ (x)
      (std/core/int/+ (learn/qualifiers/int/foo x) (learn/qualifiers/string/foo "hi there"))))
  (define learn/qualifiers/example4b
    (λ (x)
      (std/core/int/+ (learn/qualifiers/int/foo x) (learn/qualifiers/string/foo "hi there"))))
  (define learn/qualifiers/main
    (λ ()
      (learn/qualifiers/example4b 42))))