  (define std/core/range/fold-while
    (λ (start end init f)
      (match (std/core/int/> start end)
        [std/core/types/True init]
        [std/core/types/False (match (f start init)
          [(std/core/types/Just x) (std/core/range/fold-while (std/core/int/inc start) end x f)]
          [std/core/types/Nothing init])])))
  (define std/core/fold-while
    (λ (n init f)
