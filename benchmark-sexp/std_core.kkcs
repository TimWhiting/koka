          [std/core/types/True (letrec* ([_ (action i)])
            (rep (std/core/int/inc i)))]
          [std/core/types/False std/core/types/Unit]))])
        (rep start))))
  (define std/core/for
    (λ (n action)
      (std/core/range/for 0 (std/core/int/- n 1) action)))
  (define std/core/repeat
