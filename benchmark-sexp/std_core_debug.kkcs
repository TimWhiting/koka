        (std/core/types/ref (std/core/types/True))))))
    (def std/core/debug/trace
      (fn (message)
        (letrec* ([ievh-155 std/core/types/h-Hdiv] [ievh-160 std/core/types/h-Hnodiv])
          (std/core/unsafe/unsafe-total ((fn ()
            (match (std/core/types/ref/! (std/core/debug/trace-enabled ievh-160))
              [std/core/types/True (std/core/debug/xtrace (message))]
              [std/core/types/False std/core/types/Unit])))))))
    (def std/core/debug/trace-info
      (fn (message h-implicit/kk-file-line)
