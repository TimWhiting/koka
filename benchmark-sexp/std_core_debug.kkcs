(module
  std/core/debug
  (define std/core/debug/file/kk-module
    "")
  (define std/core/debug/file/kk-line
    "")
  (define std/core/debug/file/kk-file
    "")
  (define std/core/debug/file/kk-file-line
    (λ (h-implicit/kk-file h-implicit/kk-line)
      (std/core/types/++ h-implicit/kk-file (std/core/types/++ "(" (std/core/types/++ h-implicit/kk-line ")")))))
  (define std/core/debug/xtrace
    (λ (message)
      (std/core/debug/h-extern-xtrace message)))
  (define std/core/debug/xtrace-any
    (λ (message x)
      (std/core/debug/h-extern-xtrace-any message x)))
  (define std/core/debug/trace-enabled
    (std/core/unsafe/unsafe-total (λ ()
      (std/core/types/ref std/core/types/True))))
  (define std/core/debug/trace
    (λ (message)
      (letrec* ([ievh-155 std/core/types/h-Hdiv] [ievh-160 std/core/types/h-Hnodiv])
        (std/core/unsafe/unsafe-total (λ ()
          (match (std/core/types/ref/! std/core/debug/trace-enabled ievh-160)
            [std/core/types/True (std/core/debug/xtrace message)]
            [std/core/types/False std/core/types/Unit]))))))
  (define std/core/debug/trace-info
    (λ (message h-implicit/kk-file-line)
      (std/core/debug/trace (std/core/types/++ h-implicit/kk-file-line (std/core/types/++ ": " message)))))
  (define std/core/debug/trace-show
    (λ (x h-implicit/show h-implicit/kk-file-line)
      (std/core/debug/trace-info (h-implicit/show x) h-implicit/kk-file-line)))
  (define std/core/debug/trace-any
    (λ (message x)
      (letrec* ([ievh-251 std/core/types/h-Hdiv] [ievh-256 std/core/types/h-Hnodiv])
        (std/core/unsafe/unsafe-total (λ ()
          (match (std/core/types/ref/! std/core/debug/trace-enabled ievh-256)
            [std/core/types/True (std/core/debug/xtrace-any message x)]
            [std/core/types/False std/core/types/Unit]))))))
  (define std/core/debug/notrace
    (λ ()
      (std/core/types/set std/core/debug/trace-enabled std/core/types/False)))
  (define std/core/debug/unsafe-abort
    (λ (msg)
      (std/core/debug/h-extern-unsafe-abort msg)))
  (define std/core/debug/impossible
    (λ (message h-implicit/kk-file-line)
      (letrec* ([h-uniq-messageh-333 (match message
        [(std/core/types/h-Optional h-uniq-messageh-334) h-uniq-messageh-334]
        [std/core/types/h-None "?"])])
        (std/core/debug/unsafe-abort (std/core/types/++ h-implicit/kk-file-line (std/core/types/++ ": impossible:" h-uniq-messageh-333))))))
  (define std/core/debug/assert
    (λ (message condition h-implicit/kk-file-line)
      (letrec* ([ievh-374 std/core/types/h-Hdiv])
        (match (std/core/types/bool/! condition)
          [std/core/types/True (std/core/debug/unsafe-abort (std/core/types/++ h-implicit/kk-file-line (std/core/types/++ ": assertion failed: " message)))]
          [std/core/types/False std/core/types/Unit]))))
  (define std/core/debug/breakpoint
    (λ ()
      (std/core/debug/h-extern-breakpoint))))