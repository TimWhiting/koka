(module
  learn/contexts
  (define learn/contexts/map-std
    (λ (xs f)
      (match xs
        [(std/core/types/Cons x xx) (std/core/types/Cons (f x) (learn/contexts/map-std xx f))]
        [std/core/types/Nil std/core/types/Nil])))
  (define learn/contexts/map-tail
    (λ (xs f)
      (match xs
        [(std/core/types/Cons x xx) (std/core/types/Cons (f x) (learn/contexts/map-tail xx f))]
        [std/core/types/Nil std/core/types/Nil])))
  (define learn/contexts/test-tail
    (λ ()
      (std/core/console/default/show/println (std/core/list/map (std/core/types/Cons 1 (std/core/types/Cons 2 (std/core/types/Cons 3 std/core/types/Nil))) std/core/int/inc) (λ (h-arg-x1)
        (std/core/list/show h-arg-x1 std/core/int/show)))))
  (define learn/contexts/map-acc
    (λ (xs f acc)
      (match xs
        [(std/core/types/Cons x xx) (learn/contexts/map-acc xx f (std/core/types/Cons (f x) acc))]
        [std/core/types/Nil (std/core/list/reverse acc)])))
  (define learn/contexts/map-acc-entry
    (λ (xs f)
      (learn/contexts/map-acc xs f std/core/types/Nil)))
  (define learn/contexts/test-acc
    (λ ()
      (std/core/console/default/show/println (learn/contexts/map-acc-entry (std/core/types/Cons 1 (std/core/types/Cons 2 (std/core/types/Cons 3 std/core/types/Nil))) std/core/int/inc) (λ (h-arg-x1)
        (std/core/list/show h-arg-x1 std/core/int/show)))))
  (define learn/contexts/map-td
    (λ (xs f acc)
      (match xs
        [(std/core/types/Cons x xx) (learn/contexts/map-td xx f (std/core/types/cctx/++ acc (letrec* ([h-cctx-x770 (std/core/types/Cons (f x) (std/core/types/h-cctx-hole-create))] [h-cctx-x771 (std/core/types/h-field-addr-of h-cctx-x770 "(\"std/core/types\",\"\",\"Cons\")" "(\"\",\"\",\"tail\")")])
          (std/core/types/h-cctx-create h-cctx-x770 h-cctx-x771))))]
        [std/core/types/Nil (std/core/types/cctx/++. acc std/core/types/Nil)])))
  (define learn/contexts/map-td-entry
    (λ (xs f)
      (learn/contexts/map-td xs f (std/core/types/cctx/empty))))
  (define learn/contexts/test-td
    (λ ()
      (std/core/console/default/show/println (learn/contexts/map-td-entry (std/core/types/Cons 1 (std/core/types/Cons 2 (std/core/types/Cons 3 std/core/types/Nil))) std/core/int/inc) (λ (h-arg-x1)
        (std/core/list/show h-arg-x1 std/core/int/show)))))
  (define learn/contexts/concat
    (λ (xs ys)
      (match xs
        [(std/core/types/Cons x xx) (std/core/types/Cons x (learn/contexts/concat xx ys))]
        [std/core/types/Nil ys])))
  (define learn/contexts/flatten
    (λ (xss)
      (match xss
        [(std/core/types/Cons xs xxs) (learn/contexts/concat xs (learn/contexts/flatten xxs))]
        [std/core/types/Nil std/core/types/Nil])))
  (define learn/contexts/concat-td
    (λ (xs acc)
      (match xs
        [(std/core/types/Cons x xx) (learn/contexts/concat-td xx (std/core/types/cctx/++ acc (letrec* ([h-cctx-x1142 (std/core/types/Cons x (std/core/types/h-cctx-hole-create))] [h-cctx-x1143 (std/core/types/h-field-addr-of h-cctx-x1142 "(\"std/core/types\",\"\",\"Cons\")" "(\"\",\"\",\"tail\")")])
          (std/core/types/h-cctx-create h-cctx-x1142 h-cctx-x1143))))]
        [std/core/types/Nil acc])))
  (define learn/contexts/flatten-td
    (λ (xss acc)
      (match xss
        [(std/core/types/Cons xs xxs) (learn/contexts/flatten-td xxs (learn/contexts/concat-td xs acc))]
        [std/core/types/Nil acc])))
  (define learn/contexts/flatten-entry
    (λ (xss)
      (std/core/types/cctx/++. (learn/contexts/flatten-td xss (std/core/types/cctx/empty)) std/core/types/Nil)))
  (define learn/contexts/example-flatten
    (λ ()
      (std/core/console/default/show/println (learn/contexts/flatten-entry (std/core/types/Cons (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) (std/core/types/Cons (std/core/types/Cons 3 (std/core/types/Cons 4 std/core/types/Nil)) (std/core/types/Cons std/core/types/Nil std/core/types/Nil)))) (λ (h-arg-x1)
        (std/core/list/show h-arg-x1 std/core/int/show)))))
  (define learn/contexts/partition-td
    (λ (xs pred acc1 acc2)
      (match xs
        [std/core/types/Nil (std/core/types/Tuple2 (std/core/types/cctx/++. acc1 std/core/types/Nil) (std/core/types/cctx/++. acc2 std/core/types/Nil))]
        [(std/core/types/Cons x xx) (match (pred x)
          [std/core/types/True (learn/contexts/partition-td xx pred (std/core/types/cctx/++ acc1 (letrec* ([h-cctx-x1524 (std/core/types/Cons x (std/core/types/h-cctx-hole-create))] [h-cctx-x1525 (std/core/types/h-field-addr-of h-cctx-x1524 "(\"std/core/types\",\"\",\"Cons\")" "(\"\",\"\",\"tail\")")])
            (std/core/types/h-cctx-create h-cctx-x1524 h-cctx-x1525))) acc2)]
          [std/core/types/False (learn/contexts/partition-td xx pred acc1 (std/core/types/cctx/++ acc2 (letrec* ([h-cctx-x1571 (std/core/types/Cons x (std/core/types/h-cctx-hole-create))] [h-cctx-x1572 (std/core/types/h-field-addr-of h-cctx-x1571 "(\"std/core/types\",\"\",\"Cons\")" "(\"\",\"\",\"tail\")")])
            (std/core/types/h-cctx-create h-cctx-x1571 h-cctx-x1572))))])])))
  (define learn/contexts/partition-entry
    (λ (xs pred)
      (learn/contexts/partition-td xs pred (std/core/types/cctx/empty) (std/core/types/cctx/empty))))
  (define learn/contexts/example-partition
    (λ ()
      (learn/contexts/partition-entry (std/core/types/Cons 1 (std/core/types/Cons 2 (std/core/types/Cons 3 (std/core/types/Cons 4 (std/core/types/Cons 5 std/core/types/Nil))))) std/core/int/is-odd)))
  (define learn/contexts/main
    (λ ()
      (std/core/console/default/show/println (learn/contexts/example-partition) (λ (h-arg-x1)
        (std/core/tuple/tuple2/show h-arg-x1 (λ (h-arg-x1)
          (std/core/list/show h-arg-x1 std/core/int/show)) (λ (h-arg-x1)
          (std/core/list/show h-arg-x1 std/core/int/show))))))))