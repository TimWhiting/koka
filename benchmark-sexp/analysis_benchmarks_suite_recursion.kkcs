(module
  analysis/benchmarks/suite/recursion
  (define analysis/benchmarks/suite/recursion/iter/h-tag
    "iter@recursion")
  (define analysis/benchmarks/suite/recursion/iter/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle analysis/benchmarks/suite/recursion/iter/h-tag hnd ret action)))
  (define analysis/benchmarks/suite/recursion/iter/h-ctl-it
    (λ (iter)
      (match iter
        [(analysis/benchmarks/suite/recursion/iter _ h-x) h-x])))
  (define analysis/benchmarks/suite/recursion/it/h-select
    (λ (hnd)
      (match hnd
        [(analysis/benchmarks/suite/recursion/iter _ h-ctl-it) h-ctl-it])))
  (define analysis/benchmarks/suite/recursion/it
    (λ (i)
      (perform analysis/benchmarks/suite/recursion/iter it i)))
  (define analysis/benchmarks/suite/recursion/iterxx
    (λ (n)
      (match (std/core/int/== n 0)
        [std/core/types/True 0]
        [std/core/types/False (letrec* ([n0 (analysis/benchmarks/suite/recursion/iterxx (std/core/int/- n 1))] [_ (analysis/benchmarks/suite/recursion/it n)])
          n0)])))
  (define analysis/benchmarks/suite/recursion/iterx
    (λ (n)
      (match (std/core/int/== n 0)
        [std/core/types/True -1]
        [std/core/types/False (letrec* ([_ (analysis/benchmarks/suite/recursion/it n)])
          (analysis/benchmarks/suite/recursion/iterx (std/core/int/- n 1)))])))
  (define analysis/benchmarks/suite/recursion/iter
    (λ (n)
      (match (std/core/int/== n 0)
        [std/core/types/True 0]
        [std/core/types/False (letrec* ([_ (analysis/benchmarks/suite/recursion/it n)])
          (analysis/benchmarks/suite/recursion/iter (std/core/int/- n 1)))])))
  (define analysis/benchmarks/suite/recursion/analyze-iter-sum
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Example x_suma")])
        ((λ (h-action)
          (analysis/benchmarks/suite/recursion/iter/h-handle (handler analysis/benchmarks/suite/recursion/iter [ctl it (λ (a resume)
            (std/core/int/+ a (resume a)))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (analysis/benchmarks/suite/recursion/iter 1))))))
  (define analysis/benchmarks/suite/recursion/result-iter-sum
    (λ ()
      1))
  (define analysis/benchmarks/suite/recursion/analyze-iter-sum-handler
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Example x_suma")])
        ((λ (h-action)
          (analysis/benchmarks/suite/recursion/iter/h-handle (handler analysis/benchmarks/suite/recursion/iter [ctl it (λ (a resume)
            (std/core/int/+ a (resume a)))]) (λ (x)
            0) h-action)) (λ ()
          (analysis/benchmarks/suite/recursion/iter 1))))))
  (define analysis/benchmarks/suite/recursion/result-iter-sum-handler
    (λ ()
      1))
  (define analysis/benchmarks/suite/recursion/analyze-iter-sum-two
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Example x_sum2a")])
        ((λ (h-action)
          (analysis/benchmarks/suite/recursion/iter/h-handle (handler analysis/benchmarks/suite/recursion/iter [ctl it (λ (a resume)
            (std/core/int/+ a (resume a)))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (analysis/benchmarks/suite/recursion/iter 2))))))
  (define analysis/benchmarks/suite/recursion/result-iter-sum-two
    (λ ()
      3))
