  (define analysis/benchmarks/suite/recursion/main
    (λ ()
      (letrec* ([_ (std/core/console/string/println "Running recursion tests...")] [_ (analysis/benchmarks/suite/recursion/test-iter-sum)] [_ (analysis/benchmarks/suite/recursion/test-iter-sum-handler)] [_ (analysis/benchmarks/suite/recursion/test-iter-sum-two)] [_ (analysis/benchmarks/suite/recursion/test-iter-sum-b)] [_ (analysis/benchmarks/suite/recursion/test-iter-sum-two-b)] [_ (analysis/benchmarks/suite/recursion/test-iter-sum-c)] [_ (analysis/benchmarks/suite/recursion/test-iter-sum-two-c)] [_ (analysis/benchmarks/suite/recursion/test-iter-sum-d)] [_ (analysis/benchmarks/suite/recursion/test-iter-sum-two-d)])
        (std/core/console/string/println "recursion tests complete")))))