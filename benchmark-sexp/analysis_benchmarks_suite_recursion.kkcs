            h-res) h-action)) (λ ()
          (analysis/benchmarks/suite/recursion/iterxx 2))))))
  (define analysis/benchmarks/suite/recursion/result-iter-sum-two-d
    (λ ()
      3))
  (define analysis/benchmarks/suite/recursion/test-iter-sum
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/recursion/analyze-iter-sum)])
        (match (std/core/int/== result (analysis/benchmarks/suite/recursion/result-iter-sum))
          [std/core/types/True (std/core/console/string/println "✓ test-iter-sum passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-iter-sum FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/recursion/result-iter-sum)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/recursion/test-iter-sum-handler
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/recursion/analyze-iter-sum-handler)])
        (match (std/core/int/== result (analysis/benchmarks/suite/recursion/result-iter-sum-handler))
          [std/core/types/True (std/core/console/string/println "✓ test-iter-sum-handler passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-iter-sum-handler FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/recursion/result-iter-sum-handler)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/recursion/test-iter-sum-two
