(module
  analysis/benchmarks/suite/nondet
  (define analysis/benchmarks/suite/nondet/ex2/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle analysis/benchmarks/suite/nondet/ex2/h-tag hnd ret action)))
  (define analysis/benchmarks/suite/nondet/ex2/h-ctl-ex2
    (λ (ex2)
      (match ex2
        [(analysis/benchmarks/suite/nondet/h-Hnd-ex2 _ h-x) h-x])))
  (define analysis/benchmarks/suite/nondet/ex2/h-select
    (λ (hnd)
      (match hnd
        [(analysis/benchmarks/suite/nondet/h-Hnd-ex2 _ h-ctl-ex2) h-ctl-ex2])))
  (define analysis/benchmarks/suite/nondet/ex2
    (λ (a)
      (perform analysis/benchmarks/suite/nondet/ex2 ex2 a)))
  (define analysis/benchmarks/suite/nondet/analyze-nondet-simple
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Example 20 - nondeterminism")])
        ((λ (h-action)
          (analysis/benchmarks/suite/nondet/ex2/h-handle (handler analysis/benchmarks/suite/nondet/h-Hnd-ex2 [ctl ex2 (std/core/hnd/clause-control1 (λ (a resume)
            (std/core/int/+ (resume (std/core/types/tuple2/fst a)) (resume (std/core/types/tuple2/snd a)))))]) (λ (x)
            x) h-action)) (λ ()
          (analysis/benchmarks/suite/nondet/ex2 (std/core/types/Tuple2 1 2)))))))
  (define analysis/benchmarks/suite/nondet/result-nondet-simple
    (λ ()
      3))
  (define analysis/benchmarks/suite/nondet/analyze-nondet-context
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Example 21 - nondeterminism")])
        ((λ (h-action)
          (analysis/benchmarks/suite/nondet/ex2/h-handle (handler analysis/benchmarks/suite/nondet/h-Hnd-ex2 [ctl ex2 (std/core/hnd/clause-control1 (λ (a resume)
            (std/core/int/+ (resume (std/core/types/tuple2/fst a)) (resume (std/core/types/tuple2/snd a)))))]) (λ (x)
            x) h-action)) (λ ()
          (std/core/int/+ (analysis/benchmarks/suite/nondet/ex2 (std/core/types/Tuple2 1 2)) 1))))))
  (define analysis/benchmarks/suite/nondet/result-nondet-context
    (λ ()
      5))
  (define analysis/benchmarks/suite/nondet/analyze-nondet-nested
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Example 22 - nondeterminism twice")])
        ((λ (h-action)
          (analysis/benchmarks/suite/nondet/ex2/h-handle (handler analysis/benchmarks/suite/nondet/h-Hnd-ex2 [ctl ex2 (std/core/hnd/clause-control1 (λ (a resume)
            (std/core/int/+ (resume (std/core/types/tuple2/fst a)) (resume (std/core/types/tuple2/snd a)))))]) (λ (x)
            x) h-action)) (λ ()
          (std/core/int/+ (analysis/benchmarks/suite/nondet/ex2 (std/core/types/Tuple2 1 2)) (analysis/benchmarks/suite/nondet/ex2 (std/core/types/Tuple2 1 2))))))))
  (define analysis/benchmarks/suite/nondet/result-nondet-nested
    (λ ()
      12))
  (define analysis/benchmarks/suite/nondet/analyze-nondet-discard
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Example 23 - resumption result discarded")])
        ((λ (h-action)
          (analysis/benchmarks/suite/nondet/ex2/h-handle (handler analysis/benchmarks/suite/nondet/h-Hnd-ex2 [ctl ex2 (std/core/hnd/clause-control1 (λ (a resume)
            (match (resume (std/core/types/tuple2/fst a))
              [_ (resume (std/core/types/tuple2/snd a))])))]) (λ (x)
            x) h-action)) (λ ()
          (analysis/benchmarks/suite/nondet/ex2 (std/core/types/Tuple2 10 20)))))))
  (define analysis/benchmarks/suite/nondet/result-nondet-discard
    (λ ()
      20))
  (define analysis/benchmarks/suite/nondet/test-nondet-simple
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/nondet/analyze-nondet-simple)])
        (match (std/core/int/== result (analysis/benchmarks/suite/nondet/result-nondet-simple))
          [std/core/types/True (std/core/console/string/println "✓ test-nondet-simple passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-nondet-simple FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/nondet/result-nondet-simple)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/nondet/test-nondet-context
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/nondet/analyze-nondet-context)])
        (match (std/core/int/== result (analysis/benchmarks/suite/nondet/result-nondet-context))
          [std/core/types/True (std/core/console/string/println "✓ test-nondet-context passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-nondet-context FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/nondet/result-nondet-context)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/nondet/test-nondet-nested
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/nondet/analyze-nondet-nested)])
        (match (std/core/int/== result (analysis/benchmarks/suite/nondet/result-nondet-nested))
          [std/core/types/True (std/core/console/string/println "✓ test-nondet-nested passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-nondet-nested FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/nondet/result-nondet-nested)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/nondet/test-nondet-discard
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/nondet/analyze-nondet-discard)])
        (match (std/core/int/== result (analysis/benchmarks/suite/nondet/result-nondet-discard))
          [std/core/types/True (std/core/console/string/println "✓ test-nondet-discard passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-nondet-discard FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/nondet/result-nondet-discard)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/nondet/main
    (λ ()
      (letrec* ([_ (std/core/console/string/println "Running nondet tests...")] [_ (analysis/benchmarks/suite/nondet/test-nondet-simple)] [_ (analysis/benchmarks/suite/nondet/test-nondet-context)] [_ (analysis/benchmarks/suite/nondet/test-nondet-nested)] [_ (analysis/benchmarks/suite/nondet/test-nondet-discard)])
        (std/core/console/string/println "nondet tests complete")))))