(module
  handlers/unix
  (define handlers/unix/bio/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/unix/bio/h-tag hnd ret action)))
  (define handlers/unix/bio/h-fun-write
    (λ (bio)
      (match bio
        [(handlers/unix/h-Hnd-bio _ h-x) h-x])))
  (define handlers/unix/write/h-select
    (λ (hnd)
      (match hnd
        [(handlers/unix/h-Hnd-bio _ h-fun-write) h-fun-write])))
  (define handlers/unix/write
    (λ (fd s)
      (perform handlers/unix/bio write fd s)))
  (define handlers/unix/stdout
    0)
  (define handlers/unix/echo
    (λ (s)
      (handlers/unix/write handlers/unix/stdout s)))
  (define handlers/unix/bio
    (λ (action)
      (std/core/types/local-scope (λ ()
        (letrec* ([ievh-671 std/core/types/h-Hnodiv] [ievh-720 std/core/types/h-Hnodiv])
          (std/core/hnd/local-var "" (λ (buf)
            ((λ (h-action)
              (handlers/unix/bio/h-handle (handler handlers/unix/h-Hnd-bio [fun write (std/core/hnd/clause-tail2 (λ (fd s)
                (std/core/types/local-set buf (std/core/types/++ (std/core/types/local-get buf ievh-671) s))))]) (λ (h-res)
                h-res) h-action)) (λ ()
              (std/core/types/Tuple2 ((λ ()
                (std/core/hnd/h-mask-builtin (λ ()
                  (action))))) (std/core/types/local-get buf ievh-720)))))))))))
  (define handlers/unix/bio2
    (λ (action)
      (std/core/types/local-scope (λ ()
        (letrec* ([ievh-804 std/core/types/h-Hnodiv] [ievh-900 std/core/types/h-Hnodiv])
          (std/core/hnd/local-var "" (λ (buf)
            ((λ (h-action)
              ((λ (x)
                (std/core/types/Tuple2 x (std/core/types/local-get buf ievh-804))) (h-action))) (λ ()
              ((λ (h-action)
                (handlers/unix/bio/h-handle (handler handlers/unix/h-Hnd-bio [fun write (std/core/hnd/clause-tail2 (λ (fd s)
                  (std/core/types/local-set buf (std/core/types/++ (std/core/types/local-get buf ievh-900) s))))]) (λ (h-res)
                  h-res) h-action)) (λ ()
                ((λ ()
                  (std/core/hnd/h-mask-builtin (λ ()
                    (action))))))))))))))))
  (define handlers/unix/example1
    (λ ()
      (handlers/unix/bio (λ ()
        (letrec* ([_ (handlers/unix/echo "hi ")])
          (handlers/unix/echo "unix world"))))))
  (define handlers/unix/exit/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/unix/exit/h-tag hnd ret action)))
  (define handlers/unix/exit/h-ctl-exit
    (λ (exit)
      (match exit
        [(handlers/unix/h-Hnd-exit _ h-x) h-x])))
  (define handlers/unix/exit/h-select
    (λ (hnd)
      (match hnd
        [(handlers/unix/h-Hnd-exit _ h-ctl-exit) h-ctl-exit])))
  (define handlers/unix/exit
    (λ (exitcode)
      (perform handlers/unix/exit exit exitcode)))
  (define handlers/unix/status
    (λ (action)
      ((λ (h-action)
        (handlers/unix/exit/h-handle (handler handlers/unix/h-Hnd-exit [ctl exit (std/core/hnd/clause-never1 (λ (code)
          code))]) (λ (h-res)
          h-res) h-action)) (λ ()
        (letrec* ([_ (action)])
          0)))))
  (define handlers/unix/example2
    (λ ()
      (handlers/unix/bio (λ ()
        (handlers/unix/status (λ ()
          (letrec* ([_ (handlers/unix/echo "hi ")] [_ (handlers/unix/exit 1)])
            (handlers/unix/echo "unix world"))))))))
  (define handlers/unix/is-root
    (λ (user)
      (match user
        [handlers/unix/Root std/core/types/True]
        [_ std/core/types/False])))
  (define handlers/unix/is-alice
    (λ (user)
      (match user
        [handlers/unix/Alice std/core/types/True]
        [_ std/core/types/False])))
  (define handlers/unix/is-bob
    (λ (user)
      (match user
        [handlers/unix/Bob std/core/types/True]
        [_ std/core/types/False])))
  (define handlers/unix/user/show
    (λ (user)
      (match user
        [handlers/unix/Root "root"]
        [handlers/unix/Alice "alice"]
        [handlers/unix/Bob "bob"])))
  (define handlers/unix/whoami/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/unix/whoami/h-tag hnd ret action)))
  (define handlers/unix/whoami/h-fun-whoami
    (λ (whoami)
      (match whoami
        [(handlers/unix/h-Hnd-whoami _ h-x) h-x])))
  (define handlers/unix/whoami/h-select
    (λ (hnd)
      (match hnd
        [(handlers/unix/h-Hnd-whoami _ h-fun-whoami) h-fun-whoami])))
  (define handlers/unix/whoami
    (λ ()
      (perform handlers/unix/whoami whoami)))
  (define handlers/unix/intstr/show
    (λ (h-pat-x100_18)
      (match h-pat-x100_18
        [(std/core/types/Tuple2 i s) (std/core/types/++ "exit with status " (std/core/types/++ (std/core/int/show i) (std/core/types/++ "\n" (std/core/show/string/show s))))])))
  (define handlers/unix/env
    (λ (user action)
      ((λ (h-action)
        (handlers/unix/whoami/h-handle (handler handlers/unix/h-Hnd-whoami [fun whoami (std/core/hnd/clause-tail0 (λ ()
          (handlers/unix/user/show user)))]) (λ (h-res)
          h-res) h-action)) (λ ()
        (action)))))
  (define handlers/unix/example3
    (λ ()
      (handlers/unix/bio (λ ()
        (handlers/unix/status (λ ()
          (handlers/unix/env handlers/unix/Alice (λ ()
            (letrec* ([_ (handlers/unix/echo "hi ")])
              (handlers/unix/echo (handlers/unix/whoami)))))))))))
  (define handlers/unix/su/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/unix/su/h-tag hnd ret action)))
  (define handlers/unix/su/h-ctl-su
    (λ (su)
      (match su
        [(handlers/unix/h-Hnd-su _ h-x) h-x])))
  (define handlers/unix/su/h-select
    (λ (hnd)
      (match hnd
        [(handlers/unix/h-Hnd-su _ h-ctl-su) h-ctl-su])))
  (define handlers/unix/su
    (λ (u)
      (perform handlers/unix/su su u)))
  (define handlers/unix/session-manager1
    (λ (initial-user action)
      (handlers/unix/env initial-user (λ ()
        ((λ (h-action)
          (handlers/unix/su/h-handle (handler handlers/unix/h-Hnd-su [ctl su (std/core/hnd/clause-control1 (λ (u resume)
            (std/core/hnd/h-mask-at (std/core/hnd/h-evv-index handlers/unix/whoami/h-tag) std/core/types/False (λ ()
              (handlers/unix/env u (λ ()
                (resume std/core/types/Unit)))))))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (action)))))))
  (define handlers/unix/session-manager2
    (λ (initial-user action)
      ((λ (h-action)
        (handlers/unix/whoami/h-handle (handler handlers/unix/h-Hnd-whoami [fun whoami (std/core/hnd/clause-tail0 (λ ()
          (handlers/unix/user/show initial-user)))]) (λ (h-res)
          h-res) h-action)) (λ ()
        ((λ (h-action)
          (handlers/unix/su/h-handle (handler handlers/unix/h-Hnd-su [ctl su (std/core/hnd/clause-control1 (λ (u resume)
            ((λ (h-override-action)
              ((λ (h-action)
                (handlers/unix/whoami/h-handle (handler handlers/unix/h-Hnd-whoami [fun whoami (std/core/hnd/clause-tail0 (λ ()
                  (handlers/unix/user/show u)))]) (λ (h-res)
                  h-res) h-action)) (λ ()
                (std/core/hnd/h-mask-at (std/core/hnd/h-evv-index handlers/unix/whoami/h-tag) std/core/types/True h-override-action)))) (λ ()
              (resume std/core/types/Unit)))))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (action)))))))
  (define handlers/unix/session-manager3
    (λ (initial-user action)
      (std/core/types/local-scope (λ ()
        (letrec* ([ievh-2684 std/core/types/h-Hnodiv])
          (std/core/hnd/local-var initial-user (λ (user)
            ((λ (h-action)
              (handlers/unix/whoami/h-handle (handler handlers/unix/h-Hnd-whoami [fun whoami (std/core/hnd/clause-tail0 (λ ()
                (handlers/unix/user/show (std/core/types/local-get user ievh-2684))))]) (λ (h-res)
                h-res) h-action)) (λ ()
              ((λ (h-action)
                (handlers/unix/su/h-handle (handler handlers/unix/h-Hnd-su [ctl su (std/core/hnd/clause-tail1 (λ (u)
                  (std/core/types/local-set user u)))]) (λ (h-res)
                  h-res) h-action)) (λ ()
                ((λ ()
                  (std/core/hnd/h-mask-builtin (λ ()
                    (action))))))))))))))))
  (define handlers/unix/example4
    (λ ()
      (handlers/unix/bio (λ ()
        (handlers/unix/status (λ ()
          (handlers/unix/session-manager3 handlers/unix/Root (λ ()
            (letrec* ([_ (handlers/unix/echo "hi ")] [_ (handlers/unix/echo (handlers/unix/whoami))] [_ (handlers/unix/su handlers/unix/Alice)] [_ (handlers/unix/echo ", and hi ")])
              (handlers/unix/echo (handlers/unix/whoami)))))))))))
  (define handlers/unix/fork/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/unix/fork/h-tag hnd ret action)))
  (define handlers/unix/fork/h-ctl-fork
    (λ (fork)
      (match fork
        [(handlers/unix/h-Hnd-fork _ h-x) h-x])))
  (define handlers/unix/fork/h-select
    (λ (hnd)
      (match hnd
        [(handlers/unix/h-Hnd-fork _ h-ctl-fork) h-ctl-fork])))
  (define handlers/unix/fork
    (λ ()
      (perform handlers/unix/fork fork)))
  (define handlers/unix/forking
    (λ (action)
      ((λ (h-action)
        (handlers/unix/fork/h-handle (handler handlers/unix/h-Hnd-fork [ctl fork (std/core/hnd/clause-control0 (λ (resume)
          (std/core/list/++ (resume std/core/types/True) (resume std/core/types/False))))]) (λ (x)
          (std/core/types/Cons x std/core/types/Nil)) h-action)) (λ ()
        (action)))))
  (define handlers/unix/is-done
    (λ (pstate)
      (match pstate
        [(handlers/unix/Done _) std/core/types/True]
        [_ std/core/types/False])))
  (define handlers/unix/is-paused
    (λ (pstate)
      (match pstate
        [(handlers/unix/Paused _) std/core/types/True]
        [_ std/core/types/False])))
  (define handlers/unix/interrupt/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/unix/interrupt/h-tag hnd ret action)))
  (define handlers/unix/interrupt/h-ctl-interrupt
    (λ (interrupt)
      (match interrupt
        [(handlers/unix/h-Hnd-interrupt _ h-x) h-x])))
  (define handlers/unix/interrupt/h-select
    (λ (hnd)
      (match hnd
        [(handlers/unix/h-Hnd-interrupt _ h-ctl-interrupt) h-ctl-interrupt])))
  (define handlers/unix/interrupt
    (λ ()
      (perform handlers/unix/interrupt interrupt)))
  (define handlers/unix/reify-process
    (λ (action)
      ((λ (h-action)
        (handlers/unix/interrupt/h-handle (handler handlers/unix/h-Hnd-interrupt [ctl interrupt (std/core/hnd/clause-control-raw0 (λ (rcontext)
          (handlers/unix/Paused (λ ()
            (std/core/hnd/resume rcontext std/core/types/Unit)))))]) (λ (h-res)
          h-res) h-action)) (λ ()
        (handlers/unix/Done (action))))))
  (define handlers/unix/scheduler
    (λ (pstates)
      (letrec* ([schedule (λ (todos dones)
        (match todos
          [std/core/types/Nil dones]
          [(std/core/types/Cons (handlers/unix/Done x) pp) (schedule pp (std/core/types/Cons x dones))]
          [(std/core/types/Cons (handlers/unix/Paused p) pp) (letrec* ([ps (handlers/unix/forking p)])
            (schedule (std/core/list/++ pp ps) dones))]))])
        (schedule pstates std/core/types/Nil))))
  (define handlers/unix/timeshare
    (λ (action)
      (letrec* ([p (handlers/unix/Paused (λ ()
        (handlers/unix/reify-process action)))])
        (handlers/unix/scheduler (std/core/types/Cons p std/core/types/Nil)))))
  (define handlers/unix/ritchie
    (λ ()
      (letrec* ([_ (handlers/unix/echo "UNIX is basically ")] [_ (handlers/unix/echo "a simple operating system, ")] [_ (handlers/unix/echo "but ")])
        (handlers/unix/echo "you have to be a genius to understand the simplicity.\n"))))
  (define handlers/unix/hamlet
    (λ ()
      (letrec* ([_ (handlers/unix/echo "To be, or not to be, ")] [_ (handlers/unix/echo "that is the question:\n")])
        (handlers/unix/echo "Whether 'tis nobler in the mind to suffer\n"))))
  (define handlers/unix/example5
    (λ ()
      ((λ (h-action)
        ((λ (x)
          (std/core/console/string/println (std/core/types/tuple2/snd x))) (h-action))) (λ ()
        (handlers/unix/bio (λ ()
          (handlers/unix/timeshare (λ ()
            (handlers/unix/status (λ ()
              (handlers/unix/session-manager3 handlers/unix/Root (λ ()
                (match (handlers/unix/fork)
                  [std/core/types/True (letrec* ([_ (handlers/unix/su handlers/unix/Alice)])
                    (handlers/unix/ritchie))]
                  [std/core/types/False (letrec* ([_ (handlers/unix/su handlers/unix/Bob)])
                    (handlers/unix/hamlet))])))))))))))))
  (define handlers/unix/interrupt-write
    (λ (action)
      ((λ (h-override-action)
        ((λ (h-action)
          (handlers/unix/bio/h-handle (handler handlers/unix/h-Hnd-bio [fun write (std/core/hnd/clause-tail2 (λ (fd s)
            (letrec* ([_ (handlers/unix/interrupt)])
              (handlers/unix/write fd s))))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (std/core/hnd/h-mask-at (std/core/hnd/h-evv-index handlers/unix/bio/h-tag) std/core/types/True h-override-action)))) (λ ()
        (action)))))
  (define handlers/unix/example6
    (λ ()
      ((λ (h-action)
        ((λ (x)
          (std/core/console/string/println (std/core/types/tuple2/snd x))) (h-action))) (λ ()
        (handlers/unix/bio (λ ()
          (handlers/unix/timeshare (λ ()
            (handlers/unix/interrupt-write (λ ()
              (handlers/unix/status (λ ()
                (handlers/unix/session-manager3 handlers/unix/Root (λ ()
                  (match (handlers/unix/fork)
                    [std/core/types/True (letrec* ([_ (handlers/unix/su handlers/unix/Alice)])
                      (handlers/unix/ritchie))]
                    [std/core/types/False (letrec* ([_ (handlers/unix/su handlers/unix/Bob)])
                      (handlers/unix/hamlet))])))))))))))))))
  (define handlers/unix/main
    (λ ()
      (handlers/unix/example5))))