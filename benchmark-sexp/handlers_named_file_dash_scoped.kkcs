(module
  handlers/named/file-scoped
  (define handlers/named/file-scoped/file/h-tag
    "file@file-scoped")
  (define handlers/named/file-scoped/file/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-named-handle handlers/named/file-scoped/file/h-tag hnd ret action)))
  (define handlers/named/file-scoped/file/h-fun-read-line
    (λ (file)
      (match file
        [(handlers/named/file-scoped/file _ h-x) h-x])))
  (define handlers/named/file-scoped/read-line/h-select
    (λ (hnd)
      (match hnd
        [(handlers/named/file-scoped/file _ h-fun-read-line) h-fun-read-line])))
  (define handlers/named/file-scoped/read-line
    (λ (h-hname)
      (perform handlers/named/file-scoped/file read-line)))
  (define handlers/named/file-scoped/file
    (λ (fname action)
      (std/core/types/local-scope (λ ()
        (letrec* ([ievh-440 std/core/types/h-Hnodiv] [ievh-502 std/core/types/h-Hnodiv])
          (std/core/hnd/local-var 0 (λ (i)
            ((λ (h-action)
              (handlers/named/file-scoped/file/h-handle (handler handlers/named/file-scoped/file [fun read-line (λ ()
                (letrec* ([_ (std/core/types/local-set i (std/core/int/+ (std/core/types/local-get i ievh-440) 1))])
                  (std/core/types/++ fname (std/core/types/++ ": line " (std/core/int/show (std/core/types/local-get i ievh-502))))))]) (λ (h-res)
                h-res) h-action)) (λ (f)
              ((λ (h-arg-x1)
                (λ ()
                  (action h-arg-x1))) f))))))))))
  (define handlers/named/file-scoped/read-both
    (λ (f1 f2)
      (std/core/console/string/println (std/core/types/++ (handlers/named/file-scoped/read-line f1) (std/core/types/++ "\n" (handlers/named/file-scoped/read-line f2))))))
  (define handlers/named/file-scoped/main
    (λ ()
      (handlers/named/file-scoped/file "package.yaml" (λ (f1)
        (handlers/named/file-scoped/file "stack.yaml" (λ (f2)
          (handlers/named/file-scoped/read-both f1 f2))))))))