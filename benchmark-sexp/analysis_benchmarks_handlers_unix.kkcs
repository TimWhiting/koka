  (define analysis/benchmarks/handlers/unix/reify-process
    (λ (action)
      ((λ (h-action)
        (analysis/benchmarks/handlers/unix/interrupt/h-handle (handler analysis/benchmarks/handlers/unix/interrupt [ctl interrupt (λ (rcontext)
          (analysis/benchmarks/handlers/unix/Paused (λ ()
            (std/core/hnd/resume rcontext std/core/types/Unit))))]) (λ (h-res)
          h-res) h-action)) (λ ()
        (analysis/benchmarks/handlers/unix/Done (action))))))
  (define analysis/benchmarks/handlers/unix/scheduler
    (λ (pstates)
      (letrec* ([schedule (λ (todos dones)
        (match todos
          [std/core/types/Nil dones]
          [(std/core/types/Cons (analysis/benchmarks/handlers/unix/Done x) pp) (schedule pp (std/core/types/Cons x dones))]
          [(std/core/types/Cons (analysis/benchmarks/handlers/unix/Paused p) pp) (letrec* ([ps (analysis/benchmarks/handlers/unix/forking p)])
            (schedule (std/core/list/++ pp ps) dones))]))])
        (schedule pstates std/core/types/Nil))))
  (define analysis/benchmarks/handlers/unix/timeshare
    (λ (action)
      (letrec* ([p (analysis/benchmarks/handlers/unix/Paused (λ ()
        (analysis/benchmarks/handlers/unix/reify-process action)))])
        (analysis/benchmarks/handlers/unix/scheduler (std/core/types/Cons p std/core/types/Nil)))))
  (define analysis/benchmarks/handlers/unix/ritchie
    (λ ()
      (letrec* ([_ (analysis/benchmarks/handlers/unix/echo "UNIX is basically ")] [_ (analysis/benchmarks/handlers/unix/echo "a simple operating system, ")] [_ (analysis/benchmarks/handlers/unix/echo "but ")])
        (analysis/benchmarks/handlers/unix/echo "you have to be a genius to understand the simplicity.\n"))))
  (define analysis/benchmarks/handlers/unix/hamlet
    (λ ()
      (letrec* ([_ (analysis/benchmarks/handlers/unix/echo "To be, or not to be, ")] [_ (analysis/benchmarks/handlers/unix/echo "that is the question:\n")])
        (analysis/benchmarks/handlers/unix/echo "Whether 'tis nobler in the mind to suffer\n"))))
  (define analysis/benchmarks/handlers/unix/analyze-example5
    (λ ()
      ((λ (h-action)
        ((λ (x)
          (std/core/types/tuple2/snd x)) (h-action))) (λ ()
        (analysis/benchmarks/handlers/unix/bio (λ ()
          (analysis/benchmarks/handlers/unix/timeshare (λ ()
            (analysis/benchmarks/handlers/unix/status (λ ()
              (analysis/benchmarks/handlers/unix/session-manager3 analysis/benchmarks/handlers/unix/Root (λ ()
                (match (analysis/benchmarks/handlers/unix/fork)
                  [std/core/types/True (letrec* ([_ (analysis/benchmarks/handlers/unix/su analysis/benchmarks/handlers/unix/Alice)])
                    (analysis/benchmarks/handlers/unix/ritchie))]
                  [std/core/types/False (letrec* ([_ (analysis/benchmarks/handlers/unix/su analysis/benchmarks/handlers/unix/Bob)])
                    (analysis/benchmarks/handlers/unix/hamlet))])))))))))))))
  (define analysis/benchmarks/handlers/unix/example5
