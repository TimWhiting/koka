  (define analysis/benchmarks/handlers/unix/forking
    (λ (action)
      ((λ (h-action)
        (analysis/benchmarks/handlers/unix/fork/h-handle (handler analysis/benchmarks/handlers/unix/fork [ctl fork (λ (resume)
          (std/core/list/++ (resume std/core/types/True) (resume std/core/types/False)))]) (λ (x)
          (std/core/types/Cons x std/core/types/Nil)) h-action)) (λ ()
        (action)))))
  (define analysis/benchmarks/handlers/unix/is-done
    (λ (pstate)
