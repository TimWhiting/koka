      "UNIX is basically a simple operating system, but you have to be a genius to understand the simplicity.\nTo be, or not to be, that is the question:\nWhether 'tis nobler in the mind to suffer\n"))
  (define analysis/benchmarks/handlers/unix/interrupt-write
    (λ (action)
      ((λ (h-override-action)
        ((λ (h-action)
          (analysis/benchmarks/handlers/unix/bio/h-handle (handler analysis/benchmarks/handlers/unix/bio [fun write (λ (fd s)
            (letrec* ([_ (analysis/benchmarks/handlers/unix/interrupt)])
              (analysis/benchmarks/handlers/unix/write fd s)))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (std/core/hnd/h-mask-at (std/core/hnd/h-evv-index analysis/benchmarks/handlers/unix/bio/h-tag) std/core/types/True h-override-action)))) (λ ()
        (action))))))