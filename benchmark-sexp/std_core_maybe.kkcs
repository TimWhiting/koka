(module
  std/core/maybe
  (define std/core/maybe/maybe
    (λ (m onNothing onJust)
      (match m
        [std/core/types/Nothing onNothing]
        [(std/core/types/Just x) (onJust x)])))
  (define std/core/maybe/default
    (λ (m nothing)
      (match m
        [std/core/types/Nothing nothing]
        [(std/core/types/Just x) x])))
  (define std/core/maybe/unjust
    (λ (m h-implicit/kk-file-line)
      (match m
        [(std/core/types/Just x) x]
        [std/core/types/Nothing (std/core/exn/throw (std/core/types/++ "unexpected Nothing in " h-implicit/kk-file-line) std/core/types/h-None)])))
  (define std/core/maybe/expect
    (λ (m error-msg)
      (match m
        [(std/core/types/Just x) x]
        [std/core/types/Nothing (std/core/exn/throw error-msg std/core/types/h-None)])))
  (define std/core/maybe/map
    (λ (m f)
      (match m
        [std/core/types/Nothing std/core/types/Nothing]
        [(std/core/types/Just x) (std/core/types/Just (f x))])))
  (define |std/core/maybe/|||
    (λ (m1 m2)
      (match m1
        [std/core/types/Nothing m2]
        [_ m1])))
  (define std/core/maybe/==
    (λ (mb1 mb2 h-implicit/==)
      (match mb1
        [(std/core/types/Just x) (match mb2
          [(std/core/types/Just y) (h-implicit/== x y)]
          [std/core/types/Nothing std/core/types/False])]
        [std/core/types/Nothing (match mb2
          [std/core/types/Nothing std/core/types/True]
          [_ std/core/types/False])])))
  (define std/core/maybe/cmp
    (λ (mb1 mb2 h-implicit/cmp)
      (match mb1
        [(std/core/types/Just x) (match mb2
          [(std/core/types/Just y) (h-implicit/cmp x y)]
          [std/core/types/Nothing std/core/types/Gt])]
        [std/core/types/Nothing (match mb2
          [std/core/types/Nothing std/core/types/Eq]
          [_ std/core/types/Lt])])))
  (define std/core/maybe/order2
    (λ (mb1 mb2 h-implicit/order2)
      (match mb1
        [(std/core/types/Just x) (match mb2
          [(std/core/types/Just y) (match (h-implicit/order2 x y)
            [(std/core/types/Eq2 z) (std/core/types/Eq2 (std/core/types/Just z))]
            [(std/core/types/Lt2 l g) (std/core/types/Lt2 (std/core/types/Just l) (std/core/types/Just g))]
            [(std/core/types/Gt2 l g) (std/core/types/Gt2 (std/core/types/Just l) (std/core/types/Just g))])]
          [std/core/types/Nothing (std/core/types/Gt2 std/core/types/Nothing (std/core/types/Just x))])]
        [std/core/types/Nothing (std/core/types/Lt2 std/core/types/Nothing mb2)])))
  (define std/core/maybe/show
    (λ (mb h-implicit/show)
      (match mb
        [(std/core/types/Just x) (std/core/types/++ "Just(" (std/core/types/++ (h-implicit/show x) ")"))]
        [std/core/types/Nothing "Nothing"])))
  (define std/core/maybe/bool
    (λ (mb)
      (match mb
        [(std/core/types/Just _) std/core/types/True]
        [std/core/types/Nothing std/core/types/False]))))