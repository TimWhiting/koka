    (λ (h-this front flen rear rlen)
      (letrec* ([h-uniq-fronth-1874 (match front
        [(std/core/types/h-Optional h-uniq-fronth-1875) h-uniq-fronth-1875]
        [std/core/types/h-None (learn/lazycons/bqueue/front h-this)])] [h-uniq-flenh-1885 (match flen
