        [(learn/lazycons/Bqueue front flen rear rlen) (std/core/types/++ "Bqueue(" (std/core/types/++ (learn/lazycons/debug-show front h-implicit/show) (std/core/types/++ ", flen=" (std/core/types/++ (std/core/int/show flen) (std/core/types/++ ", " (std/core/types/++ (learn/lazycons/debug-show rear h-implicit/show) (std/core/types/++ ", rlen=" (std/core/types/++ (std/core/int/show rlen) ")"))))))))])))
  (define learn/lazycons/bqueue/front
