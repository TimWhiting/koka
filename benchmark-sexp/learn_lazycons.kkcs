          [(learn/lazycons/Cons1 x xx) (std/core/lazy/memoize h-lazy (learn/lazycons/Cons1 x (learn/lazycons/Append1 xx ys)))]))))
  (define learn/lazycons/stream1/lazy-eval-locked
    (λ (h-lazy h-recurse)
      (match h-lazy
        [(learn/lazycons/Append1 xs ys) (learn/lazycons/stream1/lazy-Append1 h-lazy h-recurse xs ys)]
        [(learn/lazycons/stream1/Indirect h-indirect) (std/core/lazy/indirect-compress h-indirect learn/lazycons/stream1/lazy-tag)]
        [_ h-lazy])))
  (define learn/lazycons/stream1/lazy-eval
    (λ (h-lazy h-recurse)
      (match (match (std/core/lazy/datatype-ptr-is-unique h-lazy)
        [std/core/types/True std/core/types/True]
        [_ (std/core/types/not (std/core/lazy/atomic-enter h-lazy learn/lazycons/stream1/lazy-tag))])
        [std/core/types/True (learn/lazycons/stream1/lazy-eval-locked h-lazy h-recurse)]
        [std/core/types/False (letrec* ([v (learn/lazycons/stream1/lazy-eval-locked h-lazy h-recurse)] [|| (std/core/lazy/atomic-leave h-lazy)])
          v)])))
  (define learn/lazycons/stream1/lazy-whnf
    (λ (h-lazy)
