        [std/core/types/h-None (learn/lazycons/bqueue/rear h-this)])] [h-uniq-rlenh-1907 (match rlen
        [(std/core/types/h-Optional h-uniq-rlenh-1908) h-uniq-rlenh-1908]
        [std/core/types/h-None (learn/lazycons/bqueue/rlen h-this)])])
        (learn/lazycons/Bqueue h-uniq-fronth-1874 h-uniq-flenh-1885 h-uniq-rearh-1896 h-uniq-rlenh-1907))))
  (define learn/lazycons/bempty
