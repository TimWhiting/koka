        [std/core/types/False (learn/lazycons/stream1/lazy-eval h-lazy std/core/types/False)])))
  (define learn/lazycons/xs
    (learn/lazycons/Append1 (learn/lazycons/Cons1 1 (learn/lazycons/Cons1 2 learn/lazycons/Nil1)) (learn/lazycons/Cons1 3 learn/lazycons/Nil1)))
  (define learn/lazycons/head1
    (λ (xs)
      (match (learn/lazycons/stream1/lazy-force xs)
        [learn/lazycons/Nil1 std/core/types/Nothing]
        [(learn/lazycons/Cons1 x _) (std/core/types/Just x)])))
  (define learn/lazycons/stream/lazy-tag
    (std/core/types/h-make-int32 3))
  (define learn/lazycons/stream/lazy-eval
    (λ (h-lazy h-recurse)
      (match (match (std/core/lazy/datatype-ptr-is-unique h-lazy)
