          v)])))
  (define learn/lazycons/stream/lazy-step
    (λ (h-lazy)
      (match (std/core/lazy/datatype-is-whnf h-lazy learn/lazycons/stream/lazy-tag)
        [std/core/types/True h-lazy]
        [std/core/types/False (learn/lazycons/stream/lazy-eval h-lazy std/core/types/False)])))
  (define learn/lazycons/stream/lazy-SAppend
    (λ (h-lazy h-recurse xs ys)
      (letrec* ([|| (std/core/lazy/memoize-target h-lazy 16 2)] [_ (learn/lazycons/stream/lazy-step ys)])
        (match (learn/lazycons/stream/lazy-force (learn/lazycons/stream/lazy-force xs))
          [learn/lazycons/SNil (std/core/lazy/memoize h-lazy ys)]
          [(learn/lazycons/SCons x xx) (std/core/lazy/memoize h-lazy (learn/lazycons/SCons x (learn/lazycons/SAppend xx ys)))]))))
  (define learn/lazycons/stream/lazy-eval-locked
    (λ (h-lazy h-recurse)
      (match h-lazy
        [(learn/lazycons/SAppend xs ys) (learn/lazycons/stream/lazy-SAppend h-lazy h-recurse xs ys)]
        [(learn/lazycons/SReverse xs acc) (learn/lazycons/stream/lazy-SReverse h-lazy h-recurse xs acc)]
        [(learn/lazycons/stream/Indirect h-indirect) (std/core/lazy/indirect-compress h-indirect learn/lazycons/stream/lazy-tag)]
