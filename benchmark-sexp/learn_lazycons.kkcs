        [(learn/lazycons/SReverse xs acc) (std/core/types/++ "SReverse(" (std/core/types/++ (learn/lazycons/debug-show xs h-implicit/show) (std/core/types/++ ", " (std/core/types/++ (learn/lazycons/debug-show acc h-implicit/show) ")"))))]
        [_ (std/core/exn/error-pattern "learn/lazycons(76, 8)" "debug-show")])))
