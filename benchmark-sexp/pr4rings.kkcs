((module pr4rings)
  (defs
    (def pr4rings/is_unique
      (fn (a b c d e f g)
        (match (std/core/int/!= (a b))
          [std/core/types/True (match (std/core/int/!= (a c))
            [std/core/types/True (match (std/core/int/!= (a d))
              [std/core/types/True (match (std/core/int/!= (a e))
                [std/core/types/True (match (std/core/int/!= (a f))
                  [std/core/types/True (match (std/core/int/!= (a g))
                    [std/core/types/True (match (std/core/int/!= (b c))
                      [std/core/types/True (match (std/core/int/!= (b d))
                        [std/core/types/True (match (std/core/int/!= (b e))
                          [std/core/types/True (match (std/core/int/!= (b f))
                            [std/core/types/True (match (std/core/int/!= (b g))
                              [std/core/types/True (match (std/core/int/!= (c d))
                                [std/core/types/True (match (std/core/int/!= (c e))
                                  [std/core/types/True (match (std/core/int/!= (c f))
                                    [std/core/types/True (match (std/core/int/!= (c g))
                                      [std/core/types/True (match (std/core/int/!= (d e))
                                        [std/core/types/True (match (std/core/int/!= (d f))
                                          [std/core/types/True (match (std/core/int/!= (d g))
                                            [std/core/types/True (match (std/core/int/!= (e f))
                                              [std/core/types/True (match (std/core/int/!= (e g))
                                                [std/core/types/True (std/core/int/!= (f g))]
                                                [_ std/core/types/False])]
                                              [_ std/core/types/False])]
                                            [_ std/core/types/False])]
                                          [_ std/core/types/False])]
                                        [_ std/core/types/False])]
                                      [_ std/core/types/False])]
                                    [_ std/core/types/False])]
                                  [_ std/core/types/False])]
                                [_ std/core/types/False])]
                              [_ std/core/types/False])]
                            [_ std/core/types/False])]
                          [_ std/core/types/False])]
                        [_ std/core/types/False])]
                      [_ std/core/types/False])]
                    [_ std/core/types/False])]
                  [_ std/core/types/False])]
                [_ std/core/types/False])]
              [_ std/core/types/False])]
            [_ std/core/types/False])]
          [_ std/core/types/False])))
    (def pr4rings/is_solution
      (fn (a b c d e f g)
        (letrec* ([bcd (std/core/int/+ ((std/core/int/+ (b c)) d))] [ab (std/core/int/+ (a b))])
          (match (std/core/int/!= (ab bcd))
            [std/core/types/True std/core/types/False]
            [std/core/types/False (letrec* ([def (std/core/int/+ ((std/core/int/+ (d e)) f))])
              (match (std/core/int/!= (bcd def))
                [std/core/types/True std/core/types/False]
                [std/core/types/False (letrec* ([fg (std/core/int/+ (f g))])
                  (std/core/int/== (def fg)))]))]))))
    (def pr4rings/four_squares
      (fn (low high unique)
        (letrec* ([h-uniq-uniqueh-1872 (match unique
          [(std/core/types/h-Optional h-uniq-uniqueh-1873) h-uniq-uniqueh-1873]
          [std/core/types/h-None std/core/types/True])])
          (std/core/types/local-scope ((fn ()
            (letrec* ([ievh-1969 std/core/types/h-Hnodiv] [ievh-2020 std/core/types/h-Hnodiv] [ievh-2090 std/core/types/h-Hnodiv])
              (std/core/hnd/local-var (0 (fn (count)
                (letrec* ([_ (std/core/range/for (low high (fn (a)
                  (std/core/range/for (low high (fn (b)
                    (std/core/range/for (low high (fn (c)
                      (std/core/range/for (low high (fn (d)
                        (std/core/range/for (low high (fn (e)
                          (std/core/range/for (low high (fn (f)
                            (std/core/range/for (low high (fn (g)
                              (match (match (match (std/core/types/bool/! (h-uniq-uniqueh-1872))
                                [std/core/types/True std/core/types/True]
                                [_ (pr4rings/is_unique (a b c d e f g))])
                                [std/core/types/True (pr4rings/is_solution (a b c d e f g))]
                                [_ std/core/types/False])
                                [std/core/types/True (letrec* ([_ (std/core/types/local-set (count (std/core/int/+ ((std/core/types/local-get (count ievh-2020)) 1))))])
                                  (match h-uniq-uniqueh-1872
                                    [std/core/types/True std/core/types/Unit]
                                    [std/core/types/False std/core/types/Unit]))]
                                [std/core/types/False std/core/types/Unit]))))))))))))))))))))))] [uniquestr (match h-uniq-uniqueh-1872
                  [std/core/types/True "unique"]
                  [std/core/types/False "non-unique"])])
                  (std/core/types/++ ((std/core/int/show ((std/core/types/local-get (count ievh-2090)))) (std/core/types/++ (" " (std/core/types/++ (uniquestr (std/core/types/++ (" solutions in " (std/core/types/++ ((std/core/int/show (low)) (std/core/types/++ (" to " (std/core/types/++ ((std/core/int/show (high)) " range\n")))))))))))))))))))))))))
    (def pr4rings/analyze-four-squares
      (fn ()
        (pr4rings/four_squares (3 9 std/core/types/h-None))))
    (def pr4rings/result-four-squares
      (fn ()
        "4 unique solutions in 3 to 9 range\n"))
    (def pr4rings/main
      (fn ()
        (letrec* ([_ (std/core/console/string/println ((pr4rings/four_squares (1 7 std/core/types/h-None))))] [_ (std/core/console/string/println ((pr4rings/four_squares (3 9 std/core/types/h-None))))])
          (std/core/console/string/println ((pr4rings/four_squares (0 9 (std/core/types/h-Optional (std/core/types/False)))))))))))