(module
  handlers/yield
  (define handlers/yield/yield/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/yield/yield/h-tag hnd ret action)))
  (define handlers/yield/yield/h-fun-yield
    (λ (yield)
      (match yield
        [(handlers/yield/h-Hnd-yield _ h-x) h-x])))
  (define handlers/yield/yield/h-select
    (λ (hnd)
      (match hnd
        [(handlers/yield/h-Hnd-yield _ h-fun-yield) h-fun-yield])))
  (define handlers/yield/yield
    (λ (x)
      (perform handlers/yield/yield yield x)))
  (define handlers/yield/traverse
    (λ (xs)
      (match xs
        [(std/core/types/Cons x xx) (letrec* ([_ (handlers/yield/yield x)])
          (handlers/yield/traverse xx))]
        [std/core/types/Nil std/core/types/Unit])))
  (define handlers/yield/main
    (λ ()
      ((λ (h-action)
        (handlers/yield/yield/h-handle (handler handlers/yield/h-Hnd-yield [fun yield (std/core/hnd/clause-tail1 (λ (i)
          (std/core/console/string/println (std/core/types/++ "yielded " (std/core/int/show i)))))]) (λ (h-res)
          h-res) h-action)) (λ ()
        (letrec* ([_ (handlers/yield/traverse (std/core/types/Cons 1 (std/core/types/Cons 2 (std/core/types/Cons 3 std/core/types/Nil))))])
          (std/core/console/string/println "done")))))))