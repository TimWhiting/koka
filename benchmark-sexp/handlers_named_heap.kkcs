(module
  handlers/named/heap
  (define handlers/named/heap/heap/h-tag
    "heap@heap")
  (define handlers/named/heap/heap/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/named/heap/heap/h-tag hnd ret action)))
  (define handlers/named/heap/heap/h-ctl-new-ref
    (λ (heap)
      (match heap
        [(handlers/named/heap/heap _ h-x) h-x])))
  (define handlers/named/heap/new-ref/h-select
    (λ (hnd)
      (match hnd
        [(handlers/named/heap/heap _ h-ctl-new-ref) h-ctl-new-ref])))
  (define handlers/named/heap/new-ref
    (λ (init)
      (perform handlers/named/heap/heap new-ref init)))
  (define handlers/named/heap/ref/h-tag
    "ref@heap")
  (define handlers/named/heap/ref/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-named-handle handlers/named/heap/ref/h-tag hnd ret action)))
  (define handlers/named/heap/ref/h-fun-get
    (λ (ref)
      (match ref
        [(handlers/named/heap/ref _ h-x _) h-x])))
  (define handlers/named/heap/get/h-select
    (λ (hnd)
      (match hnd
        [(handlers/named/heap/ref _ h-fun-get _) h-fun-get])))
  (define handlers/named/heap/get
    (λ (h-hname)
      (perform handlers/named/heap/ref get)))
  (define handlers/named/heap/ref/h-fun-set
    (λ (ref)
      (match ref
        [(handlers/named/heap/ref _ _ h-x) h-x])))
  (define handlers/named/heap/set/h-select
    (λ (hnd)
      (match hnd
        [(handlers/named/heap/ref _ _ h-fun-set) h-fun-set])))
  (define handlers/named/heap/set
    (λ (h-hname value)
      (perform handlers/named/heap/ref set value)))
  (define handlers/named/heap/with-ref
    (λ (init action)
      (std/core/types/local-scope (λ ()
        (letrec* ([ievh-1048 std/core/types/h-Hnodiv])
          (std/core/hnd/local-var init (λ (s)
            ((λ (h-action)
              (handlers/named/heap/ref/h-handle (handler handlers/named/heap/ref [fun get (λ ()
                (std/core/types/local-get s ievh-1048))] [fun set (λ (x)
                (std/core/types/local-set s x))]) (λ (h-res)
                h-res) h-action)) (λ (r)
              ((λ (h-arg-x1)
                (λ ()
                  (action h-arg-x1))) r))))))))))
  (define handlers/named/heap/heap
    (λ (action)
      ((λ (h-action)
        (handlers/named/heap/heap/h-handle (handler handlers/named/heap/heap [ctl new-ref (std/core/hnd/clause-control1 (λ (init resume)
          (handlers/named/heap/with-ref init resume)))]) (λ (h-res)
          h-res) h-action)) (λ ()
        (action)))))
  (define handlers/named/heap/dynamic-ref
    (λ (init)
      (letrec* ([x (handlers/named/heap/new-ref init)])
        x)))
  (define handlers/named/heap/main
    (λ ()
      (handlers/named/heap/heap (λ ()
        (letrec* ([r1 (handlers/named/heap/new-ref 41)] [r2 (handlers/named/heap/dynamic-ref std/core/types/True)])
          (std/core/console/default/show/println (std/core/int/+ (handlers/named/heap/get r1) (match (handlers/named/heap/get r2)
            [std/core/types/True 1]
            [std/core/types/False 0])) std/core/int/show)))))))