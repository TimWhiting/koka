(module
  std/core/delayed
  (define std/core/delayed/is-xcomputation
    (λ (computation)
      (match computation
        [(std/core/delayed/XComputation _) std/core/types/True]
        [_ std/core/types/False])))
  (define std/core/delayed/is-xdone
    (λ (computation)
      (match computation
        [(std/core/delayed/XDone _) std/core/types/True]
        [_ std/core/types/False])))
  (define std/core/delayed/is-xblocking
    (λ (computation)
      (match computation
        [std/core/delayed/XBlocking std/core/types/True]
        [_ std/core/types/False])))
  (define std/core/delayed/delayed/dref
    (λ (delayed)
      (match delayed
        [(std/core/delayed/XDelay h-x) h-x])))
  (define std/core/delayed/delayed/h-copy
    (λ (h-this dref)
      (letrec* ([h-uniq-drefh-231 (match dref
        [(std/core/types/h-Optional h-uniq-drefh-232) h-uniq-drefh-232]
        [std/core/types/h-None (std/core/delayed/delayed/dref h-this)])])
        (std/core/delayed/XDelay h-uniq-drefh-231))))
  (define std/core/delayed/delay
    (λ (action)
      (std/core/unsafe/unsafe-total (λ ()
        (letrec* ([r (std/core/types/ref (std/core/delayed/XComputation action))])
          (std/core/delayed/XDelay r))))))
  (define std/core/delayed/memo
    (λ (value)
      (std/core/unsafe/unsafe-total (λ ()
        (letrec* ([r (std/core/types/ref (std/core/delayed/XDone value))])
          (std/core/delayed/XDelay r))))))
  (define std/core/delayed/force/go
    (λ (delayed)
      (letrec* ([ievh-407 std/core/types/h-Hdiv] [ievh-412 std/core/types/h-Hdiv] [r (std/core/delayed/delayed/dref delayed)])
        (match (std/core/types/ref/! r ievh-412)
          [(std/core/delayed/XDone x) x]
          [std/core/delayed/XBlocking (std/core/delayed/force/go delayed)]
          [(std/core/delayed/XComputation action) (letrec* ([_ (std/core/types/set r std/core/delayed/XBlocking)] [x ((std/core/types/mask-st (λ ()
            (std/core/hnd/h-mask-builtin action))))] [_ (std/core/types/set r (std/core/delayed/XDone x))])
            x)]))))
  (define std/core/delayed/unsafe-no-state-div-cast
    (λ (f)
      (std/core/delayed/h-extern-unsafe-no-state-div-cast f)))
  (define std/core/delayed/unsafe-no-state-div
    (λ (f)
      ((std/core/delayed/unsafe-no-state-div-cast f))))
  (define std/core/delayed/force
    (λ (delayed)
      (std/core/delayed/unsafe-no-state-div (λ ()
        (std/core/delayed/force/go delayed)))))
  (define std/core/delayed/once
    (λ (calc)
      (letrec* ([ievh-689 std/core/types/h-Hdiv] [ievh-694 std/core/types/h-Hdiv])
        (std/core/unsafe/unsafe-total (λ ()
          (letrec* ([r (std/core/types/ref std/core/types/Nothing)])
            (λ ()
              (std/core/unsafe/unsafe-total (λ ()
                (match (std/core/types/ref/! r ievh-694)
                  [(std/core/types/Just x) x]
                  [std/core/types/Nothing (letrec* ([x (calc)] [_ (std/core/types/set r (std/core/types/Just x))])
                    x)])))))))))))