                      (analysis/benchmarks/koka-gen/coop-communication/spawn (λ ()
                        (analysis/benchmarks/koka-gen/coop-communication/filter-actor out-ch n))))]
                    [std/core/types/False (analysis/benchmarks/koka-gen/coop-communication/send out-ch n)])]
