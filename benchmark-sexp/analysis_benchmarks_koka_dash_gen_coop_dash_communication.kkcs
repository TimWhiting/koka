        (letrec* ([ievh-7470 std/core/types/h-Hdiv] [ievh-7474 std/core/types/h-Hnodiv] [out-ch (analysis/benchmarks/koka-gen/coop-communication/channel (std/core/types/++ "ch-" (std/core/int/show (std/core/int/+ my-prime 1))))])
          (std/core/hnd/local-var std/core/types/False (λ (has-neighbor)
