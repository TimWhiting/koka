(module
  handlers/basic
  (define handlers/basic/ask/h-fun-ask
    (λ (ask)
      (match ask
        [(handlers/basic/h-Hnd-ask _ h-x) h-x])))
  (define handlers/basic/ask/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/basic/ask/h-tag hnd ret action)))
  (define handlers/basic/ask/h-select
    (λ (hnd)
      (match hnd
        [(handlers/basic/h-Hnd-ask _ h-fun-ask) h-fun-ask])))
  (define handlers/basic/ask
    (λ ()
      (perform handlers/basic/ask ask)))
  (define handlers/basic/hello
    (λ ()
      (letrec* ([name (handlers/basic/ask)])
        (std/core/console/string/println (std/core/types/++ "Hello " (std/core/types/++ name (std/core/types/++ ", " (handlers/basic/ask))))))))
  (define handlers/basic/example2
    (λ ()
      ((λ (h-action)
        (handlers/basic/ask/h-handle (handler handlers/basic/h-Hnd-ask [fun ask (std/core/hnd/clause-tail0 (λ ()
          "there"))]) (λ (h-res)
          h-res) h-action)) (λ ()
        (handlers/basic/hello)))))
  (define handlers/basic/raise/h-ctl-raise
    (λ (raise)
      (match raise
        [(handlers/basic/h-Hnd-raise _ h-x) h-x])))
  (define handlers/basic/raise/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/basic/raise/h-tag hnd ret action)))
  (define handlers/basic/raise/h-select
    (λ (hnd)
      (match hnd
        [(handlers/basic/h-Hnd-raise _ h-ctl-raise) h-ctl-raise])))
  (define handlers/basic/raise
    (λ (s)
      (perform handlers/basic/raise raise s)))
  (define handlers/basic/safe-div
    (λ (x y)
      (match (std/core/int/== y 0)
        [std/core/types/True (handlers/basic/raise "division by zero")]
        [std/core/types/False (std/core/int// x y)])))
  (define handlers/basic/rcatch
    (λ (action h)
      ((λ (h-action)
        (handlers/basic/raise/h-handle (handler handlers/basic/h-Hnd-raise [ctl raise (std/core/hnd/clause-control1 (λ (s resume)
          (h s)))]) (λ (h-res)
          h-res) h-action)) (λ ()
        (action)))))
  (define handlers/basic/zerodiv
    (λ (x y)
      (handlers/basic/rcatch (λ ()
        (handlers/basic/safe-div x y)) (λ (s)
        0))))
  (define handlers/basic/to-maybe
    (λ (action)
      ((λ (h-action)
        (handlers/basic/raise/h-handle (handler handlers/basic/h-Hnd-raise [ctl raise (std/core/hnd/clause-never1 (λ (s)
          std/core/types/Nothing))]) (λ (h-res)
          h-res) h-action)) (λ ()
        (std/core/types/Just (action))))))
  (define handlers/basic/example1
    (λ ()
      (std/core/console/default/show/println (handlers/basic/zerodiv 10 0) std/core/int/show)))
  (define handlers/basic/state/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/basic/state/h-tag hnd ret action)))
  (define handlers/basic/state/h-fun-get
    (λ (state)
      (match state
        [(handlers/basic/h-Hnd-state _ h-x _) h-x])))
  (define handlers/basic/get/h-select
    (λ (hnd)
      (match hnd
        [(handlers/basic/h-Hnd-state _ h-fun-get _) h-fun-get])))
  (define handlers/basic/get
    (λ ()
      (perform handlers/basic/state get)))
  (define handlers/basic/state/h-fun-put
    (λ (state)
      (match state
        [(handlers/basic/h-Hnd-state _ _ h-x) h-x])))
  (define handlers/basic/put/h-select
    (λ (hnd)
      (match hnd
        [(handlers/basic/h-Hnd-state _ _ h-fun-put) h-fun-put])))
  (define handlers/basic/put
    (λ (x)
      (perform handlers/basic/state put x)))
  (define handlers/basic/counter
    (λ ()
      (letrec* ([i (handlers/basic/get)])
        (match (std/core/int/<= i 0)
          [std/core/types/True std/core/types/Unit]
          [std/core/types/False (letrec* ([_ (std/core/console/string/println "hi")] [_ (handlers/basic/put (std/core/int/- i 1))])
            (handlers/basic/counter))]))))
  (define handlers/basic/state
    (λ (init action)
      (std/core/types/local-scope (λ ()
        (letrec* ([ievh-1795 std/core/types/h-Hnodiv] [ievh-1869 std/core/types/h-Hnodiv] [ievh-1928 std/core/types/h-Hnodiv])
          (std/core/hnd/local-var init (λ (s)
            ((λ (h-action)
              (handlers/basic/state/h-handle (handler handlers/basic/h-Hnd-state [fun get (std/core/hnd/clause-tail0 (λ ()
                (std/core/types/local-get s ievh-1869)))] [fun put (std/core/hnd/clause-tail1 (λ (x)
                (std/core/types/local-set s x)))]) (λ (x)
                (std/core/types/Tuple2 x (std/core/types/local-get s ievh-1928))) h-action)) (λ ()
              (std/core/hnd/h-mask-builtin (λ ()
                (action))))))))))))
  (define handlers/basic/example3
    (λ ()
      (std/core/types/tuple2/snd (handlers/basic/state 1 handlers/basic/counter))))
  (define handlers/basic/yield/h-ctl-yield
    (λ (yield)
      (match yield
        [(handlers/basic/h-Hnd-yield _ h-x) h-x])))
  (define handlers/basic/yield/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/basic/yield/h-tag hnd ret action)))
  (define handlers/basic/yield/h-select
    (λ (hnd)
      (match hnd
        [(handlers/basic/h-Hnd-yield _ h-ctl-yield) h-ctl-yield])))
  (define handlers/basic/yield
    (λ (item)
      (perform handlers/basic/yield yield item)))
  (define handlers/basic/iterate
    (λ (xs)
      (match xs
        [(std/core/types/Cons x xx) (letrec* ([_ (handlers/basic/yield x)])
          (handlers/basic/iterate xx))]
        [std/core/types/Nil std/core/types/Unit])))
  (define handlers/basic/foreach
    (λ (f action)
      ((λ (h-action)
        (handlers/basic/yield/h-handle (handler handlers/basic/h-Hnd-yield [ctl yield (std/core/hnd/clause-control1 (λ (x resume)
          (match (f x)
            [std/core/types/True (resume std/core/types/Unit)]
            [std/core/types/False std/core/types/Unit])))]) (λ (h-res)
          h-res) h-action)) (λ ()
        (action)))))
  (define handlers/basic/example4
    (λ ()
      (handlers/basic/foreach (λ (x)
        (letrec* ([_ (std/core/console/default/show/println x std/core/int/show)])
          (std/core/int/<= x 1))) (λ ()
        (handlers/basic/iterate (std/core/types/Cons 1 (std/core/types/Cons 2 (std/core/types/Cons 3 std/core/types/Nil))))))))
  (define handlers/basic/flip/h-ctl-flip
    (λ (flip)
      (match flip
        [(handlers/basic/h-Hnd-flip _ h-x) h-x])))
  (define handlers/basic/flip/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/basic/flip/h-tag hnd ret action)))
  (define handlers/basic/flip/h-select
    (λ (hnd)
      (match hnd
        [(handlers/basic/h-Hnd-flip _ h-ctl-flip) h-ctl-flip])))
  (define handlers/basic/flip
    (λ ()
      (perform handlers/basic/flip flip)))
  (define handlers/basic/coinflip
    (λ (h-action)
      (handlers/basic/flip/h-handle (handler handlers/basic/h-Hnd-flip [ctl flip (std/core/hnd/clause-tail0 (λ ()
        (std/num/random/srandom-bool)))]) (λ (h-res)
        h-res) h-action)))
  (define handlers/basic/amb
    (λ (h-action)
      (handlers/basic/flip/h-handle (handler handlers/basic/h-Hnd-flip [ctl flip (std/core/hnd/clause-control0 (λ (resume)
        (std/core/list/++ (resume std/core/types/False) (resume std/core/types/True))))]) (λ (x)
        (std/core/types/Cons x std/core/types/Nil)) h-action)))
  (define handlers/basic/example4b
    (λ ()
      ((λ (h-action)
        ((λ (x)
          std/core/types/Unit) (h-action))) (λ ()
        (handlers/basic/amb (λ ()
          (handlers/basic/foreach (λ (x)
            (letrec* ([_ (match (handlers/basic/flip)
              [std/core/types/True (std/core/console/default/show/println x std/core/int/show)]
              [std/core/types/False (std/core/console/string/println (std/core/types/++ "flip false " (std/core/int/show x)))])])
              (std/core/int/<= x 1))) (λ ()
            (handlers/basic/iterate (std/core/types/Cons 1 (std/core/types/Cons 2 (std/core/types/Cons 3 std/core/types/Nil))))))))))))
  (define handlers/basic/xor
    (λ ()
      (letrec* ([p (handlers/basic/flip)] [q (handlers/basic/flip)])
        (match (match p
          [std/core/types/True std/core/types/True]
          [_ q])
          [std/core/types/True (std/core/types/not (match p
            [std/core/types/True q]
            [_ std/core/types/False]))]
          [_ std/core/types/False]))))
  (define handlers/basic/example5
    (λ ()
      (std/core/console/string/println (std/core/list/show (handlers/basic/amb handlers/basic/xor) std/core/bool/show))))
  (define handlers/basic/surprising
    (λ ()
      (letrec* ([p (handlers/basic/flip)] [i (handlers/basic/get)] [_ (handlers/basic/put (std/core/int/+ i 1))])
        (match (match (std/core/int/> i 0)
          [std/core/types/True p]
          [_ std/core/types/False])
          [std/core/types/True (handlers/basic/xor)]
          [std/core/types/False std/core/types/False]))))
  (define handlers/basic/example6
    (λ ()
      (std/core/console/string/println (std/core/tuple/tuple2/show (handlers/basic/state 0 (λ ()
        (handlers/basic/amb handlers/basic/surprising))) (λ (h-arg-x1)
        (std/core/list/show h-arg-x1 std/core/bool/show)) std/core/int/show))))
  (define handlers/basic/example7
    (λ ()
      (std/core/console/string/println (std/core/list/show (handlers/basic/amb (λ ()
        (handlers/basic/state 0 handlers/basic/surprising))) (λ (h-arg-x1)
        (std/core/tuple/tuple2/show h-arg-x1 std/core/bool/show std/core/int/show))))))
  (define handlers/basic/main
    (λ ()
      (letrec* ([_ (handlers/basic/example1)] [_ (handlers/basic/example2)] [_ (handlers/basic/example3)] [_ (handlers/basic/example4)] [_ (handlers/basic/example5)] [_ (handlers/basic/example6)])
        42))))