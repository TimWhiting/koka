(module
  learn/basic
  (define learn/basic/example1
    (λ ()
      (std/core/list/map (std/core/list/range/list 1 5) (λ (i)
        (std/core/console/default/show/println i std/core/int/show)))))
  (define learn/basic/example1a
    (λ ()
      (std/core/list/map (std/core/list/range/list 1 5) (λ (i)
        (std/core/console/default/show/println i std/core/int/show)))))
  (define learn/basic/example1b
    (λ ()
      (std/core/list/map (std/core/list/range/list 1 5) (λ (i)
        (std/core/console/default/show/println i std/core/int/show)))))
  (define learn/basic/example2
    (λ ()
      (std/core/list/map (std/core/list/range/list 1 5) (λ (i)
        (std/core/console/default/show/println i std/core/int/show)))))
  (define learn/basic/example3
    (λ ()
      (std/core/list/map (std/core/list/range/list 1 5) (λ (i)
        (std/core/console/default/show/println i std/core/int/show)))))
  (define learn/basic/example3a
    (λ ()
      (std/core/list/map (std/core/list/range/list 1 5) (λ (i)
        (std/core/console/default/show/println i std/core/int/show)))))
  (define learn/basic/twice
    (λ (f)
      (letrec* ([_ (f)])
        (f))))
  (define learn/basic/example4
    (λ ()
      (learn/basic/twice (λ ()
        (std/core/console/string/println "hi")))))
  (define learn/basic/example4a
    (λ ()
      (learn/basic/twice (λ ()
        (std/core/console/string/println "hi")))))
  (define learn/basic/example5
    (λ ()
      (std/core/types/local-scope (λ ()
        (letrec* ([ievh-1211 std/core/types/h-Hnodiv] [ievh-1279 std/core/types/h-Hnodiv] [ievh-1325 std/core/types/h-Hnodiv])
          (std/core/hnd/local-var 0 (λ (i)
            (std/core/while (λ ()
              (std/core/int/< (std/core/types/local-get i ievh-1211) 10)) (λ ()
              (letrec* ([_ (std/core/types/local-set i (std/core/int/+ (std/core/types/local-get i ievh-1279) 1))])
                (std/core/console/default/show/println (std/core/types/local-get i ievh-1325) std/core/int/show)))))))))))
  (define learn/basic/example6
    (λ ()
      (std/core/console/default/show/println (std/core/list/foldl (std/core/types/Cons 21 (std/core/types/Cons 21 std/core/types/Nil)) 0 std/core/int/+) std/core/int/show)))
  (define learn/basic/increment
    (λ (xs)
      (std/core/list/filter (std/core/list/map xs (λ (x)
        (std/core/int/+ x 1))) (λ (x)
        (std/core/int/> x 2)))))
  (define learn/basic/increment2
    (λ (xs)
      (std/core/list/filter (std/core/list/map xs (λ (x)
        (std/core/int/+ x 1))) (λ (x)
        (std/core/int/> x 2)))))
  (define learn/basic/example-trace
    (λ ()
      (letrec* ([_ (std/core/debug/trace-info "example trace" (std/core/debug/file/kk-file-line "learn/basic.kk" "104"))])
        (std/core/debug/trace (std/core/types/++ "module: " "learn/basic")))))
  (define learn/basic/main
    (λ ()
      (letrec* ([_ (learn/basic/example1)] [_ (learn/basic/example2)] [_ (learn/basic/example3)] [_ (learn/basic/example4)])
        (learn/basic/example5)))))