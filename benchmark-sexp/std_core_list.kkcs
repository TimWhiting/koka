  (define std/core/list/foldl
    (λ (xs z f)
      (match xs
        [(std/core/types/Cons x xx) (std/core/list/foldl xx (f z x) f)]
        [std/core/types/Nil z])))
  (define std/core/list/foldr
    (λ (xs z f)
      (std/core/list/foldl (std/core/list/reverse xs) z (λ (x y)
