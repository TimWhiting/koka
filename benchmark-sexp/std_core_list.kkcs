    (λ (xs pred)
      (match xs
        [std/core/types/Nil std/core/types/Nil]
        [(std/core/types/Cons x xx) (match (pred x)
          [std/core/types/Nothing (std/core/list/filter-map xx pred)]
          [(std/core/types/Just y) (std/core/types/Cons y (std/core/list/filter-map xx pred))])])))
  (define std/core/list/foreach-while
    (λ (xs action)
      (match xs
