    (λ (xs predicate)
      (match xs
        [(std/core/types/Cons x xx) (match (predicate x)
          [std/core/types/True (std/core/list/drop-while xx predicate)]
          [std/core/types/False xs])]
        [std/core/types/Nil std/core/types/Nil])))
  (define std/core/list/filter
    (λ (xs pred)
      (match xs
        [(std/core/types/Cons x xx) (match (pred x)
          [std/core/types/True (std/core/types/Cons x (std/core/list/filter xx pred))]
          [std/core/types/False (std/core/list/filter xx pred)])]
        [std/core/types/Nil std/core/types/Nil])))
