          [(std/core/types/Cons _ _) std/core/types/False])])))
  (define std/core/list/cmp
    (λ (xs ys h-implicit/cmp)
      (match xs
        [(std/core/types/Cons x xx) (match ys
          [std/core/types/Nil std/core/types/Gt]
          [(std/core/types/Cons y yy) (match (h-implicit/cmp x y)
            [std/core/types/Eq (std/core/list/cmp xx yy h-implicit/cmp)]
            [lg lg])])]
        [std/core/types/Nil (match ys
          [std/core/types/Nil std/core/types/Eq]
          [(std/core/types/Cons _ _) std/core/types/Lt])])))
  (define std/core/list/take
    (λ (xs n)
      (match xs
        [(std/core/types/Cons x xx) (std/core/types/Cons x (std/core/list/take xx (std/core/int/- n 1)))]
        [_ std/core/types/Nil])))
  (define std/core/list/drop
    (λ (xs n)
      (match xs
        [(std/core/types/Cons _ xx) (std/core/list/drop xx (std/core/int/- n 1))]
        [_ xs])))
  (define std/core/list/reverse-acc
    (λ (acc ys)
      (match ys
        [(std/core/types/Cons x xx) (std/core/list/reverse-acc (std/core/types/Cons x acc) xx)]
        [std/core/types/Nil acc])))
  (define std/core/list/reverse-append
    (λ (xs tl)
      (std/core/list/reverse-acc tl xs)))
  (define std/core/list/reverse
    (λ (xs)
      (std/core/list/reverse-append xs std/core/types/Nil)))
  (define std/core/list/append
    (λ (xs ys)
      (match xs
        [(std/core/types/Cons x xx) (std/core/types/Cons x (std/core/list/append xx ys))]
        [std/core/types/Nil ys])))
  (define std/core/list/++
    (λ (xs ys)
