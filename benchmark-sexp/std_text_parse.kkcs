  (define std/text/parse/starts-with
    (λ (s p)
      (match (std/text/parse/parse (std/core/sslice/slice s) p)
        [(std/text/parse/ParseOk x (as rest (std/core/sslice/Sslice _ _ _))) (std/core/types/Just (std/core/types/Tuple2 x rest))]
        [_ std/core/types/Nothing])))
  (define |std/text/parse/|||
    (λ (p1 p2)
      (match (std/text/parse/pick)
        [std/core/types/True (p1)]
        [std/core/types/False (p2)])))
  (define std/text/parse/optional
    (λ (default p)
      (|std/text/parse/||| p (λ ()
        default))))
  (define std/text/parse/choose
    (λ (ps)
      (match ps
        [std/core/types/Nil (std/text/parse/fail "no further alternatives")]
        [(std/core/types/Cons p std/core/types/Nil) (p)]
        [(std/core/types/Cons p pp) (match (std/text/parse/pick)
          [std/core/types/True (p)]
          [std/core/types/False (std/text/parse/choose pp)])])))
  (define std/text/parse/satisfy-fail
    (λ (msg pred)
      (match (std/text/parse/satisfy pred)
        [std/core/types/Nothing (std/text/parse/fail msg)]
        [(std/core/types/Just x) x])))
  (define std/text/parse/eof
    (λ ()
      (match (std/text/parse/satisfy (λ (s)
        (match (std/core/sslice/is-empty s)
          [std/core/types/True (std/core/types/Just (std/core/types/Tuple2 std/core/types/Unit s))]
          [std/core/types/False std/core/types/Nothing])))
        [std/core/types/Nothing (std/text/parse/fail "expecting end-of-input")]
        [(std/core/types/Just std/core/types/Unit) std/core/types/Unit])))
  (define std/text/parse/parse-eof
    (λ (input p)
      (std/text/parse/parse input (λ ()
        (letrec* ([x (p)] [_ (std/text/parse/eof)])
