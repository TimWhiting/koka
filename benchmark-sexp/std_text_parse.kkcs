  (define std/text/parse/whitespace
    (λ ()
      (std/core/string/listchar/string (std/text/parse/chars-are "" std/core/char/is-white))))
  (define std/text/parse/whitespace0
    (λ ()
      (std/text/parse/optional "" std/text/parse/whitespace)))
  (define std/text/parse/digits
