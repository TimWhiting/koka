  (define std/text/parse/char-is
    (λ (msg pred)
      (std/text/parse/satisfy-fail msg (λ (slice)
        (match (std/core/sslice/next slice)
          [(std/core/types/Just (std/core/types/Tuple2 c rest)) (std/core/types/Just (std/core/types/Tuple2 c rest))]
          [_ std/core/types/Nothing])))))
  (define std/text/parse/next-while0
    (λ (slice pred acc)
      (match (std/core/sslice/next slice)
        [(std/core/types/Just (std/core/types/Tuple2 c rest)) (std/text/parse/next-while0 rest pred (std/core/types/Cons c acc))]
        [_ (std/core/types/Tuple2 (std/core/list/reverse acc) slice)])))
  (define std/text/parse/chars-are
    (λ (msg pred)
      (std/text/parse/satisfy-fail msg (λ (slice)
        (match (std/text/parse/next-while0 slice pred std/core/types/Nil)
          [(std/core/types/Tuple2 std/core/types/Nil (std/core/sslice/Sslice _ _ _)) std/core/types/Nothing]
          [(std/core/types/Tuple2 xs (as rest (std/core/sslice/Sslice _ _ _))) (std/core/types/Just (std/core/types/Tuple2 xs rest))])))))
  (define std/text/parse/next-match
    (λ (slice cs)
      (match cs
        [std/core/types/Nil (std/core/types/Just slice)]
        [(std/core/types/Cons c cc) (match (std/core/sslice/next slice)
          [(std/core/types/Just (std/core/types/Tuple2 d rest)) (std/text/parse/next-match rest cc)]
          [_ std/core/types/Nothing])])))
  (define std/text/parse/pstring
    (λ (s)
      (std/text/parse/satisfy-fail s (λ (slice)
        (match (std/text/parse/next-match slice (std/core/string/list s))
          [(std/core/types/Just (as rest (std/core/sslice/Sslice _ _ _))) (std/core/types/Just (std/core/types/Tuple2 s rest))]
          [std/core/types/Nothing std/core/types/Nothing])))))
  (define std/text/parse/char
    (λ (c)
      (std/text/parse/char-is (std/core/show/char/show c) (λ (c0)
        (std/core/char/== c c0)))))
  (define std/text/parse/no-digit
    (λ ()
