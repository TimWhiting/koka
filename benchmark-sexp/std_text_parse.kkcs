  (define std/text/parse/pnat
    (λ ()
      (std/core/maybe/default (std/core/int/parse-int (std/text/parse/digits) std/core/types/h-None) 0)))
  (define std/text/parse/none-of
    (λ (chars)
      (letrec* ([ievh-2586 std/core/types/h-Hnodiv])
        (std/text/parse/char-is "" (λ (c)
          (std/core/types/bool/! (std/core/string/contains chars (std/core/string/char/string c))))))))
  (define std/text/parse/none-of-many1
    (λ (chars)
