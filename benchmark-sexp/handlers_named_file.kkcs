(module
  handlers/named/file
  (define handlers/named/file/file/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-named-handle handlers/named/file/file/h-tag hnd ret action)))
  (define handlers/named/file/file/h-fun-read-line
    (λ (file)
      (match file
        [(handlers/named/file/h-Hnd-file _ h-x) h-x])))
  (define handlers/named/file/read-line/h-select
    (λ (hnd)
      (match hnd
        [(handlers/named/file/h-Hnd-file _ h-fun-read-line) h-fun-read-line])))
  (define handlers/named/file/read-line
    (λ (h-hname)
      (perform handlers/named/file/file read-line)))
  (define handlers/named/file/file
    (λ (fname action)
      (std/core/types/local-scope (λ ()
        (letrec* ([ievh-310 std/core/types/h-Hnodiv])
          (std/core/hnd/local-var (std/core/list/lines (std/os/file/read-text-file (std/os/path/path fname))) (λ (content)
            ((λ (h-action)
              (handlers/named/file/file/h-handle (handler handlers/named/file/h-Hnd-file [fun read-line (std/core/hnd/clause-tail0 (λ ()
                (match (std/core/types/local-get content ievh-310)
                  [std/core/types/Nil ""]
                  [(std/core/types/Cons x xx) (letrec* ([_ (std/core/types/local-set content xx)])
                    x)])))]) (λ (h-res)
                h-res) h-action)) (λ (f)
              ((λ (h-arg-x1)
                (std/core/hnd/h-mask-builtin (λ ()
                  (action h-arg-x1)))) f))))))))))
  (define handlers/named/file/main
    (λ ()
      (handlers/named/file/file "package.yaml" (λ (f1)
        (handlers/named/file/file "stack.yaml" (λ (f2)
          (std/core/console/string/println (std/core/types/++ (handlers/named/file/read-line f1) (std/core/types/++ "\n" (handlers/named/file/read-line f2))))))))))
  (define handlers/named/file/wrong-escape1
    (λ ()
      (handlers/named/file/file "stack.yaml" (λ (f)
        f))))
  (define handlers/named/file/example-wrong
    (λ ()
      (letrec* ([f (handlers/named/file/wrong-escape1)])
        (std/core/console/string/println (handlers/named/file/read-line f))))))