(module
  analysis/benchmarks/koka-gen/interp2
  (define analysis/benchmarks/koka-gen/interp2/is-slit
    (λ (surface)
      (match surface
        [(analysis/benchmarks/koka-gen/interp2/SLit _) std/core/types/True]
        [_ std/core/types/False])))
  (define analysis/benchmarks/koka-gen/interp2/is-svar
