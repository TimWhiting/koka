        [(analysis/benchmarks/koka-gen/interp2/VInt _) std/core/types/True]
        [(analysis/benchmarks/koka-gen/interp2/VClos _ _ _) std/core/types/False])))
  (define analysis/benchmarks/koka-gen/interp2/is-vclos
    (λ (value)
      (match value
        [(analysis/benchmarks/koka-gen/interp2/VClos _ _ _) std/core/types/True]
        [(analysis/benchmarks/koka-gen/interp2/VInt _) std/core/types/False])))
  (define analysis/benchmarks/koka-gen/interp2/desugar
    (λ (s)
      (match s
        [(analysis/benchmarks/koka-gen/interp2/SLit i) (analysis/benchmarks/koka-gen/interp2/Lit i)]
        [(analysis/benchmarks/koka-gen/interp2/SVar n) (analysis/benchmarks/koka-gen/interp2/Var n)]
        [(analysis/benchmarks/koka-gen/interp2/SPrim op args) (analysis/benchmarks/koka-gen/interp2/Prim op (std/core/list/map args analysis/benchmarks/koka-gen/interp2/desugar))]
        [(analysis/benchmarks/koka-gen/interp2/SLam ps b) (analysis/benchmarks/koka-gen/interp2/Lam ps (analysis/benchmarks/koka-gen/interp2/desugar b))]
        [(analysis/benchmarks/koka-gen/interp2/SApp f args) (analysis/benchmarks/koka-gen/interp2/App (analysis/benchmarks/koka-gen/interp2/desugar f) (std/core/list/map args analysis/benchmarks/koka-gen/interp2/desugar))]
        [(analysis/benchmarks/koka-gen/interp2/SLet name expr body) (analysis/benchmarks/koka-gen/interp2/App (analysis/benchmarks/koka-gen/interp2/Lam (std/core/types/Cons name std/core/types/Nil) (analysis/benchmarks/koka-gen/interp2/desugar body)) (std/core/types/Cons (analysis/benchmarks/koka-gen/interp2/desugar expr) std/core/types/Nil))])))
  (define analysis/benchmarks/koka-gen/interp2/env/h-tag
    "env@interp2")
  (define analysis/benchmarks/koka-gen/interp2/env/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle analysis/benchmarks/koka-gen/interp2/env/h-tag hnd ret action)))
  (define analysis/benchmarks/koka-gen/interp2/env/h-ctl-lookup
    (λ (env)
      (match env
        [(analysis/benchmarks/koka-gen/interp2/env _ h-x _) h-x])))
  (define analysis/benchmarks/koka-gen/interp2/lookup/h-select
    (λ (hnd)
      (match hnd
        [(analysis/benchmarks/koka-gen/interp2/env _ h-ctl-lookup _) h-ctl-lookup])))
  (define analysis/benchmarks/koka-gen/interp2/lookup
    (λ (name)
      (perform analysis/benchmarks/koka-gen/interp2/env lookup name)))
  (define analysis/benchmarks/koka-gen/interp2/env/h-ctl-snapshot
    (λ (env)
      (match env
        [(analysis/benchmarks/koka-gen/interp2/env _ _ h-x) h-x])))
  (define analysis/benchmarks/koka-gen/interp2/snapshot/h-select
    (λ (hnd)
      (match hnd
        [(analysis/benchmarks/koka-gen/interp2/env _ _ h-ctl-snapshot) h-ctl-snapshot])))
  (define analysis/benchmarks/koka-gen/interp2/snapshot
    (λ ()
      (perform analysis/benchmarks/koka-gen/interp2/env snapshot)))
  (define analysis/benchmarks/koka-gen/interp2/run-env
    (λ (current-env action)
      ((λ (h-action)
        (analysis/benchmarks/koka-gen/interp2/env/h-handle (handler analysis/benchmarks/koka-gen/interp2/env [ctl lookup (λ (name resume)
          (match (std/core/list/find current-env (λ (entry)
            (std/core/string/== (std/core/types/tuple2/fst entry) name)))
            [(std/core/types/Just (std/core/types/Tuple2 _ v)) (resume v)]
            [std/core/types/Nothing (std/core/exn/throw (std/core/types/++ "Runtime Error: Variable '" (std/core/types/++ name "' not found")) std/core/types/h-None)]))] [ctl snapshot (λ (resume)
          (resume current-env))]) (λ (h-res)
          h-res) h-action)) action)))
  (define analysis/benchmarks/koka-gen/interp2/show
    (λ (v)
      (match v
        [(analysis/benchmarks/koka-gen/interp2/VInt i) (std/core/int/show i)]
        [(analysis/benchmarks/koka-gen/interp2/VClos _ _ _) "<closure>"])))
  (define analysis/benchmarks/koka-gen/interp2/run-safe
    (λ (action h-implicit/a/show)
      ((λ (h-action)
        (std/core/exn/exn/h-handle (handler std/core/exn/exn [?  (std/core/hnd/clause-never1 (λ (msg)
          (std/core/types/++ "FAILURE: " (std/core/exn/show msg))))]) (λ (x)
          (h-implicit/a/show x)) h-action)) (λ ()
        (action)))))
  (define analysis/benchmarks/koka-gen/interp2/eval-prim
    (λ (op args)
      (match (std/core/types/Tuple2 op args)
        [(std/core/types/Tuple2 "+" (std/core/types/Cons (analysis/benchmarks/koka-gen/interp2/VInt a) (std/core/types/Cons (analysis/benchmarks/koka-gen/interp2/VInt b) std/core/types/Nil))) (analysis/benchmarks/koka-gen/interp2/VInt (std/core/int/+ a b))]
        [(std/core/types/Tuple2 "-" (std/core/types/Cons (analysis/benchmarks/koka-gen/interp2/VInt a) (std/core/types/Cons (analysis/benchmarks/koka-gen/interp2/VInt b) std/core/types/Nil))) (analysis/benchmarks/koka-gen/interp2/VInt (std/core/int/- a b))]
        [(std/core/types/Tuple2 "*" (std/core/types/Cons (analysis/benchmarks/koka-gen/interp2/VInt a) (std/core/types/Cons (analysis/benchmarks/koka-gen/interp2/VInt b) std/core/types/Nil))) (analysis/benchmarks/koka-gen/interp2/VInt (std/core/int/* a b))]
        [(std/core/types/Tuple2 "sum" xs) (letrec* ([total (std/core/list/foldl xs 0 (λ (acc v)
          (match v
            [(analysis/benchmarks/koka-gen/interp2/VInt k) (std/core/int/+ acc k)]
            [(analysis/benchmarks/koka-gen/interp2/VClos _ _ _) 0])))])
          (analysis/benchmarks/koka-gen/interp2/VInt total))]
        [_ (std/core/exn/throw (std/core/types/++ "Primitive error: Unknown op '" (std/core/types/++ op "' or invalid args")) std/core/types/h-None)])))
  (define analysis/benchmarks/koka-gen/interp2/eval
    (λ (t)
      (match t
        [(analysis/benchmarks/koka-gen/interp2/Lit i) (analysis/benchmarks/koka-gen/interp2/VInt i)]
        [(analysis/benchmarks/koka-gen/interp2/Var x) (analysis/benchmarks/koka-gen/interp2/lookup x)]
        [(analysis/benchmarks/koka-gen/interp2/Prim op args) (letrec* ([arg-vals (std/core/list/map args analysis/benchmarks/koka-gen/interp2/eval)])
          (analysis/benchmarks/koka-gen/interp2/eval-prim op arg-vals))]
        [(analysis/benchmarks/koka-gen/interp2/Lam ps b) (letrec* ([cap (analysis/benchmarks/koka-gen/interp2/snapshot)])
          (analysis/benchmarks/koka-gen/interp2/VClos ps b cap))]
        [(analysis/benchmarks/koka-gen/interp2/App f args) (letrec* ([func-val (analysis/benchmarks/koka-gen/interp2/eval f)] [arg-vals (std/core/list/map args analysis/benchmarks/koka-gen/interp2/eval)])
          (match func-val
            [(analysis/benchmarks/koka-gen/interp2/VClos params body saved-env) (letrec* ([_ (match (std/core/int/!= (std/core/list/length params) (std/core/list/length arg-vals))
              [std/core/types/True (std/core/exn/throw (std/core/types/++ "Arity Mismatch: Expected " (std/core/types/++ (std/core/int/show (std/core/list/length params)) (std/core/types/++ " args, got " (std/core/int/show (std/core/list/length arg-vals))))) std/core/types/h-None)]
              [std/core/types/False std/core/types/Unit])] [bindings (std/core/list/zip params arg-vals)] [new-env (std/core/list/++ bindings saved-env)])
              (analysis/benchmarks/koka-gen/interp2/run-env new-env (λ ()
                (analysis/benchmarks/koka-gen/interp2/eval body))))]
            [(analysis/benchmarks/koka-gen/interp2/VInt _) (std/core/exn/throw "Type Error: Application on non-function" std/core/types/h-None)]))])))
  (define analysis/benchmarks/koka-gen/interp2/interpret
    (λ (s)
      (letrec* ([core (analysis/benchmarks/koka-gen/interp2/desugar s)] [res (analysis/benchmarks/koka-gen/interp2/run-env std/core/types/Nil (λ ()
        (analysis/benchmarks/koka-gen/interp2/eval core)))])
        (std/core/types/++ "Result: " (analysis/benchmarks/koka-gen/interp2/show res)))))
