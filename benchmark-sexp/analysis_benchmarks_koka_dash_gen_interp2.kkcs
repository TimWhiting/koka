    (λ ()
      (letrec* ([t1 (analysis/benchmarks/koka-gen/interp2/SLet "x" (analysis/benchmarks/koka-gen/interp2/SLit 10) (analysis/benchmarks/koka-gen/interp2/SPrim "*" (std/core/types/Cons (analysis/benchmarks/koka-gen/interp2/SVar "x") (std/core/types/Cons (analysis/benchmarks/koka-gen/interp2/SLit 2) std/core/types/Nil))))])
        (analysis/benchmarks/koka-gen/interp2/run-safe (λ ()
          (analysis/benchmarks/koka-gen/interp2/interpret t1)) std/core/types/id))))
