(module
  handlers/named/ask
  (define handlers/named/ask/reader/h-tag
    "reader@ask")
  (define handlers/named/ask/reader/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-named-handle handlers/named/ask/reader/h-tag hnd ret action)))
  (define handlers/named/ask/reader/h-fun-ask
    (λ (reader)
      (match reader
        [(handlers/named/ask/reader _ h-x) h-x])))
  (define handlers/named/ask/ask/h-select
    (λ (hnd)
      (match hnd
        [(handlers/named/ask/reader _ h-fun-ask) h-fun-ask])))
  (define handlers/named/ask/ask
    (λ (h-hname)
      (perform handlers/named/ask/reader ask)))
  (define handlers/named/ask/reader
    (λ (msg action)
      ((λ (h-action)
        (handlers/named/ask/reader/h-handle (handler handlers/named/ask/reader [fun ask (λ ()
          msg)]) (λ (h-res)
          h-res) h-action)) (λ (r)
        (action r)))))
  (define handlers/named/ask/read2files
    (λ (r1 r2)
      (std/core/console/string/println (std/core/types/++ (handlers/named/ask/ask r1) (std/core/types/++ " " (handlers/named/ask/ask r2))))))
  (define handlers/named/ask/main
    (λ ()
      (handlers/named/ask/reader "hello" (λ (r1)
        (handlers/named/ask/reader "world" (λ (r2)
          (handlers/named/ask/read2files r1 r2))))))))