(module
  basic/fibonacci
  (define basic/fibonacci/fib
    (λ (n x1 x2)
      (match (std/core/int/<= n 0)
        [std/core/types/True x1]
        [std/core/types/False (basic/fibonacci/fib (std/core/int/- n 1) x2 (std/core/int/+ x1 x2))])))
  (define basic/fibonacci/fibonacci
    (λ (n)
      (basic/fibonacci/fib n 0 1)))
  (define basic/fibonacci/main
    (λ ()
      (letrec* ([n 10000])
        (std/core/console/string/println (std/core/types/++ "The " (std/core/types/++ (std/core/int/show n) (std/core/types/++ "th fibonacci number is " (std/core/int/show (basic/fibonacci/fibonacci 10000)))))))))
  (define basic/fibonacci/examplex
    (λ ()
      (std/core/console/default/show/println (basic/fibonacci/fibonacci 100) std/core/int/show)))
  (define basic/fibonacci/example2
    (λ ()
      (std/core/console/default/show/println (basic/fibonacci/fibonacci 1000) std/core/int/show))))