(module
  basic/caesar
  (define basic/caesar/encode
    (λ (s shift)
      (letrec* ([h-uniq-shifth-35 (match shift
        [(std/core/types/h-Optional h-uniq-shifth-36) h-uniq-shifth-36]
        [std/core/types/h-None 3])] [encode-char (λ (c)
        (match (match (std/core/char/< c (char "a"))
          [std/core/types/True std/core/types/True]
          [_ (std/core/char/> c (char "z"))])
          [std/core/types/True c]
          [std/core/types/False (letrec* ([_ std/core/types/Unit] [base (std/core/char/int (std/core/char/- c (char "a")))] [rot (std/core/int/% (std/core/int/+ base h-uniq-shifth-35) 26)])
            (std/core/char/+ (std/core/char/int/char rot) (char "a")))]))])
        (std/core/list/string/map s encode-char))))
  (define basic/caesar/caesar
    (λ (s)
      (basic/caesar/encode s (std/core/types/h-Optional 3))))
  (define basic/caesar/english
    (std/core/types/Cons 8.2 (std/core/types/Cons 1.5 (std/core/types/Cons 2.8 (std/core/types/Cons 4.3 (std/core/types/Cons 12.7 (std/core/types/Cons 2.2 (std/core/types/Cons 2.0 (std/core/types/Cons 6.1 (std/core/types/Cons 7.0 (std/core/types/Cons 0.2 (std/core/types/Cons 0.8 (std/core/types/Cons 4.0 (std/core/types/Cons 2.4 (std/core/types/Cons 6.7 (std/core/types/Cons 7.5 (std/core/types/Cons 1.9 (std/core/types/Cons 0.1 (std/core/types/Cons 6.0 (std/core/types/Cons 6.3 (std/core/types/Cons 9.1 (std/core/types/Cons 2.8 (std/core/types/Cons 1.0 (std/core/types/Cons 2.4 (std/core/types/Cons 0.2 (std/core/types/Cons 2.0 (std/core/types/Cons 0.1 std/core/types/Nil)))))))))))))))))))))))))))
  (define basic/caesar/percent
    (λ (n m)
      (std/num/float64/* 100.0 (std/num/float64// (std/num/float64/float64 n) (std/num/float64/float64 m)))))
  (define basic/caesar/rotate
    (λ (xs n)
      (std/core/list/++ (std/core/list/drop xs n) (std/core/list/take xs n))))
  (define basic/caesar/freqs
    (λ (s)
      (letrec* ([lowers (std/core/list/char/list (char "a") (char "z"))] [occurs (std/core/list/map lowers (λ (c)
        (std/core/string/stringpat/count s (std/core/string/char/string c))))] [total (std/core/list/sum occurs)])
        (std/core/list/map occurs (λ (i)
          (basic/caesar/percent i total))))))
  (define basic/caesar/chisqr
    (λ (xs ys)
      (std/num/float64/sum (std/core/list/zipwith xs ys (λ (x y)
        (std/num/float64// (std/num/float64/^ (std/num/float64/- x y) 2.0) y))))))
  (define basic/caesar/uncaesar
    (λ (s)
      (letrec* ([table (basic/caesar/freqs s)] [chitab (std/core/list/map (std/core/list/range/list 0 25) (λ (n)
        (basic/caesar/chisqr (basic/caesar/rotate table n) basic/caesar/english)))] [min (std/num/float64/minimum chitab)] [shift (std/core/list/index-of chitab (λ (f)
        (std/num/float64/== f min)))])
        (basic/caesar/encode s (std/core/types/h-Optional (std/core/int/~ shift))))))
  (define basic/caesar/example-uncaesar
    (λ ()
      (std/core/console/string/println (basic/caesar/uncaesar "nrnd lv d ixq odqjxdjh"))))
  (define basic/caesar/main
    (λ ()
      (letrec* ([s "Koka is a well-typed language"] [_ (std/core/console/string/println (std/core/types/++ "plain  : " s))] [_ (std/core/console/string/println (std/core/types/++ "encoded: " (basic/caesar/caesar s)))])
        (std/core/console/string/println (std/core/types/++ "cracked: " (basic/caesar/uncaesar (basic/caesar/caesar s))))))))