(module
  std/core/lazy
  (define std/core/lazy/memoize-target
    (λ (target size scan-size)
      (std/core/lazy/h-extern-memoize-target target size scan-size)))
  (define std/core/lazy/memoize
    (λ (target x)
      (std/core/lazy/h-extern-memoize target x)))
  (define std/core/lazy/internal
    42))