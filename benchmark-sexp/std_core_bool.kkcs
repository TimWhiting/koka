(module
  std/core/bool
  (define std/core/bool/==
    (λ (x y)
      (letrec* ([ievh-29 std/core/types/h-Hnodiv])
        (match x
          [std/core/types/True y]
          [std/core/types/False (std/core/types/bool/! y)]))))
  (define std/core/bool/!=
    (λ (x y)
      (letrec* ([ievh-47 std/core/types/h-Hnodiv])
        (match x
          [std/core/types/True (std/core/types/bool/! y)]
          [std/core/types/False y]))))
  (define std/core/bool/<
    (λ (x y)
      (letrec* ([ievh-69 std/core/types/h-Hnodiv])
        (match (std/core/types/bool/! x)
          [std/core/types/True y]
          [_ std/core/types/False]))))
  (define std/core/bool/>
    (λ (x y)
      (letrec* ([ievh-90 std/core/types/h-Hnodiv])
        (match x
          [std/core/types/True (std/core/types/bool/! y)]
          [_ std/core/types/False]))))
  (define std/core/bool/<=
    (λ (x y)
      (letrec* ([ievh-105 std/core/types/h-Hnodiv])
        (std/core/types/bool/! (std/core/bool/> x y)))))
  (define std/core/bool/>=
    (λ (x y)
      (letrec* ([ievh-125 std/core/types/h-Hnodiv])
        (std/core/types/bool/! (std/core/bool/< x y)))))
  (define std/core/bool/xor
    (λ (x y)
      (letrec* ([ievh-149 std/core/types/h-Hnodiv])
        (match x
          [std/core/types/False y]
          [std/core/types/True (std/core/types/bool/! y)]))))
  (define std/core/bool/cmp
    (λ (x y)
      (match (std/core/bool/< x y)
        [std/core/types/True std/core/types/Lt]
        [std/core/types/False (match (std/core/bool/> x y)
          [std/core/types/True std/core/types/Gt]
          [std/core/types/False std/core/types/Eq])])))
  (define std/core/bool/order2
    (λ (x y)
      (match (std/core/bool/== x y)
        [std/core/types/True (std/core/types/Eq2 x)]
        [std/core/types/False (match (std/core/bool/< x y)
          [std/core/types/True (std/core/types/Lt2 x y)]
          [std/core/types/False (std/core/types/Gt2 y x)])])))
  (define std/core/bool/show
    (λ (b)
      (match b
        [std/core/types/True "True"]
        [std/core/types/False "False"])))
  (define std/core/bool/int
    (λ (b)
      (match b
        [std/core/types/True 1]
        [std/core/types/False 0]))))