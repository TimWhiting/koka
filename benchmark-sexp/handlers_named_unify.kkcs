(module
  handlers/named/unify
  (define handlers/named/unify/is-uvar
    (λ (utype)
      (match utype
        [(handlers/named/unify/UVar _) std/core/types/True]
        [_ std/core/types/False])))
  (define handlers/named/unify/is-ucon
    (λ (utype)
      (match utype
        [(handlers/named/unify/UCon _) std/core/types/True]
        [_ std/core/types/False])))
  (define handlers/named/unify/is-uapp
    (λ (utype)
      (match utype
        [(handlers/named/unify/UApp _ _) std/core/types/True]
        [_ std/core/types/False])))
  (define handlers/named/unify/is-con
    (λ (ntype)
      (match ntype
        [(handlers/named/unify/Con _) std/core/types/True]
        [(handlers/named/unify/App _ _) std/core/types/False])))
  (define handlers/named/unify/is-app
    (λ (ntype)
      (match ntype
        [(handlers/named/unify/App _ _) std/core/types/True]
        [(handlers/named/unify/Con _) std/core/types/False])))
  (define handlers/named/unify/subst/h-tag
    "subst@unify")
  (define handlers/named/unify/subst/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/named/unify/subst/h-tag hnd ret action)))
  (define handlers/named/unify/subst/h-ctl-fresh
    (λ (subst)
      (match subst
        [(handlers/named/unify/subst _ h-x) h-x])))
  (define handlers/named/unify/fresh/h-select
    (λ (hnd)
      (match hnd
        [(handlers/named/unify/subst _ h-ctl-fresh) h-ctl-fresh])))
  (define handlers/named/unify/fresh
    (λ ()
      (perform handlers/named/unify/subst fresh)))
  (define handlers/named/unify/variable/h-tag
    "variable@unify")
  (define handlers/named/unify/variable/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-named-handle handlers/named/unify/variable/h-tag hnd ret action)))
  (define handlers/named/unify/variable/h-fun-get
    (λ (variable)
      (match variable
        [(handlers/named/unify/variable _ h-x _) h-x])))
  (define handlers/named/unify/get/h-select
    (λ (hnd)
      (match hnd
        [(handlers/named/unify/variable _ h-fun-get _) h-fun-get])))
  (define handlers/named/unify/get
    (λ (h-hname)
      (perform handlers/named/unify/variable get)))
  (define handlers/named/unify/variable/h-fun-resolve
    (λ (variable)
      (match variable
        [(handlers/named/unify/variable _ _ h-x) h-x])))
  (define handlers/named/unify/resolve/h-select
    (λ (hnd)
      (match hnd
        [(handlers/named/unify/variable _ _ h-fun-resolve) h-fun-resolve])))
  (define handlers/named/unify/resolve
    (λ (h-hname tp)
      (perform handlers/named/unify/variable resolve tp)))
  (define handlers/named/unify/with-var
    (λ (action)
      (std/core/types/local-scope (λ ()
        (letrec* ([ievh-1003 std/core/types/h-Hnodiv] [ievh-1037 std/core/types/h-Hnodiv])
          (std/core/hnd/local-var std/core/types/Nothing (λ (mtp)
            ((λ (h-action)
              (handlers/named/unify/variable/h-handle (handler handlers/named/unify/variable [fun get (λ ()
                (std/core/types/local-get mtp ievh-1003))] [fun resolve (λ (tp)
                (match (std/core/types/local-get mtp ievh-1037)
                  [std/core/types/Nothing (std/core/types/local-set mtp (std/core/types/Just tp))]
                  [(std/core/types/Just _) (std/core/exn/throw "cannot resolve a unification variable more than once" std/core/types/h-None)]))]) (λ (h-res)
                h-res) h-action)) (λ (v)
              ((λ (h-arg-x1)
                (λ ()
                  (action h-arg-x1))) v))))))))))
  (define handlers/named/unify/subst
    (λ (action)
      ((λ (h-action)
        (handlers/named/unify/subst/h-handle (handler handlers/named/unify/subst [ctl fresh (λ (resume)
          (handlers/named/unify/with-var resume))]) (λ (h-res)
          h-res) h-action)) (λ ()
        (action)))))
  (define handlers/named/unify/resolve-all
    (λ (tp)
      (match tp
        [(handlers/named/unify/UCon tag) (handlers/named/unify/Con tag)]
        [(handlers/named/unify/UApp tp1 tp2) (handlers/named/unify/App (handlers/named/unify/resolve-all tp1) (handlers/named/unify/resolve-all tp2))]
        [(handlers/named/unify/UVar v) (match (handlers/named/unify/get v)
          [std/core/types/Nothing (std/core/exn/throw "unresolved variable" std/core/types/h-None)]
          [(std/core/types/Just tpv) (handlers/named/unify/resolve-all tpv)])])))
  (define handlers/named/unify/unify
    (λ (tp1 tp2)
      (match (std/core/types/Tuple2 tp1 tp2)
        [(std/core/types/Tuple2 (handlers/named/unify/UCon tag1) (handlers/named/unify/UCon tag2)) tp1]
        [(std/core/types/Tuple2 (handlers/named/unify/UVar v1) (handlers/named/unify/UVar v2)) tp1]
        [(std/core/types/Tuple2 (handlers/named/unify/UApp tp11 tp12) (handlers/named/unify/UApp tp21 tp22)) (handlers/named/unify/UApp (handlers/named/unify/unify tp11 tp21) (handlers/named/unify/unify tp12 tp22))]
        [(std/core/types/Tuple2 (handlers/named/unify/UVar v1) _) (match (handlers/named/unify/get v1)
          [std/core/types/Nothing (letrec* ([_ (handlers/named/unify/resolve v1 tp2)])
            tp2)]
          [(std/core/types/Just tpv1) (match tp2
            [(handlers/named/unify/UVar v2) (match (handlers/named/unify/get v2)
              [std/core/types/Nothing (letrec* ([_ (handlers/named/unify/resolve v2 tpv1)])
                tpv1)]
              [(std/core/types/Just tpv2) (handlers/named/unify/unify tpv1 tpv2)])]
            [_ (handlers/named/unify/unify tpv1 tp2)])])]
        [_ (std/core/exn/throw "cannot unify types" std/core/types/h-None)])))
  (define handlers/named/unify/inttp
    (λ ()
      (handlers/named/unify/UCon "int")))
  (define handlers/named/unify/list
    (λ (tp1)
      (handlers/named/unify/UApp (handlers/named/unify/UCon "list") tp1)))
  (define handlers/named/unify/to
    (λ (tp1 tp2)
      (handlers/named/unify/UApp (handlers/named/unify/UApp (handlers/named/unify/UCon "->") tp1) tp2)))
  (define handlers/named/unify/show
    (λ (tp top)
      (letrec* ([h-uniq-toph-1867 (match top
        [(std/core/types/h-Optional h-uniq-toph-1868) h-uniq-toph-1868]
        [std/core/types/h-None std/core/types/True])] [parens (λ (s)
        (match h-uniq-toph-1867
          [std/core/types/True s]
          [std/core/types/False (std/core/types/++ "(" (std/core/types/++ s ")"))]))])
        (match tp
          [(handlers/named/unify/App (handlers/named/unify/App (handlers/named/unify/Con "->") t1) t2) (parens (std/core/types/++ (handlers/named/unify/show t1 std/core/types/h-None) (std/core/types/++ " -> " (handlers/named/unify/show t2 std/core/types/h-None))))]
          [(handlers/named/unify/Con tag) tag]
          [(handlers/named/unify/App t1 t2) (parens (std/core/types/++ (handlers/named/unify/show t1 std/core/types/h-None) (std/core/types/++ " " (handlers/named/unify/show t2 (std/core/types/h-Optional std/core/types/False)))))]))))
  (define handlers/named/unify/example
    (λ ()
      (handlers/named/unify/subst (λ ()
        (letrec* ([a (handlers/named/unify/fresh)] [b (handlers/named/unify/fresh)] [tp1 (handlers/named/unify/to (handlers/named/unify/UVar a) (handlers/named/unify/UVar a))] [tp2 (handlers/named/unify/to (handlers/named/unify/UVar b) (handlers/named/unify/list (handlers/named/unify/inttp)))])
          (handlers/named/unify/resolve-all (handlers/named/unify/unify tp1 tp2)))))))
  (define handlers/named/unify/main
    (λ ()
      (letrec* ([tp (handlers/named/unify/example)])
        (std/core/console/string/println (std/core/types/++ "unified type: " (handlers/named/unify/show tp std/core/types/h-None)))))))