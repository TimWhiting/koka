(module
  std/core/char
  (define std/core/char/cmp
    (λ (x y)
      (match (std/core/char/< x y)
        [std/core/types/True std/core/types/Lt]
        [std/core/types/False (match (std/core/char/> x y)
          [std/core/types/True std/core/types/Gt]
          [std/core/types/False std/core/types/Eq])])))
  (define std/core/char/order2
    (λ (x y)
      (match (std/core/char/== x y)
        [std/core/types/True (std/core/types/Eq2 x)]
        [std/core/types/False (match (std/core/char/< x y)
          [std/core/types/True (std/core/types/Lt2 x y)]
          [std/core/types/False (std/core/types/Gt2 y x)])])))
  (define std/core/char/+
    (λ (c d)
      (std/core/char/int/char (std/core/int/+ (std/core/char/int c) (std/core/char/int d)))))
  (define std/core/char/-
    (λ (c d)
      (std/core/char/int/char (std/core/int/- (std/core/char/int c) (std/core/char/int d)))))
  (define std/core/char/is-lower
    (λ (c)
      (match (std/core/char/>= c (char "a"))
        [std/core/types/True (std/core/char/<= c (char "z"))]
        [_ std/core/types/False])))
  (define std/core/char/is-upper
    (λ (c)
      (match (std/core/char/>= c (char "A"))
        [std/core/types/True (std/core/char/<= c (char "Z"))]
        [_ std/core/types/False])))
  (define std/core/char/is-digit
    (λ (c)
      (match (std/core/char/>= c (char "0"))
        [std/core/types/True (std/core/char/<= c (char "9"))]
        [_ std/core/types/False])))
  (define std/core/char/is-hex-digit
    (λ (c)
      (match (std/core/char/is-digit c)
        [std/core/types/True std/core/types/True]
        [_ (match (match (std/core/char/>= c (char "a"))
          [std/core/types/True (std/core/char/<= c (char "f"))]
          [_ std/core/types/False])
          [std/core/types/True std/core/types/True]
          [_ (match (std/core/char/>= c (char "A"))
            [std/core/types/True (std/core/char/<= c (char "F"))]
            [_ std/core/types/False])])])))
  (define std/core/char/is-alpha
    (λ (c)
      (match (std/core/char/is-lower c)
        [std/core/types/True std/core/types/True]
        [_ (std/core/char/is-upper c)])))
  (define std/core/char/is-alpha-num
    (λ (c)
      (match (std/core/char/is-alpha c)
        [std/core/types/True std/core/types/True]
        [_ (std/core/char/is-digit c)])))
  (define std/core/char/is-ascii
    (λ (c)
      (std/core/char/<= c (char ""))))
  (define std/core/char/is-control
    (λ (c)
      (std/core/char/< c (char " "))))
  (define std/core/char/is-white
    (λ (c)
      (match (std/core/char/== c (char " "))
        [std/core/types/True std/core/types/True]
        [_ (match (std/core/char/== c (char "\t"))
          [std/core/types/True std/core/types/True]
          [_ (match (std/core/char/== c (char "\n"))
            [std/core/types/True std/core/types/True]
            [_ (std/core/char/== c (char ""))])])]))))