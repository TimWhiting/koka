(module
  handlers/scoped
  (define handlers/scoped/nondet/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/scoped/nondet/h-tag hnd ret action)))
  (define handlers/scoped/nondet/h-ctl-flip
    (λ (nondet)
      (match nondet
        [(handlers/scoped/h-Hnd-nondet _ _ h-x) h-x])))
  (define handlers/scoped/flip/h-select
    (λ (hnd)
      (match hnd
        [(handlers/scoped/h-Hnd-nondet _ _ h-ctl-flip) h-ctl-flip])))
  (define handlers/scoped/flip
    (λ ()
      (perform handlers/scoped/nondet flip)))
  (define handlers/scoped/nondet/h-ctl-fail
    (λ (nondet)
      (match nondet
        [(handlers/scoped/h-Hnd-nondet _ h-x _) h-x])))
  (define handlers/scoped/fail/h-select
    (λ (hnd)
      (match hnd
        [(handlers/scoped/h-Hnd-nondet _ h-ctl-fail _) h-ctl-fail])))
  (define handlers/scoped/fail
    (λ ()
      (perform handlers/scoped/nondet fail)))
  (define handlers/scoped/select
    (λ (xs)
      (match xs
        [std/core/types/Nil (handlers/scoped/fail)]
        [(std/core/types/Cons x xx) (match (handlers/scoped/flip)
          [std/core/types/True x]
          [std/core/types/False (handlers/scoped/select xx)])])))
  (define handlers/scoped/knapsack
    (λ (w vs)
      (match (std/core/int/< w 0)
        [std/core/types/True (handlers/scoped/fail)]
        [std/core/types/False (match (std/core/int/== w 0)
          [std/core/types/True std/core/types/Nil]
          [std/core/types/False (letrec* ([v (handlers/scoped/select vs)])
            (std/core/types/Cons v (handlers/scoped/knapsack (std/core/int/- w v) vs)))])])))
  (define handlers/scoped/solutions
    (λ (h-action)
      (handlers/scoped/nondet/h-handle (handler handlers/scoped/h-Hnd-nondet [ctl fail (std/core/hnd/clause-control0 (λ (resume)
        std/core/types/Nil))] [ctl flip (std/core/hnd/clause-control0 (λ (resume)
        (std/core/list/++ (resume std/core/types/True) (resume std/core/types/False))))]) (λ (x)
        (std/core/types/Cons x std/core/types/Nil)) h-action)))
  (define handlers/scoped/example1
    (λ ()
      (handlers/scoped/solutions (λ ()
        (handlers/scoped/knapsack 3 (std/core/types/Cons 3 (std/core/types/Cons 2 (std/core/types/Cons 1 std/core/types/Nil))))))))
  (define handlers/scoped/state/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/scoped/state/h-tag hnd ret action)))
  (define handlers/scoped/state/h-fun-get
    (λ (state)
      (match state
        [(handlers/scoped/h-Hnd-state _ h-x _) h-x])))
  (define handlers/scoped/get/h-select
    (λ (hnd)
      (match hnd
        [(handlers/scoped/h-Hnd-state _ h-fun-get _) h-fun-get])))
  (define handlers/scoped/get
    (λ ()
      (perform handlers/scoped/state get)))
  (define handlers/scoped/state/h-fun-put
    (λ (state)
      (match state
        [(handlers/scoped/h-Hnd-state _ _ h-x) h-x])))
  (define handlers/scoped/put/h-select
    (λ (hnd)
      (match hnd
        [(handlers/scoped/h-Hnd-state _ _ h-fun-put) h-fun-put])))
  (define handlers/scoped/put
    (λ (i)
      (perform handlers/scoped/state put i)))
  (define handlers/scoped/state
    (λ (init action)
      (std/core/types/local-scope (λ ()
        (letrec* ([ievh-1454 std/core/types/h-Hnodiv] [ievh-1529 std/core/types/h-Hnodiv] [ievh-1587 std/core/types/h-Hnodiv])
          (std/core/hnd/local-var init (λ (s)
            ((λ (h-action)
              (handlers/scoped/state/h-handle (handler handlers/scoped/h-Hnd-state [fun get (std/core/hnd/clause-tail0 (λ ()
                (std/core/types/local-get s ievh-1529)))] [fun put (std/core/hnd/clause-tail1 (λ (i)
                (std/core/types/local-set s i)))]) (λ (x)
                (std/core/types/Tuple2 (std/core/types/local-get s ievh-1587) x)) h-action)) (λ ()
              (std/core/hnd/h-mask-builtin (λ ()
                (action))))))))))))
  (define handlers/scoped/incr
    (λ (i)
      (letrec* ([h-uniq-ih-1647 (match i
        [(std/core/types/h-Optional h-uniq-ih-1648) h-uniq-ih-1648]
        [std/core/types/h-None 1])])
        (handlers/scoped/put (std/core/int/+ (handlers/scoped/get) h-uniq-ih-1647)))))
  (define handlers/scoped/local
    (λ (s action)
      (handlers/scoped/solutions (λ ()
        (handlers/scoped/state s (λ ()
          (action)))))))
  (define handlers/scoped/global
    (λ (s action)
      (handlers/scoped/state s (λ ()
        (handlers/scoped/solutions (λ ()
          (action)))))))
  (define handlers/scoped/choices
    (λ (h-action)
      (handlers/scoped/nondet/h-handle (handler handlers/scoped/h-Hnd-nondet [ctl fail (std/core/hnd/clause-control0 (λ (resume)
        (handlers/scoped/fail)))] [ctl flip (std/core/hnd/clause-tail0 (λ ()
        (letrec* ([_ (handlers/scoped/incr std/core/types/h-None)])
          (handlers/scoped/flip))))]) (λ (h-res)
        h-res) h-action)))
  (define handlers/scoped/state-show
    (λ (x h-implicit/show)
      (std/core/types/++ "(state=" (std/core/types/++ (std/core/int/show (std/core/types/tuple2/fst x)) (std/core/types/++ ", " (std/core/types/++ (h-implicit/show (std/core/types/tuple2/snd x)) ")"))))))
  (define handlers/scoped/example2
    (λ ()
      (handlers/scoped/global 0 (λ ()
        (handlers/scoped/choices (λ ()
          (handlers/scoped/knapsack 3 (std/core/types/Cons 3 (std/core/types/Cons 2 (std/core/types/Cons 1 std/core/types/Nil))))))))))
  (define handlers/scoped/example3
    (λ ()
      (handlers/scoped/local 0 (λ ()
        (handlers/scoped/choices (λ ()
          (handlers/scoped/knapsack 3 (std/core/types/Cons 3 (std/core/types/Cons 2 (std/core/types/Cons 1 std/core/types/Nil))))))))))
  (define handlers/scoped/cutfail/h-ctl-cutfail
    (λ (cutfail)
      (match cutfail
        [(handlers/scoped/h-Hnd-cutfail _ h-x) h-x])))
  (define handlers/scoped/cutfail/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/scoped/cutfail/h-tag hnd ret action)))
  (define handlers/scoped/cutfail/h-select
    (λ (hnd)
      (match hnd
        [(handlers/scoped/h-Hnd-cutfail _ h-ctl-cutfail) h-ctl-cutfail])))
  (define handlers/scoped/cutfail
    (λ ()
      (perform handlers/scoped/cutfail cutfail)))
  (define handlers/scoped/cut
    (λ ()
      (match (handlers/scoped/flip)
        [std/core/types/True std/core/types/Unit]
        [std/core/types/False (handlers/scoped/cutfail)])))
  (define handlers/scoped/hcutfail
    (λ (action)
      ((λ (h-action)
        (handlers/scoped/cutfail/h-handle (handler handlers/scoped/h-Hnd-cutfail [ctl cutfail (std/core/hnd/clause-control0 (λ (resume)
          (handlers/scoped/fail)))]) (λ (h-res)
          h-res) h-action)) (λ ()
        (action)))))
  (define handlers/scoped/collect
    (λ (action)
      (std/core/types/local-scope (λ ()
        (letrec* ([ievh-2640 std/core/types/h-Hdiv] [ievh-2843 std/core/types/h-Hdiv] [ievh-2869 std/core/types/h-Hdiv])
          (std/core/hnd/local-var (std/core/types/Cons handlers/scoped/fail std/core/types/Nil) (λ (q)
            ((λ (h-action)
              (handlers/scoped/nondet/h-handle (handler handlers/scoped/h-Hnd-nondet [ctl fail (letrec* ([ievh-2746 std/core/types/h-Hdiv])
                (std/core/hnd/clause-control0 (λ (resume)
                  (match (std/core/types/local-get q ievh-2746)
                    [std/core/types/Nil (handlers/scoped/fail)]
                    [(std/core/types/Cons p ps) (letrec* ([_ (std/core/types/local-set q ps)])
                      (p))]))))] [ctl flip (std/core/hnd/clause-control0 (λ (resume)
                (letrec* ([_ (std/core/types/local-set q (std/core/types/Cons (λ ()
                  (resume std/core/types/False)) (std/core/types/local-get q ievh-2843)))])
                  (resume std/core/types/True))))]) (λ (x)
                (match (handlers/scoped/flip)
                  [std/core/types/True x]
                  [std/core/types/False (match (std/core/types/local-get q ievh-2869)
                    [std/core/types/Nil (handlers/scoped/fail)]
                    [(std/core/types/Cons p ps) (letrec* ([_ (std/core/types/local-set q ps)])
                      (p))])])) h-action)) (λ ()
              (std/core/hnd/h-mask-builtin (λ ()
                (action))))))))))))
  (define handlers/scoped/call
    (λ (p)
      (handlers/scoped/hcutfail (λ ()
        (handlers/scoped/collect (λ ()
          (p)))))))
  (define handlers/scoped/once
    (λ (p)
      (handlers/scoped/call (λ ()
        (letrec* ([x (p)] [_ (handlers/scoped/cut)])
          x)))))
  (define handlers/scoped/example4
    (λ ()
      (handlers/scoped/solutions (λ ()
        (handlers/scoped/once (λ ()
          (handlers/scoped/knapsack 3 (std/core/types/Cons 3 (std/core/types/Cons 2 (std/core/types/Cons 1 std/core/types/Nil))))))))))
  (define handlers/scoped/symbol/h-fun-symbol
    (λ (symbol)
      (match symbol
        [(handlers/scoped/h-Hnd-symbol _ h-x) h-x])))
  (define handlers/scoped/symbol/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle handlers/scoped/symbol/h-tag hnd ret action)))
  (define handlers/scoped/symbol/h-select
    (λ (hnd)
      (match hnd
        [(handlers/scoped/h-Hnd-symbol _ h-fun-symbol) h-fun-symbol])))
  (define handlers/scoped/symbol
    (λ (s)
      (perform handlers/scoped/symbol symbol s)))
  (define handlers/scoped/parse
    (λ (input action)
      (std/core/types/local-scope (λ ()
        (letrec* ([ievh-3331 std/core/types/h-Hnodiv] [ievh-3417 std/core/types/h-Hnodiv] [ievh-3471 std/core/types/h-Hnodiv])
          (std/core/hnd/local-var input (λ (cs)
            ((λ (h-action)
              (handlers/scoped/symbol/h-handle (handler handlers/scoped/h-Hnd-symbol [fun symbol (std/core/hnd/clause-tail1 (λ (s)
                (match (std/core/sslice/starts-with (std/core/types/local-get cs ievh-3417) s)
                  [std/core/types/Nothing (handlers/scoped/fail)]
                  [(std/core/types/Just (as rest (std/core/sslice/Sslice _ _ _))) (letrec* ([_ (std/core/types/local-set cs (std/core/sslice/string rest))])
                    s)])))]) (λ (x)
                (match (std/core/string/is-empty (std/core/types/local-get cs ievh-3471))
                  [std/core/types/True x]
                  [std/core/types/False (handlers/scoped/fail)])) h-action)) (λ ()
              (std/core/hnd/h-mask-builtin (λ ()
                (action))))))))))))
  (define handlers/scoped/digits
    (std/core/list/map (std/core/list/range/list 0 9) std/core/int/show))
  (define handlers/scoped/digit
    (λ ()
      (handlers/scoped/symbol (handlers/scoped/select handlers/scoped/digits))))
  (define handlers/scoped/choice
    (λ (p1 p2)
      (match (handlers/scoped/flip)
        [std/core/types/True (p1)]
        [std/core/types/False (p2)])))
  (define handlers/scoped/many
    (λ (p)
      (handlers/scoped/choice (λ ()
        (handlers/scoped/many1 p)) (λ ()
        std/core/types/Nil))))
  (define handlers/scoped/many1
    (λ (p)
      (std/core/types/Cons (p) (handlers/scoped/many p))))
  (define handlers/scoped/number
    (λ ()
      (letrec* ([ds (handlers/scoped/many1 handlers/scoped/digit)])
        (std/core/maybe/default (std/core/int/parse-int (std/core/list/concat/join ds) std/core/types/h-None) 0))))
  (define handlers/scoped/expr
    (λ ()
      (handlers/scoped/choice (λ ()
        (letrec* ([i (handlers/scoped/term)] [_ (handlers/scoped/symbol "+")] [j (handlers/scoped/term)])
          (std/core/int/+ i j))) (λ ()
        (handlers/scoped/term)))))
  (define handlers/scoped/factor
    (λ ()
      (handlers/scoped/choice handlers/scoped/number (λ ()
        (letrec* ([_ (handlers/scoped/symbol "(")] [i (handlers/scoped/expr)] [_ (handlers/scoped/symbol ")")])
          i)))))
  (define handlers/scoped/term
    (λ ()
      (handlers/scoped/choice (λ ()
        (letrec* ([i (handlers/scoped/factor)] [_ (handlers/scoped/symbol "*")] [j (handlers/scoped/factor)])
          (std/core/int/* i j))) (λ ()
        (handlers/scoped/factor)))))
  (define handlers/scoped/example5
    (λ ()
      (handlers/scoped/solutions (λ ()
        (handlers/scoped/parse "2+8*5" (λ ()
          (handlers/scoped/expr)))))))
  (define handlers/scoped/main
    (λ ()
      (letrec* ([_ (std/core/console/string/println (std/core/list/show (handlers/scoped/example1) (λ (h-arg-x1)
        (std/core/list/show h-arg-x1 std/core/int/show))))] [_ (std/core/console/string/println (handlers/scoped/state-show (handlers/scoped/example2) (λ (h-arg-x1)
        (std/core/list/show h-arg-x1 (λ (h-arg-x1)
          (std/core/list/show h-arg-x1 std/core/int/show))))))] [_ (std/core/console/string/println (std/core/list/show (handlers/scoped/example3) (λ (h-arg-x1)
        (handlers/scoped/state-show h-arg-x1 (λ (h-arg-x1)
          (std/core/list/show h-arg-x1 std/core/int/show))))))] [_ (std/core/console/string/println (std/core/list/show (handlers/scoped/example4) (λ (h-arg-x1)
        (std/core/list/show h-arg-x1 std/core/int/show))))])
        (std/core/console/string/println (std/core/list/show (handlers/scoped/example5) std/core/int/show))))))