(module
  analysis/benchmarks/suite/complex-flow
  (define analysis/benchmarks/suite/complex-flow/ask/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle analysis/benchmarks/suite/complex-flow/ask/h-tag hnd ret action)))
  (define analysis/benchmarks/suite/complex-flow/ask/h-ctl-ask
    (λ (ask)
      (match ask
        [(analysis/benchmarks/suite/complex-flow/h-Hnd-ask _ h-x) h-x])))
  (define analysis/benchmarks/suite/complex-flow/ask/h-select
    (λ (hnd)
      (match hnd
        [(analysis/benchmarks/suite/complex-flow/h-Hnd-ask _ h-ctl-ask) h-ctl-ask])))
  (define analysis/benchmarks/suite/complex-flow/ask
    (λ ()
      (perform analysis/benchmarks/suite/complex-flow/ask ask)))
  (define analysis/benchmarks/suite/complex-flow/tell/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle analysis/benchmarks/suite/complex-flow/tell/h-tag hnd ret action)))
  (define analysis/benchmarks/suite/complex-flow/tell/h-ctl-tell
    (λ (tell)
      (match tell
        [(analysis/benchmarks/suite/complex-flow/h-Hnd-tell _ h-x) h-x])))
  (define analysis/benchmarks/suite/complex-flow/tell/h-select
    (λ (hnd)
      (match hnd
        [(analysis/benchmarks/suite/complex-flow/h-Hnd-tell _ h-ctl-tell) h-ctl-tell])))
  (define analysis/benchmarks/suite/complex-flow/tell
    (λ (msg)
      (perform analysis/benchmarks/suite/complex-flow/tell tell msg)))
  (define analysis/benchmarks/suite/complex-flow/normal-inc
    (λ (x)
      (std/core/int/+ x 1)))
  (define analysis/benchmarks/suite/complex-flow/normal-double
    (λ (x)
      (std/core/int/* x 2)))
  (define analysis/benchmarks/suite/complex-flow/analyze-complex-tail-call
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Complex 1 - tail call normal function")])
        ((λ (h-action)
          (analysis/benchmarks/suite/complex-flow/ask/h-handle (handler analysis/benchmarks/suite/complex-flow/h-Hnd-ask [ctl ask (std/core/hnd/clause-control0 (λ (resume)
            (analysis/benchmarks/suite/complex-flow/normal-inc (resume 1))))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (analysis/benchmarks/suite/complex-flow/ask))))))
  (define analysis/benchmarks/suite/complex-flow/result-complex-tail-call
    (λ ()
      2))
  (define analysis/benchmarks/suite/complex-flow/analyze-complex-non-tail-call
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Complex 2 - non-tail call normal function")])
        ((λ (h-action)
          (analysis/benchmarks/suite/complex-flow/ask/h-handle (handler analysis/benchmarks/suite/complex-flow/h-Hnd-ask [ctl ask (std/core/hnd/clause-control0 (λ (resume)
            (letrec* ([x (resume 1)])
              (std/core/int/+ (analysis/benchmarks/suite/complex-flow/normal-inc x) 1))))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (analysis/benchmarks/suite/complex-flow/ask))))))
  (define analysis/benchmarks/suite/complex-flow/result-complex-non-tail-call
    (λ ()
      3))
  (define analysis/benchmarks/suite/complex-flow/tail-ask
    (λ ()
      (analysis/benchmarks/suite/complex-flow/ask)))
  (define analysis/benchmarks/suite/complex-flow/analyze-complex-tail-effect
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Complex 3 - tail call effect in normal function")])
        ((λ (h-action)
          (analysis/benchmarks/suite/complex-flow/ask/h-handle (handler analysis/benchmarks/suite/complex-flow/h-Hnd-ask [ctl ask (std/core/hnd/clause-control0 (λ (resume)
            (resume 42)))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (analysis/benchmarks/suite/complex-flow/tail-ask))))))
  (define analysis/benchmarks/suite/complex-flow/result-complex-tail-effect
    (λ ()
      42))
  (define analysis/benchmarks/suite/complex-flow/analyze-complex-nested-interleave
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Complex 4 - nested handlers with normal functions")])
        ((λ (h-action)
          (analysis/benchmarks/suite/complex-flow/ask/h-handle (handler analysis/benchmarks/suite/complex-flow/h-Hnd-ask [ctl ask (std/core/hnd/clause-control0 (λ (resume)
            (resume 10)))]) (λ (h-res)
            h-res) h-action)) (λ ()
          ((λ (h-action)
            (analysis/benchmarks/suite/complex-flow/tell/h-handle (handler analysis/benchmarks/suite/complex-flow/h-Hnd-tell [ctl tell (std/core/hnd/clause-control1 (λ (x resume)
              (letrec* ([y (analysis/benchmarks/suite/complex-flow/ask)] [_ (resume std/core/types/Unit)])
                (std/core/int/+ y x))))]) (λ (h-res)
              h-res) h-action)) (λ ()
            (letrec* ([_ (analysis/benchmarks/suite/complex-flow/tell 5)])
              (analysis/benchmarks/suite/complex-flow/ask)))))))))
  (define analysis/benchmarks/suite/complex-flow/result-complex-nested-interleave
    (λ ()
      15))
  (define analysis/benchmarks/suite/complex-flow/fib-eff
    (λ (n)
      (match (std/core/int/<= n 1)
        [std/core/types/True (analysis/benchmarks/suite/complex-flow/ask)]
        [std/core/types/False (std/core/int/+ (analysis/benchmarks/suite/complex-flow/fib-eff (std/core/int/- n 1)) (analysis/benchmarks/suite/complex-flow/fib-eff (std/core/int/- n 2)))])))
  (define analysis/benchmarks/suite/complex-flow/analyze-complex-recursive
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Complex 5 - recursive function with effect")])
        ((λ (h-action)
          (analysis/benchmarks/suite/complex-flow/ask/h-handle (handler analysis/benchmarks/suite/complex-flow/h-Hnd-ask [ctl ask (std/core/hnd/clause-control0 (λ (resume)
            (resume 1)))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (analysis/benchmarks/suite/complex-flow/fib-eff 4))))))
  (define analysis/benchmarks/suite/complex-flow/result-complex-recursive
    (λ ()
      5))
  (define analysis/benchmarks/suite/complex-flow/choice/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle analysis/benchmarks/suite/complex-flow/choice/h-tag hnd ret action)))
  (define analysis/benchmarks/suite/complex-flow/choice/h-ctl-flip
    (λ (choice)
      (match choice
        [(analysis/benchmarks/suite/complex-flow/h-Hnd-choice _ h-x) h-x])))
  (define analysis/benchmarks/suite/complex-flow/flip/h-select
    (λ (hnd)
      (match hnd
        [(analysis/benchmarks/suite/complex-flow/h-Hnd-choice _ h-ctl-flip) h-ctl-flip])))
  (define analysis/benchmarks/suite/complex-flow/flip
    (λ ()
      (perform analysis/benchmarks/suite/complex-flow/choice flip)))
  (define analysis/benchmarks/suite/complex-flow/fail/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle analysis/benchmarks/suite/complex-flow/fail/h-tag hnd ret action)))
  (define analysis/benchmarks/suite/complex-flow/fail/h-ctl-fail
    (λ (fail)
      (match fail
        [(analysis/benchmarks/suite/complex-flow/h-Hnd-fail _ h-x) h-x])))
  (define analysis/benchmarks/suite/complex-flow/fail/h-select
    (λ (hnd)
      (match hnd
        [(analysis/benchmarks/suite/complex-flow/h-Hnd-fail _ h-ctl-fail) h-ctl-fail])))
  (define analysis/benchmarks/suite/complex-flow/fail
    (λ ()
      (perform analysis/benchmarks/suite/complex-flow/fail fail)))
  (define analysis/benchmarks/suite/complex-flow/analyze-complex-layers
    (λ ()
      (std/core/types/local-scope (λ ()
        (letrec* ([ievh-1625 std/core/types/h-Hnodiv] [ievh-1754 std/core/types/h-Hnodiv] [_ (std/core/debug/trace "Complex 6 - 3 layers: state, choice, fail")])
          (std/core/hnd/local-var 0 (λ (s)
            ((λ (h-action)
              (analysis/benchmarks/suite/complex-flow/choice/h-handle (handler analysis/benchmarks/suite/complex-flow/h-Hnd-choice [ctl flip (std/core/hnd/clause-control0 (λ (resume)
                (letrec* ([_ (std/core/types/local-set s (std/core/int/+ (std/core/types/local-get s ievh-1625) 1))] [r1 (resume std/core/types/True)] [r2 (resume std/core/types/False)])
                  (std/core/int/+ r1 r2))))]) (λ (x)
                x) h-action)) (λ ()
              ((λ (h-action)
                (analysis/benchmarks/suite/complex-flow/fail/h-handle (handler analysis/benchmarks/suite/complex-flow/h-Hnd-fail [ctl fail (std/core/hnd/clause-control0 (λ (resume)
                  0))]) (λ (h-res)
                  h-res) h-action)) (λ ()
                (match (analysis/benchmarks/suite/complex-flow/flip)
                  [std/core/types/True (match (analysis/benchmarks/suite/complex-flow/flip)
                    [std/core/types/True (letrec* ([_ (std/core/types/local-set s (std/core/int/+ (std/core/types/local-get s ievh-1754) 10))])
                      1)]
                    [std/core/types/False (analysis/benchmarks/suite/complex-flow/fail)])]
                  [std/core/types/False 2]))))))))))))
  (define analysis/benchmarks/suite/complex-flow/result-complex-layers
    (λ ()
      3))
  (define analysis/benchmarks/suite/complex-flow/apply-cont
    (λ (f x)
      (f x)))
  (define analysis/benchmarks/suite/complex-flow/analyze-complex-resume-func
    (λ ()
      (letrec* ([_ (std/core/debug/trace "Complex 7 - resume passed as function")])
        ((λ (h-action)
          (analysis/benchmarks/suite/complex-flow/ask/h-handle (handler analysis/benchmarks/suite/complex-flow/h-Hnd-ask [ctl ask (std/core/hnd/clause-control0 (λ (resume)
            (analysis/benchmarks/suite/complex-flow/apply-cont resume 10)))]) (λ (h-res)
            h-res) h-action)) (λ ()
          (std/core/int/+ (analysis/benchmarks/suite/complex-flow/ask) 1))))))
  (define analysis/benchmarks/suite/complex-flow/result-complex-resume-func
    (λ ()
      11))
  (define analysis/benchmarks/suite/complex-flow/test-complex-tail-call
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/complex-flow/analyze-complex-tail-call)])
        (match (std/core/int/== result (analysis/benchmarks/suite/complex-flow/result-complex-tail-call))
          [std/core/types/True (std/core/console/string/println "✓ test-complex-tail-call passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-complex-tail-call FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/complex-flow/result-complex-tail-call)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/complex-flow/test-complex-non-tail-call
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/complex-flow/analyze-complex-non-tail-call)])
        (match (std/core/int/== result (analysis/benchmarks/suite/complex-flow/result-complex-non-tail-call))
          [std/core/types/True (std/core/console/string/println "✓ test-complex-non-tail-call passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-complex-non-tail-call FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/complex-flow/result-complex-non-tail-call)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/complex-flow/test-complex-tail-effect
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/complex-flow/analyze-complex-tail-effect)])
        (match (std/core/int/== result (analysis/benchmarks/suite/complex-flow/result-complex-tail-effect))
          [std/core/types/True (std/core/console/string/println "✓ test-complex-tail-effect passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-complex-tail-effect FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/complex-flow/result-complex-tail-effect)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/complex-flow/test-complex-nested-interleave
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/complex-flow/analyze-complex-nested-interleave)])
        (match (std/core/int/== result (analysis/benchmarks/suite/complex-flow/result-complex-nested-interleave))
          [std/core/types/True (std/core/console/string/println "✓ test-complex-nested-interleave passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-complex-nested-interleave FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/complex-flow/result-complex-nested-interleave)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/complex-flow/test-complex-recursive
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/complex-flow/analyze-complex-recursive)])
        (match (std/core/int/== result (analysis/benchmarks/suite/complex-flow/result-complex-recursive))
          [std/core/types/True (std/core/console/string/println "✓ test-complex-recursive passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-complex-recursive FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/complex-flow/result-complex-recursive)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/complex-flow/test-complex-layers
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/complex-flow/analyze-complex-layers)])
        (match (std/core/int/== result (analysis/benchmarks/suite/complex-flow/result-complex-layers))
          [std/core/types/True (std/core/console/string/println "✓ test-complex-layers passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-complex-layers FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/complex-flow/result-complex-layers)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/complex-flow/test-complex-resume-func
    (λ ()
      (letrec* ([result (analysis/benchmarks/suite/complex-flow/analyze-complex-resume-func)])
        (match (std/core/int/== result (analysis/benchmarks/suite/complex-flow/result-complex-resume-func))
          [std/core/types/True (std/core/console/string/println "✓ test-complex-resume-func passed")]
          [std/core/types/False (std/core/console/string/println (std/core/types/++ "✗ test-complex-resume-func FAILED: expected " (std/core/types/++ (std/core/int/show (analysis/benchmarks/suite/complex-flow/result-complex-resume-func)) (std/core/types/++ ", got " (std/core/int/show result)))))]))))
  (define analysis/benchmarks/suite/complex-flow/main
    (λ ()
      (letrec* ([_ (std/core/console/string/println "Running complex-flow tests...")] [_ (analysis/benchmarks/suite/complex-flow/test-complex-tail-call)] [_ (analysis/benchmarks/suite/complex-flow/test-complex-non-tail-call)] [_ (analysis/benchmarks/suite/complex-flow/test-complex-tail-effect)] [_ (analysis/benchmarks/suite/complex-flow/test-complex-nested-interleave)] [_ (analysis/benchmarks/suite/complex-flow/test-complex-recursive)] [_ (analysis/benchmarks/suite/complex-flow/test-complex-layers)] [_ (analysis/benchmarks/suite/complex-flow/test-complex-resume-func)])
        (std/core/console/string/println "complex-flow tests complete")))))