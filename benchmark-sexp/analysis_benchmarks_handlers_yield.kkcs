(module
  analysis/benchmarks/handlers/yield
  (define analysis/benchmarks/handlers/yield/yield/h-tag
    "yield@yield")
  (define analysis/benchmarks/handlers/yield/yield/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle analysis/benchmarks/handlers/yield/yield/h-tag hnd ret action)))
  (define analysis/benchmarks/handlers/yield/yield/h-fun-yield
    (λ (yield)
      (match yield
        [(analysis/benchmarks/handlers/yield/yield _ h-x) h-x])))
  (define analysis/benchmarks/handlers/yield/yield/h-select
    (λ (hnd)
      (match hnd
        [(analysis/benchmarks/handlers/yield/yield _ h-fun-yield) h-fun-yield])))
  (define analysis/benchmarks/handlers/yield/yield
    (λ (x)
      (perform analysis/benchmarks/handlers/yield/yield yield x)))
  (define analysis/benchmarks/handlers/yield/traverse
    (λ (xs)
      (match xs
        [(std/core/types/Cons x xx) (letrec* ([_ (analysis/benchmarks/handlers/yield/yield x)])
          (analysis/benchmarks/handlers/yield/traverse xx))]
        [std/core/types/Nil std/core/types/Unit])))
  (define analysis/benchmarks/handlers/yield/analyze-main
    (λ ()
      ((λ (h-action)
        (analysis/benchmarks/handlers/yield/yield/h-handle (handler analysis/benchmarks/handlers/yield/yield [fun yield (λ (i)
          (std/core/console/string/println (std/core/types/++ "yielded " (std/core/int/show i))))]) (λ (h-res)
          h-res) h-action)) (λ ()
        (letrec* ([_ (analysis/benchmarks/handlers/yield/traverse (std/core/types/Cons 1 (std/core/types/Cons 2 (std/core/types/Cons 3 std/core/types/Nil))))])
          (std/core/console/string/println "done"))))))
  (define analysis/benchmarks/handlers/yield/result-main
    (λ ()
      std/core/types/Unit)))