(module
  std/os/dir
  (define std/os/dir/prepend
    (λ (exn pre)
      (std/core/exn/Exception (std/core/types/++ pre (std/core/types/++ ": " (std/core/exn/exception/message exn))) (std/core/exn/exception/info exn))))
  (define std/os/dir/prim-copy-file
    (λ (from to preserve-mtime)
      (std/os/dir/h-extern-prim-copy-file from to preserve-mtime)))
  (define std/os/dir/copy-file
    (λ (from to preserve-mtime)
      (letrec* ([h-uniq-preserve-mtimeh-100 (match preserve-mtime
        [(std/core/types/h-Optional h-uniq-preserve-mtimeh-101) h-uniq-preserve-mtimeh-101]
        [std/core/types/h-None std/core/types/True])])
        (match (std/os/dir/prim-copy-file (std/os/path/string from) (std/os/path/string to) h-uniq-preserve-mtimeh-100)
          [(std/core/exn/Error (as exn (std/core/exn/Exception _ _))) (std/core/exn/throw-exn (std/os/dir/prepend exn (std/core/types/++ "unable to copy " (std/core/types/++ (std/os/path/show from) (std/core/types/++ " to " (std/os/path/show to))))))]
          [_ std/core/types/Unit]))))
  (define std/os/dir/ensure-dir-err
    (λ (path mode)
      (std/os/dir/h-extern-ensure-dir-err path mode)))
  (define std/os/dir/ensure-dir
    (λ (dir)
      (match (std/os/dir/ensure-dir-err (std/os/path/string dir) -1)
        [(std/core/exn/Error (as exn (std/core/exn/Exception _ _))) (std/core/exn/throw-exn (std/os/dir/prepend exn (std/core/types/++ "unable to create directory " (std/os/path/show dir))))]
        [(std/core/exn/Ok std/core/types/Unit) std/core/types/Unit])))
  (define std/os/dir/prim-is-dir
    (λ (dir)
      (std/os/dir/h-extern-prim-is-dir dir)))
  (define std/os/dir/is-directory
    (λ (dir)
      (std/os/dir/prim-is-dir (std/os/path/string dir))))
  (define std/os/dir/prim-list-dir
    (λ (dir)
      (std/os/dir/h-extern-prim-list-dir dir)))
  (define std/os/dir/list-directory
    (λ (dir)
      (match (std/os/dir/prim-list-dir (std/os/path/string dir))
        [(std/core/exn/Error (as exn (std/core/exn/Exception _ _))) (std/core/exn/throw-exn exn)]
        [(std/core/exn/Ok contents) (std/core/list/map (std/core/vector/list contents) (λ (name)
          (std/os/path// dir (std/os/path/path name))))])))
  (define std/os/dir/list-directory-recursive
    (λ (dir max-depth)
      (letrec* ([h-uniq-max-depthh-547 (match max-depth
        [(std/core/types/h-Optional h-uniq-max-depthh-548) h-uniq-max-depthh-548]
        [std/core/types/h-None 1000])])
        (match (std/core/int/< h-uniq-max-depthh-547 0)
          [std/core/types/True std/core/types/Nil]
          [std/core/types/False (letrec* ([_ std/core/types/Unit] [all (std/os/dir/list-directory dir)] [dirs (std/core/list/filter all std/os/dir/is-directory)])
            (std/core/list/++ all (std/core/list/flatmap dirs (λ (sub)
              (std/os/dir/list-directory-recursive sub (std/core/types/h-Optional (std/core/int/- h-uniq-max-depthh-547 1)))))))]))))
  (define std/os/dir/copy-directory
    (λ (dir to)
      (letrec* ([_ (std/os/dir/ensure-dir to)] [all (std/os/dir/list-directory dir)])
        (match (std/core/list/partition all std/os/dir/is-directory)
          [(std/core/types/Tuple2 dirs files) (letrec* ([_ (std/core/list/foreach files (λ (f)
            (std/os/dir/copy-file f (std/os/path// to (std/os/path/nodir f)) std/core/types/h-None)))])
            (std/core/list/foreach dirs (λ (d)
              (std/os/dir/copy-directory d (std/os/path// to (std/os/path/nodir d))))))]))))
  (define std/os/dir/copy-file-to-dir
    (λ (from dir)
      (std/os/dir/copy-file from (std/os/path// dir (std/os/path/nodir from)) std/core/types/h-None)))
  (define std/os/dir/prim-is-file
    (λ (path)
      (std/os/dir/h-extern-prim-is-file path)))
  (define std/os/dir/is-file
    (λ (path)
      (std/os/dir/prim-is-file (std/os/path/string path)))))