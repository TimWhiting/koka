    (def analysis/benchmarks/koka-gen/interp/run-safe
      (fn (action)
        ((fn (h-action)
          (std/core/exn/exn/h-handle ((std/core/exn/h-Hnd-exn (0 (std/core/hnd/clause-never1 ((fn (msg)
            (std/core/types/++ ("FAILURE: " (std/core/exn/show (msg))))))))) (fn (x)
            (std/core/types/++ ("Success: " (analysis/benchmarks/koka-gen/interp/show-value (x))))) h-action))) ((fn ()
          (action ()))))))
    (def analysis/benchmarks/koka-gen/interp/eval
      (fn (t)
        (match t
          [(analysis/benchmarks/koka-gen/interp/Lit i) (analysis/benchmarks/koka-gen/interp/VInt (i))]
          [(analysis/benchmarks/koka-gen/interp/Var x) (analysis/benchmarks/koka-gen/interp/lookup (x))]
          [(analysis/benchmarks/koka-gen/interp/Add l r) (match (std/core/types/Tuple2 ((analysis/benchmarks/koka-gen/interp/eval (l)) (analysis/benchmarks/koka-gen/interp/eval (r))))
            [(std/core/types/Tuple2 (analysis/benchmarks/koka-gen/interp/VInt i1) (analysis/benchmarks/koka-gen/interp/VInt i2)) (analysis/benchmarks/koka-gen/interp/VInt ((std/core/int/+ (i1 i2))))]
            [_ (std/core/exn/throw ("Type Error: Add expects integers" std/core/types/h-None))])]
          [(analysis/benchmarks/koka-gen/interp/Lam p b) (letrec* ([captured (analysis/benchmarks/koka-gen/interp/snapshot ())])
            (analysis/benchmarks/koka-gen/interp/VClos (p b captured)))]
          [(analysis/benchmarks/koka-gen/interp/App f a) (letrec* ([func-val (analysis/benchmarks/koka-gen/interp/eval (f))] [arg-val (analysis/benchmarks/koka-gen/interp/eval (a))])
            (match func-val
              [(analysis/benchmarks/koka-gen/interp/VClos param body saved-env) (letrec* ([new-env (std/core/types/Cons ((std/core/types/Tuple2 (param arg-val)) saved-env))])
                (analysis/benchmarks/koka-gen/interp/run-env (new-env (fn ()
                  (analysis/benchmarks/koka-gen/interp/eval (body))))))]
              [(analysis/benchmarks/koka-gen/interp/VInt _) (std/core/exn/throw ("Type Error: App expects a function" std/core/types/h-None))]))])))
    (def analysis/benchmarks/koka-gen/interp/analyze-interp
      (fn ()
        (letrec* ([ex (analysis/benchmarks/koka-gen/interp/App ((analysis/benchmarks/koka-gen/interp/Lam ("x" (analysis/benchmarks/koka-gen/interp/App ((analysis/benchmarks/koka-gen/interp/Lam ("y" (analysis/benchmarks/koka-gen/interp/Add ((analysis/benchmarks/koka-gen/interp/Var ("x")) (analysis/benchmarks/koka-gen/interp/Var ("y")))))) (analysis/benchmarks/koka-gen/interp/Lit (20)))))) (analysis/benchmarks/koka-gen/interp/Lit (10))))])
          (analysis/benchmarks/koka-gen/interp/run-safe ((fn ()
            (analysis/benchmarks/koka-gen/interp/run-env (std/core/types/Nil (fn ()
              (analysis/benchmarks/koka-gen/interp/eval (ex)))))))))))
