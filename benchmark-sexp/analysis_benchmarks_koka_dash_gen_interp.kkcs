    (def analysis/benchmarks/koka-gen/interp/run-env
      (fn (current-env action)
        ((fn (h-action)
          (analysis/benchmarks/koka-gen/interp/env/h-handle ((analysis/benchmarks/koka-gen/interp/h-Hnd-env (3 (std/core/hnd/clause-control1 ((fn (name resume)
            (match (std/core/list/find (current-env (fn (entry)
              (std/core/string/== ((std/core/types/tuple2/fst (entry)) name)))))
              [(std/core/types/Just (std/core/types/Tuple2 _ v)) (resume (v))]
              [std/core/types/Nothing (std/core/exn/throw ((std/core/types/++ ("Runtime Error: Variable '" (std/core/types/++ (name "' not found")))) std/core/types/h-None))])))) (std/core/hnd/clause-control0 ((fn (resume)
            (resume (current-env))))))) (fn (h-res)
            h-res) h-action))) (action))))
