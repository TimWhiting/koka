    (def analysis/benchmarks/koka-gen/interp/main
      (fn ()
        (letrec* ([_ (std/core/console/string/println ("--- Koka Interpreter (Handler Stacking) ---"))] [ex (analysis/benchmarks/koka-gen/interp/App ((analysis/benchmarks/koka-gen/interp/Lam ("x" (analysis/benchmarks/koka-gen/interp/App ((analysis/benchmarks/koka-gen/interp/Lam ("y" (analysis/benchmarks/koka-gen/interp/Add ((analysis/benchmarks/koka-gen/interp/Var ("x")) (analysis/benchmarks/koka-gen/interp/Var ("y")))))) (analysis/benchmarks/koka-gen/interp/Lit (20)))))) (analysis/benchmarks/koka-gen/interp/Lit (10))))] [result (analysis/benchmarks/koka-gen/interp/run-safe ((fn ()
          (analysis/benchmarks/koka-gen/interp/run-env (std/core/types/Nil (fn ()
            (analysis/benchmarks/koka-gen/interp/eval (ex))))))))])
          (std/core/console/string/println (result)))))))