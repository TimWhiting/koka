(module
  analysis/benchmarks/koka-gen/interp
  (define analysis/benchmarks/koka-gen/interp/is-lit
    (λ (term)
      (match term
        [(analysis/benchmarks/koka-gen/interp/Lit _) std/core/types/True]
        [_ std/core/types/False])))
  (define analysis/benchmarks/koka-gen/interp/is-var
    (λ (term)
      (match term
        [(analysis/benchmarks/koka-gen/interp/Var _) std/core/types/True]
        [_ std/core/types/False])))
  (define analysis/benchmarks/koka-gen/interp/is-add
    (λ (term)
      (match term
        [(analysis/benchmarks/koka-gen/interp/Add _ _) std/core/types/True]
        [_ std/core/types/False])))
  (define analysis/benchmarks/koka-gen/interp/is-lam
    (λ (term)
      (match term
        [(analysis/benchmarks/koka-gen/interp/Lam _ _) std/core/types/True]
        [_ std/core/types/False])))
  (define analysis/benchmarks/koka-gen/interp/is-app
    (λ (term)
      (match term
        [(analysis/benchmarks/koka-gen/interp/App _ _) std/core/types/True]
        [_ std/core/types/False])))
  (define analysis/benchmarks/koka-gen/interp/is-vint
    (λ (value)
      (match value
        [(analysis/benchmarks/koka-gen/interp/VInt _) std/core/types/True]
        [(analysis/benchmarks/koka-gen/interp/VClos _ _ _) std/core/types/False])))
  (define analysis/benchmarks/koka-gen/interp/is-vclos
    (λ (value)
      (match value
        [(analysis/benchmarks/koka-gen/interp/VClos _ _ _) std/core/types/True]
        [(analysis/benchmarks/koka-gen/interp/VInt _) std/core/types/False])))
  (define analysis/benchmarks/koka-gen/interp/env/h-handle
    (λ (hnd ret action)
      (std/core/hnd/h-hhandle analysis/benchmarks/koka-gen/interp/env/h-tag hnd ret action)))
  (define analysis/benchmarks/koka-gen/interp/env/h-ctl-lookup
    (λ (env)
      (match env
        [(analysis/benchmarks/koka-gen/interp/h-Hnd-env _ h-x _) h-x])))
  (define analysis/benchmarks/koka-gen/interp/lookup/h-select
    (λ (hnd)
      (match hnd
        [(analysis/benchmarks/koka-gen/interp/h-Hnd-env _ h-ctl-lookup _) h-ctl-lookup])))
  (define analysis/benchmarks/koka-gen/interp/lookup
    (λ (name)
      (perform analysis/benchmarks/koka-gen/interp/env lookup name)))
  (define analysis/benchmarks/koka-gen/interp/env/h-ctl-snapshot
    (λ (env)
      (match env
        [(analysis/benchmarks/koka-gen/interp/h-Hnd-env _ _ h-x) h-x])))
  (define analysis/benchmarks/koka-gen/interp/snapshot/h-select
    (λ (hnd)
      (match hnd
        [(analysis/benchmarks/koka-gen/interp/h-Hnd-env _ _ h-ctl-snapshot) h-ctl-snapshot])))
  (define analysis/benchmarks/koka-gen/interp/snapshot
    (λ ()
      (perform analysis/benchmarks/koka-gen/interp/env snapshot)))
  (define analysis/benchmarks/koka-gen/interp/run-env
    (λ (current-env action)
      ((λ (h-action)
        (analysis/benchmarks/koka-gen/interp/env/h-handle (handler analysis/benchmarks/koka-gen/interp/h-Hnd-env [ctl lookup (std/core/hnd/clause-control1 (λ (name resume)
          (match (std/core/list/find current-env (λ (entry)
            (std/core/string/== (std/core/types/tuple2/fst entry) name)))
            [(std/core/types/Just (std/core/types/Tuple2 _ v)) (resume v)]
            [std/core/types/Nothing (std/core/exn/throw (std/core/types/++ "Runtime Error: Variable '" (std/core/types/++ name "' not found")) std/core/types/h-None)])))] [ctl snapshot (std/core/hnd/clause-control0 (λ (resume)
          (resume current-env)))]) (λ (h-res)
          h-res) h-action)) action)))
  (define analysis/benchmarks/koka-gen/interp/show-value
    (λ (v)
      (match v
        [(analysis/benchmarks/koka-gen/interp/VInt i) (std/core/int/show i)]
        [(analysis/benchmarks/koka-gen/interp/VClos _ _ _) "<closure>"])))
  (define analysis/benchmarks/koka-gen/interp/run-safe
    (λ (action)
      ((λ (h-action)
        (std/core/exn/exn/h-handle (handler std/core/exn/h-Hnd-exn [?  (std/core/hnd/clause-never1 (λ (msg)
          (std/core/types/++ "FAILURE: " (std/core/exn/show msg))))]) (λ (x)
          (std/core/types/++ "Success: " (analysis/benchmarks/koka-gen/interp/show-value x))) h-action)) (λ ()
        (action)))))
  (define analysis/benchmarks/koka-gen/interp/eval
    (λ (t)
      (match t
        [(analysis/benchmarks/koka-gen/interp/Lit i) (analysis/benchmarks/koka-gen/interp/VInt i)]
        [(analysis/benchmarks/koka-gen/interp/Var x) (analysis/benchmarks/koka-gen/interp/lookup x)]
        [(analysis/benchmarks/koka-gen/interp/Add l r) (match (std/core/types/Tuple2 (analysis/benchmarks/koka-gen/interp/eval l) (analysis/benchmarks/koka-gen/interp/eval r))
          [(std/core/types/Tuple2 (analysis/benchmarks/koka-gen/interp/VInt i1) (analysis/benchmarks/koka-gen/interp/VInt i2)) (analysis/benchmarks/koka-gen/interp/VInt (std/core/int/+ i1 i2))]
          [_ (std/core/exn/throw "Type Error: Add expects integers" std/core/types/h-None)])]
        [(analysis/benchmarks/koka-gen/interp/Lam p b) (letrec* ([captured (analysis/benchmarks/koka-gen/interp/snapshot)])
          (analysis/benchmarks/koka-gen/interp/VClos p b captured))]
        [(analysis/benchmarks/koka-gen/interp/App f a) (letrec* ([func-val (analysis/benchmarks/koka-gen/interp/eval f)] [arg-val (analysis/benchmarks/koka-gen/interp/eval a)])
          (match func-val
            [(analysis/benchmarks/koka-gen/interp/VClos param body saved-env) (letrec* ([new-env (std/core/types/Cons (std/core/types/Tuple2 param arg-val) saved-env)])
              (analysis/benchmarks/koka-gen/interp/run-env new-env (λ ()
                (analysis/benchmarks/koka-gen/interp/eval body))))]
            [(analysis/benchmarks/koka-gen/interp/VInt _) (std/core/exn/throw "Type Error: App expects a function" std/core/types/h-None)]))])))
  (define analysis/benchmarks/koka-gen/interp/analyze-interp
    (λ ()
      (letrec* ([ex (analysis/benchmarks/koka-gen/interp/App (analysis/benchmarks/koka-gen/interp/Lam "x" (analysis/benchmarks/koka-gen/interp/App (analysis/benchmarks/koka-gen/interp/Lam "y" (analysis/benchmarks/koka-gen/interp/Add (analysis/benchmarks/koka-gen/interp/Var "x") (analysis/benchmarks/koka-gen/interp/Var "y"))) (analysis/benchmarks/koka-gen/interp/Lit 20))) (analysis/benchmarks/koka-gen/interp/Lit 10))])
        (analysis/benchmarks/koka-gen/interp/run-safe (λ ()
          (analysis/benchmarks/koka-gen/interp/run-env std/core/types/Nil (λ ()
            (analysis/benchmarks/koka-gen/interp/eval ex))))))))
  (define analysis/benchmarks/koka-gen/interp/result-interp
    (λ ()
      "Success: 30"))
  (define analysis/benchmarks/koka-gen/interp/main
    (λ ()
      (letrec* ([_ (std/core/console/string/println "--- Koka Interpreter (Handler Stacking) ---")] [ex (analysis/benchmarks/koka-gen/interp/App (analysis/benchmarks/koka-gen/interp/Lam "x" (analysis/benchmarks/koka-gen/interp/App (analysis/benchmarks/koka-gen/interp/Lam "y" (analysis/benchmarks/koka-gen/interp/Add (analysis/benchmarks/koka-gen/interp/Var "x") (analysis/benchmarks/koka-gen/interp/Var "y"))) (analysis/benchmarks/koka-gen/interp/Lit 20))) (analysis/benchmarks/koka-gen/interp/Lit 10))] [result (analysis/benchmarks/koka-gen/interp/run-safe (λ ()
        (analysis/benchmarks/koka-gen/interp/run-env std/core/types/Nil (λ ()
          (analysis/benchmarks/koka-gen/interp/eval ex)))))])
        (std/core/console/string/println result)))))