((module learn/implicits)
  (defs
    (def learn/implicits/int/eq
      (fn (x y)
        (std/core/int/== (x y))))
    (def learn/implicits/float64/eq
      (fn (x y)
        (std/num/float64/== (x y))))
    (def learn/implicits/char/eq
      (fn (x y)
        (std/core/char/== (x y))))
    (def learn/implicits/list-eq-explicit
      (fn (xs ys eq)
        (match xs
          [(std/core/types/Cons x xx) (match ys
            [(std/core/types/Cons y yy) (learn/implicits/list-eq-explicit (xx yy eq))]
            [_ std/core/types/False])]
          [std/core/types/Nil (std/core/types/is-nil (ys))])))
    (def learn/implicits/string/compare
      (fn (x y)
        (std/core/string/cmp (x y))))
    (def learn/implicits/int/compare
      (fn (x y)
        (std/core/int/cmp (x y))))
    (def learn/implicits/default/compare/eq
      (fn (x y h-implicit/compare)
