(module
  learn/implicits
  (define learn/implicits/int/eq
    (λ (x y)
      (std/core/int/== x y)))
  (define learn/implicits/float64/eq
    (λ (x y)
      (std/num/float64/== x y)))
  (define learn/implicits/char/eq
    (λ (x y)
      (std/core/char/== x y)))
  (define learn/implicits/list-eq-explicit
    (λ (xs ys eq)
      (match xs
        [(std/core/types/Cons x xx) (match ys
          [(std/core/types/Cons y yy) (learn/implicits/list-eq-explicit xx yy eq)]
          [_ std/core/types/False])]
        [std/core/types/Nil (std/core/types/is-nil ys)])))
  (define learn/implicits/string/compare
    (λ (x y)
      (std/core/string/cmp x y)))
  (define learn/implicits/int/compare
    (λ (x y)
      (std/core/int/cmp x y)))
  (define learn/implicits/default/compare/eq
    (λ (x y h-implicit/compare)
      (std/core/order/== (h-implicit/compare x y) std/core/types/Eq)))
  (define learn/implicits/list/eq
    (λ (xs ys h-implicit/eq)
      (match xs
        [(std/core/types/Cons x xx) (match ys
          [(std/core/types/Cons y yy) (learn/implicits/list/eq xx yy h-implicit/eq)]
          [_ std/core/types/False])]
        [std/core/types/Nil (std/core/types/is-nil ys)])))
  (define learn/implicits/tuple/eq
    (λ (h-pat-x157_15 h-pat-x157_32 h-implicit/a/eq h-implicit/b/eq)
      (match h-pat-x157_15
        [(std/core/types/Tuple2 x1 y1) (match h-pat-x157_32
          [(std/core/types/Tuple2 x2 y2) (match (h-implicit/a/eq x1 x2)
            [std/core/types/True (h-implicit/b/eq y1 y2)]
            [_ std/core/types/False])])])))
  (define learn/implicits/example1
    (λ ()
      (learn/implicits/list-eq-explicit (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) learn/implicits/int/eq)))
  (define learn/implicits/list-eq
    (λ (xs ys h-implicit/eq)
      (match xs
        [(std/core/types/Cons x xx) (match ys
          [(std/core/types/Cons y yy) (learn/implicits/list-eq xx yy h-implicit/eq)]
          [_ std/core/types/False])]
        [std/core/types/Nil (std/core/types/is-nil ys)])))
  (define learn/implicits/example2
    (λ ()
      (learn/implicits/list-eq (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) learn/implicits/int/eq)))
  (define learn/implicits/eq-refl
    (λ (xx h-implicit/eq)
      (learn/implicits/list-eq xx xx h-implicit/eq)))
  (define learn/implicits/example3
    (λ ()
      (learn/implicits/list-eq std/core/types/Nil std/core/types/Nil learn/implicits/int/eq)))
  (define learn/implicits/example3a
    (λ ()
      (letrec* ([ievh-1203 std/core/types/h-Hnodiv])
        (learn/implicits/list-eq (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) (λ (x y)
          (std/core/types/bool/! (learn/implicits/int/eq x y)))))))
  (define learn/implicits/example4
    (λ ()
      (learn/implicits/list/eq (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) learn/implicits/int/eq)))
  (define learn/implicits/example5
    (λ ()
      (learn/implicits/list/eq (std/core/types/Cons (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) (std/core/types/Cons std/core/types/Nil std/core/types/Nil)) (std/core/types/Cons (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) (std/core/types/Cons std/core/types/Nil std/core/types/Nil)) (λ (h-arg-x1 h-arg-x2)
        (learn/implicits/list/eq h-arg-x1 h-arg-x2 learn/implicits/int/eq)))))
  (define learn/implicits/example5a
    (λ (h-implicit/eq)
      (h-implicit/eq 1 2)))
  (define learn/implicits/example6
    (λ ()
      (learn/implicits/list/eq (std/core/types/Cons "hi" std/core/types/Nil) (std/core/types/Cons "there" std/core/types/Nil) (λ (h-arg-x1 h-arg-x2)
        (learn/implicits/default/compare/eq h-arg-x1 h-arg-x2 learn/implicits/string/compare)))))
  (define learn/implicits/example7
    (λ ()
      (learn/implicits/list/eq (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) learn/implicits/int/eq)))
  (define learn/implicits/example7a
    (λ (h-implicit/compare)
      (learn/implicits/list/eq (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) (std/core/types/Cons 1 (std/core/types/Cons 2 std/core/types/Nil)) learn/implicits/int/eq)))
  (define learn/implicits/tuple/eq2
    (λ (h-pat-x161_16 h-pat-x161_25 h-implicit/a/eq h-implicit/b/eq)
      (match h-pat-x161_16
        [(std/core/types/Tuple2 x1 y1) (match h-pat-x161_25
          [(std/core/types/Tuple2 x2 y2) (match (h-implicit/a/eq x1 x2)
            [std/core/types/True (h-implicit/b/eq y1 y2)]
            [_ std/core/types/False])])])))
  (define learn/implicits/example8
    (λ ()
      (learn/implicits/tuple/eq (std/core/types/Tuple2 (std/core/types/Cons 1 std/core/types/Nil) "a") (std/core/types/Tuple2 (std/core/types/Cons 1 std/core/types/Nil) "a") (λ (h-arg-x1 h-arg-x2)
        (learn/implicits/list/eq h-arg-x1 h-arg-x2 learn/implicits/int/eq)) (λ (h-arg-x1 h-arg-x2)
        (learn/implicits/default/compare/eq h-arg-x1 h-arg-x2 learn/implicits/string/compare)))))
  (define learn/implicits/main
    (λ ()
      (std/core/console/default/show/println (learn/implicits/example8) std/core/bool/show))))